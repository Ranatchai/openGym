    "The session keeps its length. Personal records are worked out again from the new order.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ الجلسة بمدتها. يُعاد حساب الأرقام القياسية الشخصية وفق الترتيب الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einheit behält ihre Dauer. Persönliche Rekorde werden nach der neuen Reihenfolge neu berechnet."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einheit behält ihre Dauer. Persönliche Rekorde werden nach der neuen Reihenfolge neu berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión mantiene su duración. Los récords personales se recalculan según el nuevo orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séance conserve sa durée. Les records personnels sont recalculés selon le nouvel ordre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन की अवधि वही रहती है। नए क्रम के अनुसार निजी रिकॉर्ड दोबारा निकाले जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzés hossza megmarad. A személyes rekordok az új sorrend szerint újraszámolódnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione mantiene la sua durata. I record personali vengono ricalcolati secondo il nuovo ordine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 길이는 그대로 유지됩니다. 개인 기록은 새 순서에 따라 다시 계산됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja zachowuje swoją długość. Rekordy osobiste są przeliczane według nowej kolejności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão mantém a sua duração. Os recordes pessoais são recalculados pela nova ordem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão mantém a duração. Os recordes pessoais são recalculados pela nova ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительность тренировки сохраняется. Личные рекорды пересчитываются по новому порядку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาของเซสชันยังเท่าเดิม ระบบจะคำนวณสถิติส่วนตัวใหม่ตามลำดับใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanın süresi korunur. Kişisel rekorlar yeni sıralamaya göre yeniden hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість тренування не зміниться. Особисті рекорди буде перераховано за новим порядком."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "训练时长保持不变。个人记录会按新的顺序重新计算。"
          }
        }
      }
    },
    "The sets you logged for this exercise in this session will be lost.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفقد المجموعات التي سجلتها لهذا التمرين في هذه الجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die in dieser Einheit für diese Übung protokollierten Sätze gehen verloren."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die in dieser Einheit für diese Übung protokollierten Sätze gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán las series que registraste para este ejercicio en esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries enregistrées pour cet exercice pendant cette séance seront perdues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सत्र में इस व्यायाम के लिए लॉग किए गए सेट मिट जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ebben az edzésben ehhez a gyakorlathoz rögzített sorozatok elvesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie registrate per questo esercizio in questa sessione andranno perse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에서 이 운동에 기록한 세트가 사라집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie zapisane dla tego ćwiczenia w tej sesji zostaną utracone."
          }
        },
        "pt": {
