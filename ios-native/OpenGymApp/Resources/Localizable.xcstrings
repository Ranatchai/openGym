    "Cardio exercises log time + speed instead of weight × reps.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجّل تمارين الكارديو الوقت + السرعة بدلاً من الوزن × التكرارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio-Übungen erfassen Zeit + Tempo statt Gewicht × Wdh."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio-Übungen erfassen Zeit + Tempo statt Gewicht × Wdh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios de cardio registran tiempo + velocidad en vez de peso × reps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices cardio enregistrent temps + vitesse au lieu de poids × reps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्डियो एक्सरसाइज़ में वज़न × रेप्स की जगह समय + गति दर्ज होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kardió gyakorlatok időt + sebességet rögzítenek súly × ismétlés helyett."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi cardio registrano tempo + velocità invece di peso × rip."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유산소 운동은 무게 × 횟수 대신 시간 + 속도를 기록합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenia cardio zapisują czas + prędkość zamiast ciężaru × powt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercícios de cardio registam tempo + velocidade em vez de peso × reps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercícios de cardio registram tempo e velocidade em vez de peso × repetições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кардио-упражнения записывают время + скорость вместо веса × повторов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ท่าคาร์ดิโอจะบันทึกเวลา + ความเร็ว แทนน้ำหนัก × จำนวนครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kardiyo egzersizleri ağırlık × tekrar yerine süre + hız kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кардіо-вправи записують час + швидкість замість ваги × повторів."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "有氧动作记录时间 + 速度，而不是重量 × 次数。"
          }
        }
      }
    },
