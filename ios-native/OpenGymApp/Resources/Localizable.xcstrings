    "The Coach fits the volume to the time you actually have, including rest between sets.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوائم المدرب حجم التدريب مع الوقت المتاح لديك فعلًا، بما في ذلك الراحة بين المجموعات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach passt das Volumen an die Zeit an, die du wirklich hast — inklusive Pausen zwischen den Sätzen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach passt das Volumen an die Zeit an, die du wirklich hast — inklusive Pausen zwischen den Sätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Entrenador ajusta el volumen al tiempo del que dispones, incluido el descanso entre series."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Coach ajuste le volume au temps dont vous disposez réellement, repos entre séries compris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच आपके पास वाकई उपलब्ध समय के हिसाब से वॉल्यूम तय करता है, सेटों के बीच आराम सहित।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Edző a ténylegesen rendelkezésre álló időhöz igazítja a mennyiséget, a sorozatok közti pihenőkkel együtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Coach adatta il volume al tempo che hai davvero, recupero tra le serie incluso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치는 세트 간 휴식까지 포함해 실제 가능한 시간에 맞춰 볼륨을 조정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener dopasuje objętość do czasu, który naprawdę masz — wliczając przerwy między seriami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treinador ajusta o volume ao tempo que tens, incluindo o descanso entre séries."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treinador ajusta o volume ao tempo que você realmente tem, incluindo o descanso entre séries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер подгоняет объём под то время, которое у вас есть, включая отдых между подходами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้ชจะจัดปริมาณให้พอดีกับเวลาที่คุณมีจริง รวมถึงเวลาพักระหว่างเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koç, hacmi gerçekten sahip olduğun süreye göre ayarlar — setler arası dinlenme dâhil."
