    "This device is out of storage: the change is not saved on it. Signed in, it still goes to the server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة تخزين كافية على هذا الجهاز: لم يُحفظ التغيير عليه. إذا كنت مسجّل الدخول، فسيصل إلى الخادم رغم ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist kein Speicher mehr frei: Die Änderung ist nicht auf ihm gespeichert. Angemeldet geht sie trotzdem an den Server."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist kein Speicher mehr frei: Die Änderung ist nicht auf ihm gespeichert. Angemeldet geht sie trotzdem an den Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A este dispositivo no le queda almacenamiento: el cambio no está guardado en él. Con la sesión iniciada, llega igualmente al servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a plus d’espace de stockage : la modification n’y est pas enregistrée. Connecté, elle part quand même vers le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस में जगह नहीं बची: बदलाव इस पर सेव नहीं हुआ है। साइन इन होने पर यह फिर भी सर्वर तक पहुँच जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön elfogyott a tárhely: a módosítás nincs rajta elmentve. Bejelentkezve így is eljut a kiszolgálóra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha più spazio: la modifica non è salvata su di esso. Se hai effettuato l’accesso, arriva comunque al server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장 공간이 없습니다: 변경 내용이 기기에 저장되지 않았습니다. 로그인 상태라면 서버로는 그대로 전송됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma już miejsca: zmiana nie jest na nim zapisana. Po zalogowaniu trafi jednak na serwer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem espaço livre: a alteração não está guardada nele. Com sessão iniciada, chega ainda assim ao servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está sem espaço: a alteração não está salva nele. Com a sessão iniciada, ela chega ao servidor de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве нет места: изменение на нём не сохранено. Если вы вошли в аккаунт, оно всё равно уйдёт на сервер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ไม่มีที่ว่างเหลือ: การเปลี่ยนแปลงไม่ได้บันทึกไว้บนอุปกรณ์ หากลงชื่อเข้าใช้อยู่ ข้อมูลจะยังถูกส่งไปที่เซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda yer kalmadı: değişiklik cihaza kaydedilmedi. Oturum açıkken sunucuya yine de gidiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої скінчилося місце: зміну на ньому не збережено. Після входу в акаунт вона все одно потрапить на сервер."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备存储空间已满：更改未保存在设备上。已登录时，它仍会同步到服务器。"
          }
        }
      }
    },
