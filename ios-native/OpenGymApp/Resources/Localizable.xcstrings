    "Pick everything you have access to. Leave it empty and the Coach will use the whole library.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كل ما يمكنك الوصول إليه. اتركها فارغة وسيستخدم المدرب المكتبة كاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle alles aus, worauf du Zugriff hast. Lässt du es leer, nutzt der Coach die ganze Bibliothek."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle alles aus, worauf du Zugriff hast. Lässt du es leer, nutzt der Coach die ganze Bibliothek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todo lo que tengas a mano. Si lo dejas vacío, el Entrenador usará toda la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez tout ce à quoi vous avez accès. Si vous laissez vide, le Coach utilisera toute la bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ उपलब्ध है सब चुनें। खाली छोड़ने पर कोच पूरी लाइब्रेरी इस्तेमाल करेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelöld be mindazt, amihez hozzáférsz. Ha üresen hagyod, az Edző a teljes gyakorlattárat használja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tutto ciò a cui hai accesso. Se lasci vuoto, il Coach userà tutta la libreria."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 있는 것을 모두 고르세요. 비워두면 코치가 전체 라이브러리를 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz wszystko, do czego masz dostęp. Jeśli zostawisz puste, Trener użyje całej biblioteki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe tudo a que tens acesso. Se deixares vazio, o Treinador usa a biblioteca inteira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque tudo a que você tem acesso. Se deixar vazio, o Treinador usa a biblioteca inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте всё, к чему у вас есть доступ. Если оставить пустым, Тренер использует всю библиотеку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกทุกอย่างที่คุณเข้าถึงได้ หากเว้นว่างไว้ โค้ชจะใช้คลังท่าทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişebildiğin her şeyi seç. Boş bırakırsan Koç tüm kütüphaneyi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Познач усе, до чого маєш доступ. Якщо лишити порожнім, Тренер використає всю бібліотеку."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你能用到的一切。若留空，教练将使用整个动作库。"
          }
        }
      }
    },
