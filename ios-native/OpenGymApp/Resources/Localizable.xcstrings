    "Pick what you will actually keep, not the best week you can imagine.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما ستلتزم به فعلًا، لا أفضل أسبوع يمكنك تخيله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was du wirklich durchhältst — nicht die beste Woche, die du dir vorstellen kannst."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was du wirklich durchhältst — nicht die beste Woche, die du dir vorstellen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige lo que de verdad vas a mantener, no la mejor semana que puedas imaginar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ce que tu tiendras vraiment, pas la meilleure semaine imaginable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह चुनें जो आप सच में निभा पाएँगे, न कि सबसे अच्छा सप्ताह जो आप सोच सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azt válaszd, amit tényleg tartani fogsz, ne az elképzelhető legjobb hetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quello che manterrai davvero, non la settimana migliore che riesci a immaginare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상상 속 최고의 한 주가 아니라 실제로 지킬 수 있는 만큼 고르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz to, co naprawdę utrzymasz, a nie najlepszy tydzień, jaki sobie wyobrażasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o que vais mesmo cumprir, não a melhor semana que consegues imaginar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que você vai realmente cumprir, não a melhor semana que consegue imaginar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите то, что реально выдержите, а не лучшую неделю, которую можете представить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสิ่งที่คุณจะทำได้จริง ไม่ใช่สัปดาห์ที่ดีที่สุดที่จินตนาการได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayal edebildiğin en iyi haftayı değil, gerçekten sürdüreceğini seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери те, що реально витримаєш, а не найкращий тиждень, який можеш уявити."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你真正能坚持的，而不是你能想象的最完美的一周。"
          }
        }
      }
    },
