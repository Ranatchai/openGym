    "Discarded. Tell me what was off and I will build a different one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التجاهل. أخبرني بما كان غير مناسب وسأبني خطة مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verworfen. Sag mir, was nicht gepasst hat, und ich baue einen anderen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Verworfen. Sag mir, was nicht gepasst hat, und ich baue einen anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartado. Dime qué no encajaba y haré otro distinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonné. Dis-moi ce qui n’allait pas et j’en construis un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटा दिया। बताएँ क्या ठीक नहीं था, मैं दूसरी बना दूँगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elvetve. Mondd el, mi nem stimmelt, és készítek egy másikat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartato. Dimmi cosa non andava e ne costruisco un altro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폐기했습니다. 무엇이 맞지 않았는지 알려주시면 다른 계획을 만들게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucono. Powiedz, co było nie tak, a zbuduję inny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartado. Diz-me o que não encaixou e eu faço outro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartado. Me diga o que não encaixou e eu faço outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонено. Скажите, что не подошло, и я составлю другой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
