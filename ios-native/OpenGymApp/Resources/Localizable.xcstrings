    "Short {0} sessions in a row — back off to {1}s and build up again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ جلسات قصيرة متتالية — تراجع إلى %2$@ث ثم ابدأ بالزيادة من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einheiten in Folge zu kurz — zurück auf %2$@s und neu aufbauen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einheiten in Folge zu kurz — zurück auf %2$@s und neu aufbauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short %1$@ sessions in a row — back off to %2$@s and build up again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sesiones seguidas por debajo: baja a %2$@ s y vuelve a subir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ séances trop courtes d’affilée — redescends à %2$@ s et remonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगातार %1$@ सेशन कम रहे — %2$@ सेकंड पर लौटें और फिर से बढ़ाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ egymást követő edzés volt rövid — vissza %2$@ mp-re, és építsd fel újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sessioni di fila troppo brevi: torna a %2$@ s e ricostruisci."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@회 연속으로 시간이 부족했습니다 — %2$@초로 낮추고 다시 쌓으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sesje z rzędu poniżej celu — zejdź do %2$@ s i buduj od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sessões seguidas abaixo do alvo — recua para %2$@ s e volta a subir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sessões seguidas abaixo da meta — reduza para %2$@ s e volte a progredir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ тренировки подряд короче цели — вернись к %2$@ с и наращивай снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำได้ไม่ครบเวลาติดต่อกัน %1$@ ครั้ง — ลดกลับไปที่ %2$@ วินาที แล้วค่อยไต่ขึ้นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst üste %1$@ seans kısa kaldı — %2$@ sn’ye in ve yeniden çık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ тренування поспіль коротші за ціль — повернись до %2$@ с і нарощуй знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连续 %1$@ 次未达时长——回到 %2$@ 秒重新积累。"
          }
        }
      }
    },
