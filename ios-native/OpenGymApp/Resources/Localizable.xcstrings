        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่มีรูทีน — ขอแผนจากโค้ชก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz rutinin yok — önce Koç’tan bir plan iste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебе поки немає програм — спочатку попроси в Тренера план."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有训练计划——先向教练要一份。"
          }
        }
      }
    },
    "You have the latest version.": {
