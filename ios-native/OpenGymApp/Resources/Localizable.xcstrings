          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora routine — chiedi prima un piano al Coach."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 루틴이 없어요 — 먼저 코치에게 플랜을 요청하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze rutyn — najpierw poproś Coacha o plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tens rotinas — pede primeiro um plano ao Coach."
          }
        },
        "pt-BR": {
          "stringUnit": {
