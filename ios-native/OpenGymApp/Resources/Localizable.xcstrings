    "Kept on this device only — Export with photos & videos keeps a copy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ على هذا الجهاز فقط — التصدير مع الصور والفيديو يحتفظ بنسخة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
