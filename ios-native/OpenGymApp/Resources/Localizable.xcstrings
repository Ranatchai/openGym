            "value": "es. «voglio vedere progressi sulle braccia entro la primavera»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: “봄까지 팔에 눈에 띄는 변화를 원해요”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. „chcę widoczny postęp na ramionach do wiosny”"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. «quero ver progresso nos braços até à primavera»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: “quero ver progresso visível nos braços até a primavera”"
          }
        },
