    "Optional — a picture makes it easier to spot in a list.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري — الصورة تجعل العثور عليه في القائمة أسهل."
          }
        },
        "de": {
