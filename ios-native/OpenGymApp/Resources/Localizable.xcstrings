        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер отдыхает — на этом телефоне израсходованы %1$@ запусков на сегодня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้ชกำลังพัก — คุณใช้ครบ %1$@ ครั้งของวันนี้บนโทรศัพท์นี้แล้ว"
