    "Push, pull and legs each get their own day.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل من الدفع والسحب والأرجل يوم خاص."
          }
        },
        "de": {
          "stringUnit": {
