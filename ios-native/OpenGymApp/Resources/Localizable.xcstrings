    "Rest after each set of this exercise. Leave at 0 to use your default rest timer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الراحة بعد كل مجموعة من هذا التمرين. اتركها 0 لاستخدام مؤقت الراحة الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause nach jedem Satz dieser Übung. Auf 0 lassen, um den Standard-Pausen-Timer zu nutzen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause nach jedem Satz dieser Übung. Auf 0 lassen, um den Standard-Pausen-Timer zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso tras cada serie de este ejercicio. Déjalo en 0 para usar tu temporizador de descanso por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repos après chaque série de cet exercice. Laisse à 0 pour utiliser ton minuteur de repos par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एक्सरसाइज़ के हर सेट के बाद आराम। अपना डिफ़ॉल्ट आराम टाइमर इस्तेमाल करने के लिए इसे 0 रहने दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pihenő a gyakorlat minden sorozata után. Hagyd 0-n az alapértelmezett pihenőidőzítőhöz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupero dopo ogni serie di questo esercizio. Lascialo a 0 per usare il timer di riposo predefinito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 운동의 세트마다 갖는 휴식이에요. 기본 휴식 타이머를 쓰려면 0으로 두세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpoczynek po każdej serii tego ćwiczenia. Zostaw 0, żeby użyć domyślnego minutnika przerwy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso depois de cada série deste exercício. Deixa a 0 para usares o temporizador de descanso predefinido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso depois de cada série deste exercício. Deixe em 0 para usar o temporizador de descanso padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдых после каждого подхода этого упражнения. Оставь 0, чтобы работал таймер отдыха по умолчанию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พักหลังแต่ละเซ็ตของท่านี้ ปล่อยไว้ที่ 0 เพื่อใช้ตัวจับเวลาพักค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu egzersizin her setinden sonraki dinlenme. Varsayılan dinlenme sayacını kullanmak için 0 bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпочинок після кожного підходу цієї вправи. Залиш 0, щоб працював таймер відпочинку за замовчуванням."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这个动作每组之后的休息时间。留在 0 就使用默认的休息计时。"
          }
        }
      }
    },
