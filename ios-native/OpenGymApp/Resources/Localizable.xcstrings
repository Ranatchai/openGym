    "Passkey sign-in, sync across your devices, your own data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل دخول بمفتاح المرور، ومزامنة بين أجهزتك، وبياناتك ملكك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung per Passkey, Sync zwischen deinen Geräten, deine eigenen Daten."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung per Passkey, Sync zwischen deinen Geräten, deine eigenen Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio de sesión con passkey, sincronización entre tus dispositivos, tus propios datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion par passkey, synchronisation entre tes appareils, tes propres données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकी से साइन इन, आपके सभी डिवाइस पर सिंक, आपका अपना डेटा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejelentkezés jelszókulccsal, szinkronizálás az eszközeid között, a saját adataid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso con passkey, sincronizzazione tra i tuoi dispositivi, i tuoi dati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키 로그인, 기기 간 동기화, 나만의 데이터."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie passkey, synchronizacja między twoimi urządzeniami, twoje własne dane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Início de sessão com passkey, sincronização entre os teus dispositivos, os teus próprios dados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Login com chave de acesso, sincronização entre seus dispositivos, seus próprios dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход по passkey, синхронизация между устройствами, ваши собственные данные."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ด้วยพาสคีย์ ซิงก์ข้ามอุปกรณ์ของคุณ ข้อมูลเป็นของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş anahtarıyla giriş, cihazların arasında senkronizasyon, kendi verilerin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід за ключем доступу, синхронізація між твоїми пристроями, твої власні дані."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "通行密钥登录、多设备同步、数据归你所有。"
          }
        }
      }
    },
