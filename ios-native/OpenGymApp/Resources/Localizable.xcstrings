          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर के पते ने openGym के बजाय कुछ और जवाब दिया (HTTP %1$@)। आपके बदलाव यहीं रखे हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
