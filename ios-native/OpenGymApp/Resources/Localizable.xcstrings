    "Exercise instructions aren't available in this language yet — they stay in English.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعليمات التمارين غير متاحة بهذه اللغة بعد — ستبقى بالإنجليزية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übungsanleitungen gibt es in dieser Sprache noch nicht — sie bleiben auf Englisch."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Übungsanleitungen gibt es in dieser Sprache noch nicht — sie bleiben auf Englisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instrucciones de los ejercicios aún no están en este idioma — se muestran en inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instructions des exercices ne sont pas encore disponibles dans cette langue — elles restent en anglais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यायाम निर्देश अभी इस भाषा में उपलब्ध नहीं — वे अंग्रेज़ी में रहेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyakorlatleírások ezen a nyelven még nem érhetők el — angolul maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istruzioni degli esercizi non sono ancora in questa lingua — restano in inglese."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 설명은 아직 이 언어로 제공되지 않아 영어로 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrukcje ćwiczeń nie są jeszcze dostępne w tym języku — pozostają po angielsku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As instruções dos exercícios ainda não existem neste idioma — ficam em inglês."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instruções dos exercícios ainda não existem neste idioma — ficam em inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструкции к упражнениям на этом языке пока недоступны — они остаются на английском."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแนะนำท่าออกกำลังกายยังไม่มีในภาษานี้ — จะแสดงเป็นภาษาอังกฤษ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz talimatları bu dilde henüz yok — İngilizce kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструкції до вправ цією мовою поки недоступні — вони лишаються англійською."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
