    "Your server cannot be reached — your changes are saved on this device and sync once it answers again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خادمك — تُحفظ تغييراتك على هذا الجهاز وتتزامن عندما يستجيب مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist nicht erreichbar — deine Änderungen sind auf diesem Gerät gespeichert und werden synchronisiert, sobald er wieder antwortet."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist nicht erreichbar — deine Änderungen sind auf diesem Gerät gespeichert und werden synchronisiert, sobald er wieder antwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede llegar a tu servidor: tus cambios se guardan en este dispositivo y se sincronizarán cuando vuelva a responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur est injoignable — vos modifications sont enregistrées sur cet appareil et seront synchronisées dès qu'il répondra à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर तक नहीं पहुँचा जा सकता — आपके बदलाव इस डिवाइस पर सहेजे गए हैं और उसके फिर से जवाब देते ही सिंक हो जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szervered nem érhető el — a módosításaid ezen az eszközön vannak mentve, és szinkronizálódnak, amint újra válaszol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server non è raggiungibile — le tue modifiche sono salvate su questo dispositivo e verranno sincronizzate quando risponderà di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다 — 변경 사항은 이 기기에 저장되며 서버가 다시 응답하면 동기화됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój serwer jest nieosiągalny — zmiany są zapisane na tym urządzeniu i zsynchronizują się, gdy znów odpowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível chegar ao teu servidor — as tuas alterações ficam guardadas neste dispositivo e sincronizam assim que ele voltar a responder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar o seu servidor — suas alterações ficam salvas neste dispositivo e sincronizam assim que ele voltar a responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер недоступен — изменения сохранены на этом устройстве и синхронизируются, как только он снова ответит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ของคุณไม่ได้ — การเปลี่ยนแปลงถูกบันทึกไว้ในอุปกรณ์นี้และจะซิงค์เมื่อเซิร์ฟเวอร์ตอบกลับอีกครั้ง"
