    "Want changes to the plan from this? Ask for a review below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تريد تغييرات على الخطة بناءً على هذا؟ اطلب مراجعة أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen daraus Änderungen am Plan werden? Bitte unten um eine Überprüfung."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen daraus Änderungen am Plan werden? Bitte unten um eine Überprüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres cambios en el plan a partir de esto? Pide una revisión abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu veux en tirer des changements de plan ? Demande une revue ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे प्लान में बदलाव चाहिए? नीचे समीक्षा माँगें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szeretnél ebből tervmódosítást? Kérj áttekintést lent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi cambiare il piano a partire da questo? Chiedi una revisione qui sotto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸로 플랜을 바꾸고 싶나요? 아래에서 검토를 요청하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcesz na tej podstawie zmienić plan? Poproś poniżej o przegląd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres alterações ao plano a partir disto? Pede uma revisão abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer mudanças no plano a partir disso? Peça uma revisão abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хочешь изменить план на основе этого? Попроси разбор ниже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากให้เปลี่ยนแผนจากสิ่งนี้ไหม ขอรีวิวด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan plan değişikliği mi istiyorsun? Aşağıdan bir inceleme iste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хочеш змінити план на основі цього? Попроси розбір нижче."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "想据此调整计划？在下方请求一次审查。"
          }
        }
      }
    },
