    "Save your edits to this workout, or keep the original record.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تعديلاتك على هذا التمرين، أو احتفظ بالسجل الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deine Änderungen an diesem Training oder behalte den ursprünglichen Eintrag."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deine Änderungen an diesem Training oder behalte den ursprünglichen Eintrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los cambios de este entrenamiento o conserva el registro original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos modifications ou conservez l’enregistrement d’origine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्कआउट के बदलाव सहेजें या मूल रिकॉर्ड रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd az edzés módosításait, vagy tartsd meg az eredeti bejegyzést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le modifiche a questo allenamento oppure conserva il record originale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 운동의 변경 사항을 저장하거나 원래 기록을 유지하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz zmiany w tym treningu albo zachowaj oryginalny zapis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as alterações deste treino ou mantém o registo original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve as alterações deste treino ou mantenha o registro original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните изменения этой тренировки или оставьте исходную запись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการแก้ไขการออกกำลังกายนี้ หรือเก็บบันทึกเดิมไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
