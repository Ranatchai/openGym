    "Revised as you asked. Everything you did not question is exactly as it was.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُدِّلت كما طلبت. كل ما لم تعترض عليه بقي كما كان تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überarbeitet, wie gewünscht. Alles, was du nicht infrage gestellt hast, ist genau wie vorher."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Überarbeitet, wie gewünscht. Alles, was du nicht infrage gestellt hast, ist genau wie vorher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisado como pediste. Todo lo que no cuestionaste queda exactamente como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revu comme demandé. Tout ce que tu n’as pas remis en question est exactement comme avant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कहे अनुसार संशोधित। जिस पर आपने सवाल नहीं उठाया, वह सब बिल्कुल पहले जैसा है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átdolgozva, ahogy kérted. Minden, amit nem kifogásoltál, pontosan úgy maradt, ahogy volt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivisto come hai chiesto. Tutto ciò che non hai messo in discussione è esattamente com’era."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하신 대로 수정했어요. 문제 삼지 않은 부분은 모두 그대로예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprawione zgodnie z prośbą. Wszystko, czego nie kwestionowano, zostało dokładnie tak, jak było."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisto como pediste. Tudo o que não puseste em causa está exatamente como estava."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisado como você pediu. Tudo o que você não questionou está exatamente como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересмотрено по вашей просьбе. Всё, к чему у вас не было вопросов, осталось как было."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับตามที่คุณขอแล้ว ส่วนที่คุณไม่ได้ติงไว้ยังคงเหมือนเดิมทุกอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin gibi gözden geçirildi. Sorgulamadığın her şey tam olarak olduğu gibi duruyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянуто на твоє прохання. Усе, до чого в тебе не було питань, лишилося як було."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已按你的要求修改。你没有提出疑问的部分完全保持原样。"
          }
        }
      }
    },
