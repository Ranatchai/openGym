    "Replaces your current week. Days this plan leaves empty become rest days.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل أسبوعك الحالي. الأيام التي تتركها هذه الخطة فارغة تصبح أيام راحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt deine aktuelle Woche. Tage, die dieser Plan frei lässt, werden zu Ruhetagen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt deine aktuelle Woche. Tage, die dieser Plan frei lässt, werden zu Ruhetagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye tu semana actual. Los días que este plan deje vacíos serán de descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace votre semaine actuelle. Les jours laissés vides par ce plan deviennent des jours de repos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके मौजूदा हफ़्ते की जगह लेगा। जो दिन यह प्लान खाली छोड़ता है वे आराम के दिन बन जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecseréli a jelenlegi hetedet. Az üresen hagyott napok pihenőnapok lesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce la tua settimana attuale. I giorni che questo piano lascia vuoti diventano di riposo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 주간 일정을 대체합니다. 이 계획이 비워둔 날은 휴식일이 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastępuje Twój obecny tydzień. Dni, które ten plan zostawia puste, stają się dniami odpoczynku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui a tua semana atual. Os dias que este plano deixar vazios passam a ser de descanso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui sua semana atual. Os dias que este plano deixar vazios viram dias de descanso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменит вашу текущую неделю. Дни, которые план оставляет пустыми, станут днями отдыха."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่สัปดาห์ปัจจุบันของคุณ วันที่แผนนี้เว้นว่างจะกลายเป็นวันพัก"
