    "{0} workout and {1} weigh-in were logged on this device while signed out. Add them to your profile, or keep the profile exactly as it is on the server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُجل %1$@ تدريب و%2$@ قياس وزن على هذا الجهاز أثناء تسجيل الخروج. أضفهما إلى ملفك، أو أبقِ الملف كما هو على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Training und %2$@ Wiegung wurden auf diesem Gerät ohne Anmeldung erfasst. Zum Profil hinzufügen oder das Profil genau so lassen, wie es auf dem Server ist."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Training und %2$@ Wiegung wurden auf diesem Gerät ohne Anmeldung erfasst. Zum Profil hinzufügen oder das Profil genau so lassen, wie es auf dem Server ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ workout and %2$@ weigh-in were logged on this device while signed out. Add them to your profile, or keep the profile exactly as it is on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ entrenamiento y %2$@ pesaje se registraron en este dispositivo sin iniciar sesión. Añádelos a tu perfil o deja el perfil exactamente como está en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ séance et %2$@ pesée ont été enregistrées sur cet appareil sans connexion. Ajoutez-les à votre profil ou gardez le profil exactement tel qu’il est sur le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ वर्कआउट और %2$@ वज़न इस डिवाइस पर बिना साइन इन किए दर्ज किए गए। इन्हें अपनी प्रोफ़ाइल में जोड़ें, या प्रोफ़ाइल को ठीक वैसा ही रखें जैसा सर्वर पर है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ edzés és %2$@ mérés került rögzítésre ezen az eszközön bejelentkezés nélkül. Add hozzá őket a profilodhoz, vagy hagyd a profilt pontosan úgy, ahogy a szerveren van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ allenamento e %2$@ pesata sono stati registrati su questo dispositivo senza accesso. Aggiungili al tuo profilo o lascia il profilo esattamente com’è sul server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하지 않은 상태에서 이 기기에 운동 %1$@개와 체중 기록 %2$@개가 기록되었습니다. 프로필에 추가하거나 서버에 있는 프로필을 그대로 유지하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trening i %2$@ ważenie zapisano na tym urządzeniu bez logowania. Dodaj je do profilu albo zostaw profil dokładnie taki, jaki jest na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ treino e %2$@ pesagem foram registados neste dispositivo sem sessão iniciada. Adiciona-os ao teu perfil ou mantém o perfil exatamente como está no servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ treino e %2$@ pesagem foram registrados neste dispositivo sem login. Adicione-os ao seu perfil ou mantenha o perfil exatamente como está no servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ тренировка и %2$@ взвешивание были записаны на этом устройстве без входа. Добавьте их в профиль или оставьте профиль ровно таким, как на сервере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการบันทึกการฝึก %1$@ ครั้งและการชั่งน้ำหนัก %2$@ ครั้งบนอุปกรณ์นี้ขณะไม่ได้ลงชื่อเข้าใช้ เพิ่มลงในโปรไฟล์ของคุณ หรือคงโปรไฟล์ไว้ตามที่อยู่บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda oturum açılmadan %1$@ antrenman ve %2$@ tartım kaydedildi. Bunları profiline ekle ya da profili sunucudaki hâliyle bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої без входу записано %1$@ тренування і %2$@ зважування. Додай їх у профіль або лиши профіль точно таким, як на сервері."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备在未登录时记录了 %1$@ 次训练和 %2$@ 次体重。把它们加入你的个人资料，或保持个人资料与服务器上的完全一致。"
          }
        }
      }
    },
