    "Forgot it? Confirm with your passkey instead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسيتها؟ أكّد بمفتاح المرور بدلًا من ذلك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergessen? Stattdessen mit deinem Passkey bestätigen"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergessen? Stattdessen mit deinem Passkey bestätigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿La olvidaste? Confirma con tu passkey"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublié ? Confirme plutôt avec ta passkey"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूल गए? इसकी जगह अपनी पासकी से पुष्टि करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfelejtetted? Erősítsd meg inkább a jelszókulcsoddal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hai dimenticata? Conferma invece con la tua passkey"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잊으셨나요? 대신 패스키로 확인하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pamiętasz? Potwierdź zamiast tego passkey"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceste-te? Confirma antes com a tua passkey"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceu? Confirme com sua chave de acesso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыл? Подтверди ключом доступа"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลืมใช่ไหม? ยืนยันด้วยพาสคีย์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unuttun mu? Bunun yerine geçiş anahtarınla onayla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пам’ятаєш? Підтверди ключем доступу"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记了？改用你的通行密钥确认"
          }
        }
      }
    },
    "Forgot to finish on time? Set how long the session really took. It keeps its start time and its sets.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسيت الإنهاء في الوقت المناسب؟ حدّد المدة الفعلية للجلسة. يبقى وقت بدئها ومجموعاتها كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergessen, rechtzeitig zu beenden? Stell ein, wie lange die Einheit wirklich gedauert hat. Startzeit und Sätze bleiben, wie sie sind."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergessen, rechtzeitig zu beenden? Stell ein, wie lange die Einheit wirklich gedauert hat. Startzeit und Sätze bleiben, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidaste terminar a tiempo? Indica cuánto duró de verdad la sesión. Conserva su hora de inicio y sus series."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublié de terminer à temps ? Indique combien de temps la séance a vraiment duré. Elle garde son heure de début et ses séries."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय पर खत्म करना भूल गए? बताएं कि सेशन असल में कितनी देर चला। शुरू होने का समय और सेट वैसे ही रहेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfelejtetted időben befejezni? Add meg, valójában meddig tartott az edzés. A kezdési idő és a sorozatok megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai dimenticato di terminare in tempo? Imposta quanto è durata davvero la sessione. Mantiene l’ora di inizio e le serie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제때 종료하는 걸 잊으셨나요? 세션이 실제로 걸린 시간을 설정하세요. 시작 시간과 세트는 그대로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapomniałeś zakończyć na czas? Ustaw, ile naprawdę trwała sesja. Godzina rozpoczęcia i serie zostają bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceste-te de terminar a tempo? Indica quanto tempo a sessão durou de facto. Mantém a hora de início e as séries."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceu de terminar na hora? Defina quanto tempo a sessão realmente durou. Ela mantém o horário de início e as séries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыли вовремя завершить? Укажите, сколько на самом деле длилась тренировка. Время начала и подходы останутся прежними."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลืมกดจบตรงเวลาใช่ไหม ตั้งระยะเวลาที่เซสชันใช้จริง เวลาเริ่มและเซ็ตจะยังคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanında bitirmeyi mi unuttun? Antrenmanın gerçekte ne kadar sürdüğünü ayarla. Başlangıç saati ve setler aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренування не завершено вчасно? Вкажи, скільки воно насправді тривало. Час початку й підходи залишаться без змін."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "忘了及时结束？设置本次训练的实际时长。开始时间和组数保持不变。"
          }
        }
      }
    },
    "Fr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجمعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fr"
          }
        },
