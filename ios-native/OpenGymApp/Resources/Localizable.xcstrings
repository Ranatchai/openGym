          "stringUnit": {
            "state": "translated",
            "value": "此通行密钥已属于某个档案。"
          }
        }
      }
    },
    "This password is the only way into your profile, so it cannot be removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور هذه هي الطريقة الوحيدة للدخول إلى ملفك الشخصي، لذا لا يمكن إزالتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort ist der einzige Weg in dein Profil und kann deshalb nicht entfernt werden."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort ist der einzige Weg in dein Profil und kann deshalb nicht entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
