    "Rest-pause always trains as one warm-up set at this rep count, then one rest-pause work set — \"Sets\" is not used.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتدرب الريست بوز دائمًا كمجموعة إحماء واحدة بهذا العدد من التكرارات، ثم مجموعة عمل ريست بوز واحدة — ولا يُستخدم خيار «المجموعات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-Pause trainiert immer als ein Aufwärmsatz mit dieser Wiederholungszahl und ein Rest-Pause-Arbeitssatz — „Sätze“ wird nicht verwendet."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-Pause trainiert immer als ein Aufwärmsatz mit dieser Wiederholungszahl und ein Rest-Pause-Arbeitssatz — „Sätze“ wird nicht verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-pause siempre entrena como una serie de calentamiento con estas reps y una serie de trabajo rest-pause — «Series» no se usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rest-pause s’entraîne toujours comme une série d’échauffement à ce nombre de reps, puis une série de travail rest-pause — « Séries » n’est pas utilisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेस्ट-पॉज़ हमेशा इसी रेप्स संख्या के एक वार्म-अप सेट और एक रेस्ट-पॉज़ वर्क सेट के रूप में किया जाता है — “सेट” का उपयोग नहीं होता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rest-pause mindig egy bemelegítő sorozatként indul ennyi ismétléssel, majd egy rest-pause munkasorozatként folytatódik — a „Sorozatok” mező nem használt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rest-pause si allena sempre come una serie di riscaldamento a queste ripetizioni e una serie di lavoro rest-pause — “Serie” non viene usato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레스트포즈는 항상 이 횟수의 워밍업 세트 하나와 레스트포즈 작업 세트 하나로 진행됩니다 — ‘세트’는 사용하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-pause zawsze trenuje się jako jedna seria rozgrzewkowa o tej liczbie powtórzeń i jedna seria robocza rest-pause — „Serie” nie są używane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rest-pause treina sempre como uma série de aquecimento com estas repetições e uma série de trabalho rest-pause — «Séries» não é usado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rest-pause sempre treina como uma série de aquecimento com essas repetições e uma série de trabalho rest-pause — “Séries” não é usado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-pause всегда выполняется как один разминочный подход с этим числом повторений и один рабочий подход rest-pause — «Подходы» не используются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรสต์-พอสจะฝึกเป็นเซ็ตวอร์มอัพหนึ่งเซ็ตที่จำนวนครั้งนี้ ตามด้วยเซ็ตหลักแบบเรสต์-พอสหนึ่งเซ็ตเสมอ — ไม่ใช้ค่า \"เซ็ต\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-pause her zaman bu tekrar sayısında bir ısınma seti ve bir rest-pause çalışma seti olarak çalışılır — “Setler” kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-pause завжди виконується як один розминковий підхід із цим числом повторень і один робочий підхід rest-pause — «Підходи» не використовуються."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-pause 始终按这个次数练一个热身组，再加一个 rest-pause 正式组 —— 不使用“组数”。"
          }
        }
      }
    },
