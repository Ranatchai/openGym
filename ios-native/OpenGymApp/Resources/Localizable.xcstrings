    "No account, no cloud — back it up anytime with Export below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب ولا سحابة — انسخ بياناتك احتياطياً في أي وقت من خلال التصدير أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Cloud — sichere sie jederzeit über den Export unten."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Cloud — sichere sie jederzeit über den Export unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta ni nube — haz una copia cuando quieras con Exportar, más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de cloud — sauvegardez-les à tout moment via Exporter ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न खाता, न क्लाउड — नीचे एक्सपोर्ट से कभी भी बैकअप लें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs fiók, nincs felhő — bármikor menthetsz biztonsági másolatot lent az Exporttal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente account, niente cloud — fai un backup quando vuoi con Esporta qui sotto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도 클라우드도 없음 — 아래 내보내기로 언제든 백업하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta i chmury — w każdej chwili zrób kopię przez Eksport poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem nuvem — faz uma cópia quando quiseres com Exportar, abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta e sem nuvem — faça um backup quando quiser usando a opção Exportar abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта и облака — в любой момент сделайте резервную копию через «Экспорт» ниже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี ไม่ต้องใช้คลาวด์ — สำรองข้อมูลได้ทุกเมื่อผ่านปุ่มส่งออกด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, bulut yok — aşağıdaki Dışa aktar ile istediğiniz zaman yedekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без акаунта й хмари — будь-коли зроби резервну копію через «Експорт» нижче."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号、无需云端——随时可用下方的导出功能备份。"
          }
