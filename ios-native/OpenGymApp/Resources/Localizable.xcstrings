            "value": "เซ็ตที่บันทึกไว้สำหรับท่านี้ในรอบนี้จะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seansta bu egzersiz için kaydettiğin setler kaybolacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходи, записані для цієї вправи в цій сесії, буде втрачено."
