    "e.g. “dodgy left shoulder — no barbell overhead press”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلًا «كتف أيسر ضعيف — لا ضغط بار فوق الرأس»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „empfindliche linke Schulter — kein Schulterdrücken mit der Langhantel“"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „empfindliche linke Schulter — kein Schulterdrücken mit der Langhantel“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. «hombro izquierdo delicado: nada de press militar con barra»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. « épaule gauche fragile — pas de développé militaire à la barre »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे “बायाँ कंधा नाज़ुक — बारबेल ओवरहेड प्रेस नहीं”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. „gyanús bal váll — nincs rudas nyomás fej fölé”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. «spalla sinistra delicata: niente lento avanti con bilanciere»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: “왼쪽 어깨가 안 좋음 — 바벨 오버헤드 프레스 제외”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. „wrażliwy lewy bark — bez wyciskania sztangi nad głowę”"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. «ombro esquerdo delicado: nada de press militar com barra»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: “ombro esquerdo sensível — nada de desenvolvimento com barra”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. «капризное левое плечо — без жима штанги над головой»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น “ไหล่ซ้ายไม่ค่อยดี — งดดันบาร์เบลเหนือศีรษะ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn. “sol omzum hassas — halterle baş üstü press yok”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. «примхливе ліве плече — без жиму штанги над головою»"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "例如「左肩不太好——不做杠铃过顶推举」"
          }
        }
      }
    },
    "e.g. “swap the squats for split squats, and Mondays are short”": {
      "extractionState": "manual",
