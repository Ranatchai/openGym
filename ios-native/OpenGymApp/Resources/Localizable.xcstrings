    "Ramp-up sets added before the work sets, so you do not have to add them by hand each session.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعات إحماء تصاعدية تُضاف قبل مجموعات العمل، حتى لا تضطر لإضافتها يدويًا في كل جلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufwärmsätze vor den Arbeitssätzen, damit du sie nicht jedes Mal von Hand hinzufügen musst."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufwärmsätze vor den Arbeitssätzen, damit du sie nicht jedes Mal von Hand hinzufügen musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Series de aproximación antes de las series de trabajo, para no añadirlas a mano cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séries de montée en charge avant les séries de travail, pour ne pas les ajouter à la main chaque fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्क सेट से पहले जुड़ने वाले तैयारी सेट, ताकि हर बार खुद जोड़ना न पड़े।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokozatosan növekvő sorozatok a munkasorozatok elé, hogy ne kelljen minden edzésen kézzel hozzáadnod őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie di avvicinamento prima delle serie di lavoro, così non devi aggiungerle a mano ogni volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 세트 앞에 넣는 준비 세트로, 매번 직접 추가하지 않아도 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie wprowadzające przed seriami roboczymi, żeby nie dodawać ich ręcznie za każdym razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Séries de aproximação antes das séries de trabalho, para não teres de as acrescentar à mão em cada treino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Séries de aproximação antes das séries de trabalho, para você não precisar adicioná-las na mão a cada treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подводящие подходы перед рабочими, чтобы не добавлять их вручную каждый раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเซ็ตไต่ระดับไว้ก่อนเซ็ตหลัก จะได้ไม่ต้องเพิ่มเองทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma setlerinden önce eklenen hazırlık setleri, böylece her antrenmanda elle eklemen gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підвідні підходи перед робочими, щоб не додавати їх вручну щоразу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在正式组之前加入的爬升组，这样就不用每次手动添加。"
          }
        }
      }
    },
