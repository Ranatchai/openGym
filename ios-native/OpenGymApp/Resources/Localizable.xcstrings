          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пароль — единственный способ войти в твой профиль, поэтому его нельзя удалить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านนี้เป็นทางเดียวที่จะเข้าสู่โปรไฟล์ของคุณ จึงลบไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şifre profiline girmenin tek yolu, bu yüzden kaldırılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пароль — єдиний спосіб увійти у твій профіль, тому його не можна видалити."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这个密码是进入你档案的唯一方式，因此不能移除。"
          }
        }
      }
    },
    "This phone calls the provider directly with your key. Every request is charged to your account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل هذا الهاتف بالمزود مباشرة بمفتاحك. يُحاسب حسابك على كل طلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy ruft den Anbieter direkt mit deinem Schlüssel auf. Jede Anfrage geht auf dein Konto."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy ruft den Anbieter direkt mit deinem Schlüssel auf. Jede Anfrage geht auf dein Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono llama al proveedor directamente con tu clave. Cada solicitud se cobra a tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone appelle directement le fournisseur avec ta clé. Chaque requête est facturée sur ton compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन आपकी कुंजी से सीधे प्रदाता को कॉल करता है। हर अनुरोध का शुल्क आपके खाते से लिया जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon közvetlenül, a kulcsoddal hívja a szolgáltatót. Minden kérést a te fiókodra terhel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono chiama il provider direttamente con la tua chiave. Ogni richiesta viene addebitata al tuo account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰이 당신의 키로 제공자를 직접 호출합니다. 모든 요청은 당신의 계정에 청구됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon łączy się z dostawcą bezpośrednio z Twoim kluczem. Każde zapytanie obciąża Twoje konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telemóvel chama o fornecedor diretamente com a tua chave. Cada pedido é cobrado na tua conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular chama o provedor diretamente com a sua chave. Cada pedido é cobrado na sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон обращается к провайдеру напрямую с вашим ключом. Каждый запрос списывается с вашего счёта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์นี้เรียกผู้ให้บริการโดยตรงด้วยคีย์ของคุณ ทุกคำขอจะถูกเรียกเก็บจากบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon sağlayıcıyı doğrudan senin anahtarınla çağırır. Her istek senin hesabına yansır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей телефон звертається до постачальника напряму з твоїм ключем. Кожен запит списується з твого рахунку."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机使用你的密钥直接调用提供商。每个请求都会计入你的账户。"
          }
        }
      }
    },
    "This phone is no longer paired with your server. Your changes are kept here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الهاتف مقترنًا بخادمك. تغييراتك محفوظة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy ist nicht mehr mit deinem Server gekoppelt. Deine Änderungen bleiben hier."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy ist nicht mehr mit deinem Server gekoppelt. Deine Änderungen bleiben hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono ya no está emparejado con tu servidor. Tus cambios se quedan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'est plus associé à votre serveur. Vos modifications restent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन अब आपके सर्वर से पेयर नहीं है। आपके बदलाव यहीं रखे हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon már nincs párosítva a szervereddel. A módosításaid itt maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non è più abbinato al tuo server. Le tue modifiche restano qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 더 이상 서버와 페어링되어 있지 않습니다. 변경 사항은 이 기기에 보관됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie jest już sparowany z twoim serwerem. Twoje zmiany zostają tutaj."
