    "Stalled {0} sessions — back to {1} {2} of help and build up again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف التقدم %1$@ جلسات — عودة إلى %2$@ %3$@ من المساعدة والبناء من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einheiten festgefahren — zurück auf %2$@ %3$@ Hilfe und neu aufbauen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einheiten festgefahren — zurück auf %2$@ %3$@ Hilfe und neu aufbauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stalled %1$@ sessions — back to %2$@ %3$@ of help and build up again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sesiones estancado — vuelve a %2$@ %3$@ de ayuda y sube otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ séances au point mort — retour à %2$@ %3$@ d’aide et on remonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ सत्र से रुका हुआ — वापस %2$@ %3$@ सहारे पर और फिर से बढ़ाओ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ edzés óta megrekedt — vissza %2$@ %3$@ segítségre, és építsd fel újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermo da %1$@ sessioni — torna a %2$@ %3$@ di aiuto e risali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@회 정체 — 보조 %2$@ %3$@로 돌아가 다시 쌓기."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastój od %1$@ sesji — wróć do %2$@ %3$@ pomocy i buduj od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sessões estagnado — de volta a %2$@ %3$@ de ajuda e sobe outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sessões estagnado — de volta a %2$@ %3$@ de ajuda e sobe outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Застой %1$@ тренировок — назад к %2$@ %3$@ помощи и набирать заново."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัน %1$@ ครั้ง — กลับไปใช้ตัวช่วย %2$@ %3$@ แล้วไต่ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ antrenmandır takılı — %2$@ %3$@ desteğe dön ve yeniden çık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застій %1$@ тренувань поспіль — назад до %2$@ %3$@ допомоги й нарощуй знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已停滞 %1$@ 次 — 回到 %2$@ %3$@ 辅助，重新往上加。"
          }
        }
      }
    },
    "Stalled {0} sessions — deload to {1} {2}.": {
