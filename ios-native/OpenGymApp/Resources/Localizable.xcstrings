    "Not quite right? Say what to change below and I will revise the whole plan.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست مناسبة تمامًا؟ اذكر ما تريد تغييره أدناه وسأراجع الخطة كاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ganz richtig? Schreib unten, was sich ändern soll, und ich überarbeite den ganzen Plan."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ganz richtig? Schreib unten, was sich ändern soll, und ich überarbeite den ganzen Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No es lo que buscabas? Escribe abajo qué cambiar y revisaré todo el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas tout à fait ça ? Dis-moi ci-dessous quoi changer et je revois tout le plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक नहीं लगा? नीचे बताएँ क्या बदलना है और मैं पूरी योजना संशोधित कर दूँगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem egészen jó? Írd le lent, mit változtassak, és az egész tervet átdolgozom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è proprio così? Scrivi qui sotto cosa cambiare e rivedo l’intero piano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 안 드나요? 아래에 바꿀 점을 말해주시면 계획 전체를 수정할게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie do końca to? Napisz poniżej, co zmienić, a poprawię cały plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é bem isso? Diz abaixo o que mudar e eu revejo o plano todo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ficou bom? Diga abaixo o que mudar e eu reviso o plano inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не совсем то? Напишите ниже, что изменить, и я пересмотрю весь план."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ถูกใจ บอกด้านล่างว่าจะเปลี่ยนอะไร แล้วฉันจะปรับปรุงแผนทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam olmadı mı? Aşağıya neyi değiştireceğimi yaz, tüm planı gözden geçireyim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зовсім те? Напиши нижче, що змінити, і я перегляну весь план."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不太合适？在下方说说要改什么，我会重新修改整个计划。"
          }
        }
      }
    },
