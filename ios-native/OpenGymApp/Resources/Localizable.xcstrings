    "Applies to every exercise in this routine that does not set its own rule.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على كل تمرين في هذا الروتين الذي لا يحدد قاعدته الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jede Übung dieser Routine, die keine eigene Regel hat."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jede Übung dieser Routine, die keine eigene Regel hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a cada ejercicio de esta rutina que no defina su propia regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à chaque exercice de cette routine qui ne définit pas sa propre règle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रूटीन के हर उस व्यायाम पर लागू, जिसका अपना नियम नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gyakorlatra vonatkozik ebben a rutinban, amelynek nincs saját szabálya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per ogni esercizio di questa scheda che non imposta una regola propria."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루틴에서 자체 규칙을 정하지 않은 모든 운동에 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy każdego ćwiczenia w tym planie, które nie ma własnej zasady."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todos os exercícios desta rotina que não definam a sua própria regra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todos os exercícios desta rotina que não definam a sua própria regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует для всех упражнений программы, у которых нет своего правила."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับทุกท่าในรูทีนนี้ที่ไม่ได้ตั้งกฎเฉพาะของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rutinde kendi kuralını belirlemeyen her egzersiz için geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діє для всіх вправ програми, які не мають власного правила."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于此计划中未单独设置规则的每个动作。"
          }
        }
      }
    },
    "Applies to this exercise everywhere, not just this plan.": {
