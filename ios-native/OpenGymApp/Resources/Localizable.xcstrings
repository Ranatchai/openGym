    "Filters the exercise library and picker, and flags routine exercises that need something you don’t have in the active profile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصفّي مكتبة التمارين والمنتقي، ويميز تمارين الروتين التي تحتاج معدات غير موجودة في الملف النشط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtert die Übungsbibliothek und die Auswahl und markiert Übungen in Routinen, die Geräte brauchen, die du im aktiven Profil nicht hast."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtert die Übungsbibliothek und die Auswahl und markiert Übungen in Routinen, die Geräte brauchen, die du im aktiven Profil nicht hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra la biblioteca de ejercicios y el selector, y marca los ejercicios de las rutinas que necesitan algo que no tienes en el perfil activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre la bibliothèque d’exercices et le sélecteur, et signale les exercices de routine qui nécessitent quelque chose que tu n’as pas dans le profil actif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कसरत लाइब्रेरी और चयनकर्ता को फ़िल्टर करता है, और उन रूटीन कसरतों को चिह्नित करता है जिनके लिए सक्रिय प्रोफ़ाइल में मौजूद न होने वाला उपकरण चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szűri a gyakorlattárat és a választót, és megjelöli a rutinok azon gyakorlatait, amelyekhez olyasmi kell, ami nincs az aktív profilodban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra la libreria degli esercizi e il selettore, e segnala gli esercizi delle routine che richiedono qualcosa che non hai nel profilo attivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 라이브러리와 선택기를 필터링하고, 활성 프로필에 없는 장비가 필요한 루틴 운동을 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruje bibliotekę ćwiczeń i selektor oraz oznacza ćwiczenia w rutynach, które wymagają czegoś, czego nie masz w aktywnym profilu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra a biblioteca de exercícios e o seletor, e assinala os exercícios das rotinas que precisam de algo que não tens no perfil ativo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra a biblioteca de exercícios e o seletor, e sinaliza os exercícios das rotinas que precisam de algo que você não tem no perfil ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильтрует библиотеку упражнений и выбор, а также отмечает упражнения в программах, для которых нужно то, чего нет в активном профиле."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรองคลังท่าออกกำลังกายและตัวเลือกท่า พร้อมทั้งทำเครื่องหมายท่าในรูทีนที่ต้องใช้อุปกรณ์ที่ไม่มีในโปรไฟล์ที่ใช้งานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket kitaplığını ve seçiciyi filtreler, ayrıca aktif profilinde olmayan bir şeye ihtiyaç duyan rutin hareketlerini işaretler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільтрує бібліотеку вправ і вибір, а також позначає вправи в програмах, для яких потрібне те, чого немає в активному профілі."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选动作库和选择器，并标记训练计划中需要当前配置里没有的器械的动作。"
          }
        }
      }
    },
    "Finish": {
