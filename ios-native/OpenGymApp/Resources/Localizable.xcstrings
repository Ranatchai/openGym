    "Lets you sign in with it instead of your name. Nothing is ever sent to it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك تسجيل الدخول به بدلًا من اسمك. لا يُرسَل إليه أي شيء أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kannst du dich statt mit deinem Namen anmelden. Es wird nie etwas an sie geschickt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kannst du dich statt mit deinem Namen anmelden. Es wird nie etwas an sie geschickt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permite iniciar sesión con él en lugar de con tu nombre. Nunca se le envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permet de te connecter avec lui au lieu de ton nom. Rien ne lui est jamais envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आप अपने नाम की जगह इससे साइन इन कर सकते हैं। इस पर कभी कुछ नहीं भेजा जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A neved helyett ezzel is bejelentkezhetsz. Soha nem küldünk rá semmit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti permette di accedere con essa invece che con il nome. Non le viene mai inviato nulla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 대신 이메일로 로그인할 수 있습니다. 이 주소로는 아무것도 보내지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala logować się nim zamiast nazwą. Nic nigdy nie jest na niego wysyłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite-te iniciar sessão com ele em vez do teu nome. Nunca lhe é enviado nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que você entre com ele em vez do seu nome. Nada é enviado para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет входить с ним вместо имени. На него никогда ничего не отправляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้คุณเข้าสู่ระบบด้วยอีเมลแทนชื่อได้ ไม่มีการส่งอะไรไปที่อีเมลนี้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsmin yerine bununla giriş yapmanı sağlar. Bu adrese asla bir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дає змогу входити з ним замість імені. На нього ніколи нічого не надсилається."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "可以用它代替名字登录。不会向它发送任何邮件。"
          }
        }
      }
    },
