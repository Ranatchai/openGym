          "stringUnit": {
            "state": "translated",
            "value": "Las passkeys usan %1$@. Donde no funcionan, también sirve una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les passkeys utilisent %1$@. Là où elles ne fonctionnent pas, un mot de passe marche aussi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकी %1$@ का उपयोग करती हैं। जहाँ वे काम नहीं करतीं, वहाँ पासवर्ड भी चलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszókulcs ezt használja: %1$@. Ahol nem működik, jelszóval is megy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passkey usano %1$@. Dove non funzionano, va bene anche una password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키는 %1$@을(를) 사용합니다. 패스키가 작동하지 않는 곳에서는 비밀번호도 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey używa: %1$@. Tam, gdzie nie działa, wystarczy też hasło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As passkeys usam %1$@. Onde não funcionam, uma palavra-passe também serve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de acesso usam %1$@. Onde elas não funcionam, uma senha também serve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи доступа используют %1$@. Где они не работают, подойдёт и пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พาสคีย์ใช้ %1$@ ในที่ที่พาสคีย์ใช้ไม่ได้ ใช้รหัสผ่านก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
