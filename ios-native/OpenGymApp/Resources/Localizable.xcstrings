    "Add an exercise to a routine first — an empty plan has nothing to share.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تمرينًا إلى الروتين أولًا — لا يمكن مشاركة خطة فارغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst eine Übung zu einer Routine hinzu — ein leerer Plan hat nichts zu teilen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst eine Übung zu einer Routine hinzu — ein leerer Plan hat nichts zu teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade primero un ejercicio a una rutina: un plan vacío no tiene nada que compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute d'abord un exercice à une routine — un plan vide n'a rien à partager."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले किसी रूटीन में व्यायाम जोड़ें — खाली प्लान में साझा करने को कुछ नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá előbb egy gyakorlatot egy rutinhoz — egy üres tervnek nincs mit megosztania."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima un esercizio a una routine — un piano vuoto non ha nulla da condividere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 루틴에 운동을 추가하세요 — 빈 계획은 공유할 것이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj ćwiczenie do planu treningowego — pusty plan nie ma czym się dzielić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona primeiro um exercício a uma rotina — um plano vazio não tem nada para partilhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro um exercício a uma rotina — um plano vazio não tem nada para compartilhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавь упражнение в программу — пустым планом нечего делиться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มท่าเข้ารูทีนก่อน — แผนว่างเปล่าไม่มีอะไรให้แชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir rutine egzersiz ekle — boş bir planın paylaşacak bir şeyi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку додай вправу в програму — порожнім планом нема чим ділитися."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
