    "Plates are counted from 0 — turn this off for the default ({0}).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب الأقراص من 0 — أوقف هذا للعودة إلى الافتراضي (%1$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheiben werden ab 0 gerechnet — ausschalten fuer den Standard (%1$@)."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheiben werden ab 0 gerechnet — ausschalten fuer den Standard (%1$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plates are counted from 0 — turn this off for the default (%1$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los discos se cuentan desde 0 — desactívalo para el valor por defecto (%1$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques sont comptés à partir de 0 — désactive pour la valeur par défaut (%1$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेट 0 से गिनी जाती हैं — डिफ़ॉल्ट (%1$@) के लिए इसे बंद करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tárcsák 0-tól számítanak — kapcsold ki az alapértékhez (%1$@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dischi si contano da 0 — disattiva per il valore predefinito (%1$@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원판을 0부터 계산합니다 — 기본값(%1$@)으로 돌리려면 끄세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Talerze liczone od 0 — wyłącz, aby wrócić do domyślnego (%1$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os discos contam a partir de 0 — desliga para o valor predefinido (%1$@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os discos contam a partir de 0 — desliga para o valor predefinido (%1$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блины считаются от 0 — выключи, чтобы вернуть значение по умолчанию (%1$@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับแผ่นจาก 0 — ปิดเพื่อกลับไปค่าเริ่มต้น (%1$@)"
