    "Top of the rep range in every set — {0} {1} less help, back to {2} reps.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى نطاق التكرارات في كل مجموعة — مساعدة أقل بمقدار %1$@ %2$@، وعودة إلى %3$@ تكرارًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberes Ende des Wiederholungsbereichs in jedem Satz — %1$@ %2$@ weniger Hilfe, zurück auf %3$@ Wiederholungen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberes Ende des Wiederholungsbereichs in jedem Satz — %1$@ %2$@ weniger Hilfe, zurück auf %3$@ Wiederholungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top of the rep range in every set — %1$@ %2$@ less help, back to %3$@ reps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tope del rango de repeticiones en cada serie — %1$@ %2$@ menos de ayuda, vuelve a %3$@ repeticiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut de la fourchette de répétitions à chaque série — %1$@ %2$@ d’aide en moins, retour à %3$@ répétitions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेट में दोहराव सीमा के शीर्ष पर — %1$@ %2$@ कम सहारा, वापस %3$@ दोहराव पर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ismétléstartomány teteje minden sorozatban — %1$@ %2$@ kevesebb segítség, vissza %3$@ ismétlésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cima dell’intervallo di ripetizioni in ogni serie — %1$@ %2$@ di aiuto in meno, torna a %3$@ ripetizioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세트에서 반복 범위 상단 — 보조 %1$@ %2$@ 줄이고 %3$@회로 돌아가기."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Górny zakres powtórzeń w każdej serii — %1$@ %2$@ mniej pomocy, wróć do %3$@ powtórzeń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Topo do intervalo de repetições em cada série — %1$@ %2$@ menos de ajuda, de volta a %3$@ repetições."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Topo do intervalo de repetições em cada série — %1$@ %2$@ menos de ajuda, de volta a %3$@ repetições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верх диапазона повторений в каждом подходе — помощи меньше на %1$@ %2$@, снова %3$@ повторений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงเพดานช่วงจำนวนครั้งทุกเซ็ต — ลดตัวช่วย %1$@ %2$@ แล้วกลับไปที่ %3$@ ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sette tekrar aralığının üstü — %1$@ %2$@ daha az destek, %3$@ tekrara dön."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верх діапазону повторень у кожному підході — на %1$@ %2$@ менше допомоги, знову %3$@ повт."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每组都达到次数上限 — 辅助减少 %1$@ %2$@，回到 %3$@ 次。"
          }
        }
      }
    },
