    "Off — choose how the Coach should run.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف — اختر كيفية عمل المدرب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus — wähle, wie der Coach laufen soll."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus — wähle, wie der Coach laufen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagado: elige cómo debe funcionar el entrenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé — choisis comment le coach doit fonctionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद — चुनें कि कोच कैसे चले।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki — válaszd ki, hogyan fusson az Edző."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spento: scegli come deve funzionare il Coach."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐 — 코치 실행 방식을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączony — wybierz, jak ma działać trener."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado — escolhe como o Treinador deve correr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado — escolha como o Treinador deve rodar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключен — выберите, как должен работать тренер."
          }
        },
        "th": {
