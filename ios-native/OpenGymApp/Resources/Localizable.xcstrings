    "Your server answered with an error (HTTP {0}). Your changes are kept here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ خادمك بخطأ (HTTP %1$@). تغييراتك محفوظة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat mit einem Fehler geantwortet (HTTP %1$@). Deine Änderungen bleiben hier."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat mit einem Fehler geantwortet (HTTP %1$@). Deine Änderungen bleiben hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server answered with an error (HTTP %1$@). Your changes are kept here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor respondió con un error (HTTP %1$@). Tus cambios se quedan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur a répondu par une erreur (HTTP %1$@). Vos modifications restent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर ने त्रुटि के साथ जवाब दिया (HTTP %1$@)। आपके बदलाव यहीं रखे हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szervered hibával válaszolt (HTTP %1$@). A módosításaid itt maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server ha risposto con un errore (HTTP %1$@). Le tue modifiche restano qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 오류로 응답했습니다 (HTTP %1$@). 변경 사항은 이 기기에 보관됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój serwer odpowiedział błędem (HTTP %1$@). Twoje zmiany zostają tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu servidor respondeu com um erro (HTTP %1$@). As tuas alterações ficam aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor respondeu com um erro (HTTP %1$@). Suas alterações ficam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер ответил ошибкой (HTTP %1$@). Ваши изменения остаются здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ของคุณตอบกลับด้วยข้อผิดพลาด (HTTP %1$@) การเปลี่ยนแปลงของคุณยังเก็บไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucun bir hatayla yanıt verdi (HTTP %1$@). Değişikliklerin burada kalıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій сервер відповів помилкою (HTTP %1$@). Твої зміни збережено тут."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器返回了错误（HTTP %1$@）。你的更改保留在这里。"
          }
        }
      }
    },
    "Your server cannot be reached — showing the last copy synced with it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خادمك — يُعرض آخر نسخة متزامنة معه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist nicht erreichbar — zeigt die zuletzt mit ihm synchronisierte Kopie."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist nicht erreichbar — zeigt die zuletzt mit ihm synchronisierte Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede llegar a tu servidor: se muestra la última copia sincronizada con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur est injoignable — affichage de la dernière copie synchronisée avec lui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर तक नहीं पहुँचा जा सकता — उससे सिंक की गई आख़िरी प्रति दिखाई जा रही है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szervered nem érhető el — a vele utoljára szinkronizált másolat látható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server non è raggiungibile — viene mostrata l’ultima copia sincronizzata con esso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다 — 서버와 마지막으로 동기화된 사본을 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój serwer jest nieosiągalny — wyświetlana jest ostatnia kopia z nim zsynchronizowana."
          }
        },
        "pt": {
