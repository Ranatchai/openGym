    "{0} set still unchecked. Finish the workout now?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ مجموعة لم تُحدد بعد. هل تريد إنهاء التمرين الآن؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Satz noch offen. Training jetzt beenden?"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Satz noch offen. Training jetzt beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ set still unchecked. Finish the workout now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda %1$@ serie sin marcar. ¿Terminar ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ série non cochée. Terminer maintenant ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ सेट अभी बाकी है। अभी समाप्त करें?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sorozat még nincs kipipálva. Befejezed most az edzést?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ serie non spuntata. Terminare ora?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 %1$@세트가 남았어요. 지금 마칠까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Została %1$@ nieodhaczona seria. Zakończyć teraz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta %1$@ série por marcar. Terminar agora?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta %1$@ série sem marcar. Finalizar o treino agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отмечен %1$@ подход. Завершить сейчас?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมี %1$@ เซ็ตที่ยังไม่ติ๊ก จะจบตอนนี้เลยไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ set işaretlenmedi. Şimdi bitirilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не відмічено %1$@ підхід. Завершити зараз?"
          }
        },
        "zh": {
