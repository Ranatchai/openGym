    "Move, swap and remove below act on the exercise marked {0}.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل أزرار النقل والاستبدال والإزالة أدناه على التمرين المحدد %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben, Tauschen und Entfernen unten wirken auf die als %1$@ markierte Übung."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben, Tauschen und Entfernen unten wirken auf die als %1$@ markierte Übung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move, swap and remove below act on the exercise marked %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, cambiar y eliminar actúan sobre el ejercicio marcado como %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer, échanger et supprimer ci-dessous s’appliquent à l’exercice marqué %1$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे दिए गए मूव, स्वैप और रिमूव %1$@ के रूप में चिह्नित व्यायाम पर लागू होते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alábbi áthelyezés, csere és törlés a %1$@ jelölésű gyakorlatra vonatkozik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostamento, scambio e rimozione qui sotto agiscono sull’esercizio contrassegnato come %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 이동, 교체, 삭제는 %1$@ 표시된 운동에 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie, zamiana i usuwanie poniżej dotyczą ćwiczenia oznaczonego %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, trocar e remover abaixo atuam sobre o exercício marcado como %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, trocar e remover abaixo atuam sobre o exercício marcado como %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки перемещения, замены и удаления ниже действуют на упражнение с пометкой %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้าย สลับ และลบด้านล่างจะมีผลกับท่าที่ทำเครื่องหมาย %1$@ ไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki taşıma, değiştirme ve kaldırma işlemleri %1$@ olarak işaretli egzersiz için geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки переміщення, заміни та видалення нижче діють на вправу, позначену %1$@."
