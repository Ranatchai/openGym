    "Reminds you at this time on days that have a routine planned.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك في هذا الوقت في الأيام التي تحتوي روتينًا مجدولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich zu dieser Zeit an Tagen, für die eine Routine geplant ist."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich zu dieser Zeit an Tagen, für die eine Routine geplant ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa a esta hora los días que tienen una rutina planificada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous rappelle à cette heure les jours où une routine est planifiée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन दिनों रूटीन प्लान है, उस समय याद दिलाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkor emlékeztet azokon a napokon, amikor rutin van tervezve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa a quest’ora nei giorni con una routine pianificata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴이 계획된 날 이 시간에 알려 드립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina o tej godzinie w dni z zaplanowaną rutyną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra-te a esta hora nos dias com uma rotina planeada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra você neste horário nos dias em que há uma rotina planejada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает в это время в дни с запланированной программой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเตือนคุณตามเวลานี้ในวันที่มีรูทีนวางแผนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutin planlanmış günlerde bu saatte hatırlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадує в цей час у дні із запланованою програмою."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在安排了训练计划的日子，此时间提醒你。"
