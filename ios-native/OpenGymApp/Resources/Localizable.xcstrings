    "You haven’t checked off any sets. Finish the workout anyway?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تحدد أي مجموعة كمكتملة. هل تريد إنهاء التمرين على أي حال؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch keine Sätze abgehakt. Training trotzdem beenden?"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch keine Sätze abgehakt. Training trotzdem beenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has marcado ninguna serie. ¿Terminar el entrenamiento igualmente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as coché aucune série. Terminer la séance quand même ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने कोई सेट चेक नहीं किया। फिर भी वर्कआउट समाप्त करें?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még egyetlen sorozatot sem pipáltál ki. Mindenképp befejezed az edzést?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai spuntato nessuna serie. Terminare comunque?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크한 세트가 없어요. 그래도 운동을 마칠까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie odhaczyłeś żadnej serii. Mimo to zakończyć trening?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não marcaste nenhuma série. Terminar o treino mesmo assim?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não marcou nenhuma série. Deseja finalizar o treino mesmo assim?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один подход не отмечен. Всё равно завершить тренировку?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้ติ๊กเซ็ตไหนเลย จะจบการออกกำลังกายเลยไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç set işaretlemedin. Yine de antrenman bitsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодного підходу не відмічено. Все одно завершити тренування?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有勾选任何组。仍要结束训练吗？"
          }
        }
      }
    },
    "You still log the total weight — this only feeds the plate line under each set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زلت تسجل الوزن الإجمالي — هذا يغذي سطر الأقراص تحت كل مجموعة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingetragen wird weiterhin das Gesamtgewicht — das dient nur der Scheiben-Zeile unter jedem Satz."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingetragen wird weiterhin das Gesamtgewicht — das dient nur der Scheiben-Zeile unter jedem Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigues registrando el peso total — esto solo alimenta la línea de discos bajo cada serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu enregistres toujours le poids total — cela ne sert qu'à la ligne de disques sous chaque série."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अब भी कुल वज़न ही दर्ज करते हैं — यह सिर्फ़ हर सेट के नीचे की प्लेट लाइन में काम आता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Továbbra is a teljes súlyt rögzíted — ez csak a sorozatok alatti tárcsasor kiszámításához kell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registri comunque il peso totale — questo serve solo alla riga dei dischi sotto ogni serie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 여전히 총 무게입니다 — 이 값은 각 세트 아래의 플레이트 줄에만 쓰입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal zapisujesz ciężar całkowity — to służy tylko do linii z talerzami pod każdą serią."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuas a registar o peso total — isto só alimenta a linha de discos debaixo de cada série."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você continua registrando o peso total — isso só alimenta a linha de anilhas embaixo de cada série."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывается по-прежнему общий вес — это нужно только для строки с блинами под каждым подходом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังบันทึกน้ำหนักรวมเหมือนเดิม — ค่านี้ใช้แค่กับแถวแผ่นน้ำหนักใต้แต่ละเซ็ตเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de toplam ağırlığı kaydedersin — bu yalnızca her setin altındaki disk satırına yarar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записується, як і раніше, загальна вага — це потрібно лише для рядка з блинами під кожним підходом."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "记录的仍是总重量——这只用于每组下方的杠铃片提示行。"
          }
        }
      }
    },
