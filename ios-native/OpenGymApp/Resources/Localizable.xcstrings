    "“{0}” is saved, but signs in only once this profile has a password.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» محفوظ، لكنه لا يُستخدم لتسجيل الدخول إلا بعد أن يصبح لهذا الملف كلمة مرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist gespeichert, meldet dich aber erst an, wenn dieses Profil ein Passwort hat."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist gespeichert, meldet dich aber erst an, wenn dieses Profil ein Passwort hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is saved, but signs in only once this profile has a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está guardado, pero solo sirve para iniciar sesión cuando este perfil tenga contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est enregistré, mais ne sert à te connecter qu’une fois que ce profil a un mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" सेव है, लेकिन इससे साइन इन तभी होगा जब इस प्रोफ़ाइल का पासवर्ड हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” el van mentve, de csak akkor lehet vele bejelentkezni, ha ennek a profilnak van jelszava."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è salvato, ma serve per accedere solo quando questo profilo avrà una password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\"이(가) 저장되어 있지만, 이 프로필에 비밀번호가 있어야 로그인에 쓸 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” jest zapisany, ale posłuży do logowania dopiero, gdy ten profil będzie mieć hasło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está guardado, mas só serve para iniciar sessão quando este perfil tiver uma palavra-passe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” está salvo, mas só serve para entrar depois que este perfil tiver uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» сохранён, но для входа сработает, только когда у этого профиля будет пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก “%1$@” ไว้แล้ว แต่จะใช้เข้าสู่ระบบได้เมื่อโปรไฟล์นี้มีรหัสผ่านเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” kayıtlı, ancak bu profilin bir şifresi olduğunda giriş için kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» збережено, але для входу спрацює, лише коли в цього профілю буде пароль."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”已保存，但只有此个人资料设置了密码后才能用它登录。"
          }
        }
      }
    }
