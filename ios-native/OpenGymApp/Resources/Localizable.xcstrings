    "Saves a dated copy to Documents/openGym after finishing a workout or editing a routine, and keeps the newest {0} — point a sync app at that folder, or copy it out by hand.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نسخة مؤرخة في مجلد «المستندات/openGym» بعد إنهاء تمرين أو تعديل روتين، ويحتفظ بأحدث %1$@ نسخة — وجّه تطبيق مزامنة إلى هذا المجلد أو انسخها يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert nach jedem beendeten Training oder jeder bearbeiteten Routine eine datierte Kopie im Ordner „Dokumente/openGym“ und behält die neuesten %1$@ — richte eine Sync-App auf diesen Ordner aus oder kopiere die Datei von Hand."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert nach jedem beendeten Training oder jeder bearbeiteten Routine eine datierte Kopie im Ordner „Dokumente/openGym“ und behält die neuesten %1$@ — richte eine Sync-App auf diesen Ordner aus oder kopiere die Datei von Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a dated copy to Documents/openGym after finishing a workout or editing a routine, and keeps the newest %1$@ — point a sync app at that folder, or copy it out by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia fechada en la carpeta Documentos/openGym al terminar un entrenamiento o editar una rutina, y conserva las %1$@ más recientes — apunta una app de sincronización a esa carpeta, o copia el archivo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une copie datée dans le dossier Documents/openGym après chaque entraînement terminé ou modification de routine, et garde les %1$@ plus récentes — pointez une appli de synchronisation sur ce dossier, ou copiez le fichier à la main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट खत्म करने या रूटीन एडिट करने के बाद Documents/openGym फ़ोल्डर में तारीख़ वाली कॉपी सेव करता है और सबसे नई %1$@ कॉपी रखता है — उस फ़ोल्डर पर कोई सिंक ऐप लगाएं, या फ़ाइल को हाथ से कॉपी करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátumozott másolatot ment a Dokumentumok/openGym mappába egy edzés befejezése vagy egy rutin szerkesztése után, és a legutóbbi %1$@ másolatot tartja meg — irányíts erre a mappára egy szinkronizáló appot, vagy másold ki kézzel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una copia datata nella cartella Documenti/openGym dopo aver terminato un allenamento o modificato una routine, e tiene le %1$@ più recenti — punta un'app di sincronizzazione su quella cartella, oppure copia il file a mano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동을 마치거나 루틴을 수정한 뒤 날짜가 적힌 사본을 문서/openGym 폴더에 저장하고 최근 %1$@개만 남깁니다 — 동기화 앱이 그 폴더를 보게 하거나 파일을 직접 복사하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje datowaną kopię w folderze Dokumenty/openGym po zakończeniu treningu lub edycji rutyny i zachowuje %1$@ najnowszych — wskaż ten folder aplikacji synchronizującej albo skopiuj plik ręcznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda uma cópia datada na pasta Documentos/openGym após terminar um treino ou editar uma rotina e mantém as %1$@ mais recentes — aponta uma app de sincronização para essa pasta, ou copia o ficheiro à mão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma cópia datada na pasta Documentos/openGym depois de terminar um treino ou editar uma rotina e mantém as %1$@ mais recentes — aponte um aplicativo de sincronização para essa pasta, ou copie o arquivo na mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет копию с датой в папку «Документы/openGym» после завершения тренировки или редактирования программы и хранит %1$@ последних — направьте на эту папку приложение синхронизации или скопируйте файл вручную."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสำเนาที่มีวันที่กำกับไว้ในโฟลเดอร์ Documents/openGym หลังจบการออกกำลังกายหรือแก้ไขรูทีน และเก็บไว้เฉพาะ %1$@ ฉบับล่าสุด — ตั้งแอปซิงก์ให้ชี้มาที่โฟลเดอร์นี้ หรือคัดลอกออกไปเองก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir antrenmanı bitirdikten veya bir rutini düzenledikten sonra Belgeler/openGym klasörüne tarihli bir kopya kaydeder ve en yeni %1$@ kopyayı tutar — bir senkronizasyon uygulamasını bu klasöre yönlendir ya da dosyayı elle kopyala."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає копію з датою в папку «Документи/openGym» після завершення тренування або редагування програми й тримає %1$@ найновіших — спрямуй на цю папку застосунок синхронізації або скопіюй файл вручну."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "完成训练或编辑计划后，会在「文档/openGym」文件夹中保存一份带日期的副本，并只保留最近的 %1$@ 份——可以让同步应用指向该文件夹，或手动复制出来。"
          }
        }
      }
    },
    "Say it in your own words and the Coach will revise the whole plan.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قلها بكلماتك وسيراجع المدرب الخطة كاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es in deinen eigenen Worten, und der Coach überarbeitet den ganzen Plan."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es in deinen eigenen Worten, und der Coach überarbeitet den ganzen Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo con tus palabras y el Entrenador revisará todo el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-le avec vos mots et le Coach révisera tout le plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शब्दों में कहें और कोच पूरा प्लान संशोधित कर देगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd le a saját szavaiddal, és az Edző az egész tervet átdolgozza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dillo con parole tue e il Coach rivedrà tutto il piano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 말로 설명하면 코치가 계획 전체를 수정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to własnymi słowami, a Trener poprawi cały plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Di-lo por palavras tuas e o Treinador revê o plano todo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga com suas palavras e o Treinador revisa o plano inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите своими словами, и Тренер переработает весь план."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกด้วยคำพูดของคุณเอง แล้วโค้ชจะปรับปรุงแผนทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
