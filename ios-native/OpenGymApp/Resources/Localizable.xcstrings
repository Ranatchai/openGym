{
  "sourceLanguage": "en",
  "strings": {
    "\"{0}\" and its equipment list will be removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف «%1$@» مع قائمة معداته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und die zugehörige Geräteliste werden entfernt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und die zugehörige Geräteliste werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" and its equipment list will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» y su lista de equipo se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et sa liste d’équipement seront supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” और उसकी उपकरण सूची हटा दी जाएगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” és az eszközlistája el lesz távolítva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e il suo elenco di attrezzi verranno rimossi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’과(와) 해당 장비 목록이 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” i jego lista sprzętu zostaną usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e a respetiva lista de equipamento serão removidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e sua lista de equipamentos serão removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и его список инвентаря будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" และรายการอุปกรณ์จะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ve ekipman listesi kaldırılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» та його список інвентарю буде видалено."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”及其器械清单将被删除。"
          }
        }
      }
    },
