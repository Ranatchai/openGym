    "Nothing yet. Every plan, suggestion and debrief will be kept here — whether you said yes or no.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بعد. ستُحفظ هنا كل خطة واقتراح وملخص — سواء وافقت أم رفضت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Jeder Plan, Vorschlag und jede Auswertung wird hier aufbewahrt – egal ob du Ja oder Nein gesagt hast."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Jeder Plan, Vorschlag und jede Auswertung wird hier aufbewahrt – egal ob du Ja oder Nein gesagt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aún. Cada plan, sugerencia y evaluación se guardará aquí — digas sí o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant. Chaque plan, suggestion et bilan sera gardé ici — que tu dises oui ou non."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ नहीं। हर प्लान, सुझाव और समीक्षा यहाँ रखी जाएगी — चाहे आप हाँ कहें या ना।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi. Minden terv, javaslat és kiértékelés itt lesz megőrizve — akár igent, akár nemet mondtál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente. Ogni piano, suggerimento e valutazione verrà conservato qui — che tu dica sì o no."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없어요. 모든 플랜, 제안, 평가가 여기에 보관됩니다 — 수락하든 거절하든."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic. Każdy plan, sugestia i podsumowanie będą tu zachowane — niezależnie od tego, czy powiesz tak czy nie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada. Cada plano, sugestão e balanço fica guardado aqui — digas sim ou não."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ainda. Cada plano, sugestão e balanço fica guardado aqui — diga você sim ou não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего. Каждый план, предложение и разбор будут храниться здесь — ответил ты «да» или «нет»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไร ทุกแผน ข้อเสนอแนะ และสรุปผลจะถูกเก็บไว้ที่นี่ — ไม่ว่าคุณจะตอบรับหรือปฏิเสธ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey yok. Her plan, öneri ve değerlendirme burada saklanacak — evet ya da hayır desen de."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нічого. Кожен план, пропозиція й розбір зберігатимуться тут — незалежно від того, погодився ти чи ні."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
