    "No sets are left in this workout, so there is nothing to save. Delete it from your history?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبقَ أي مجموعة في هذا التمرين، فلا يوجد ما يُحفظ. هل تريد حذفه من سجلك؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Training ist kein Satz mehr übrig, es gibt also nichts zu speichern. Aus deinem Verlauf löschen?"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Training ist kein Satz mehr übrig, es gibt also nichts zu speichern. Aus deinem Verlauf löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda ninguna serie en este entrenamiento, así que no hay nada que guardar. ¿Eliminarlo de tu historial?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste aucune série dans cette séance, il n’y a donc rien à enregistrer. La supprimer de ton historique ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्कआउट में कोई सेट नहीं बचा है, इसलिए सहेजने को कुछ नहीं है। इसे अपने इतिहास से हटाएँ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben az edzésben egy sorozat sem maradt, így nincs mit menteni. Törlöd az előzményeidből?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo allenamento non è rimasta nessuna serie, quindi non c’è niente da salvare. Eliminarlo dalla cronologia?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 운동에 남은 세트가 없어 저장할 내용이 없습니다. 기록에서 삭제할까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym treningu nie została żadna seria, więc nie ma czego zapisać. Usunąć go z historii?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não resta nenhuma série neste treino, por isso não há nada para guardar. Eliminá-lo do histórico?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não sobrou nenhuma série neste treino, então não há nada para salvar. Excluí-lo do seu histórico?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой тренировке не осталось ни одного подхода, сохранять нечего. Удалить её из истории?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกกำลังกายนี้ไม่เหลือเซ็ตแล้ว จึงไม่มีอะไรให้บันทึก ลบออกจากประวัติไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu antrenmanda hiç set kalmadı, yani kaydedilecek bir şey yok. Geçmişinden silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому тренуванні не лишилося жодного підходу, тож зберігати нічого. Видалити його з історії?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这次训练已经没有任何一组了，没有可保存的内容。要从历史中删除它吗？"
          }
        }
      }
    },
