    "No entries yet — log your weight to start the curve.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إدخالات بعد — سجّل وزنك لبدء المنحنى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge — trag dein Gewicht ein, um die Kurve zu starten."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge — trag dein Gewicht ein, um die Kurve zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin registros aún — apunta tu peso para empezar la curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée — note ton poids pour démarrer la courbe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई एंट्री नहीं — ग्राफ़ शुरू करने के लिए वज़न दर्ज करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs bejegyzés — rögzítsd a súlyodat a görbe elindításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato — registra il tuo peso per iniziare la curva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기록이 없어요 — 체중을 기록해 그래프를 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów — zapisz wagę, aby zacząć krzywą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem registos — regista o teu peso para começar a curva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há registros — informe seu peso para começar a curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей пока нет — внеси вес, чтобы начать кривую."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีข้อมูล — บันทึกน้ำหนักเพื่อเริ่มกราฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıt yok — eğriyi başlatmak için kilonu gir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записів поки немає — внеси вагу, щоб почати криву."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记录——记录体重以开始曲线。"
          }
        }
      }
    },
    "No entries yet — log your weight to start the curve. It's also asked before every workout.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تسجيلات بعد — سجّل وزنك لتبدأ المنحنى. ويُطلب منك ذلك أيضًا قبل كل تمرين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge — trag dein Gewicht ein, um die Kurve zu starten. Es wird auch vor jedem Training abgefragt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge — trag dein Gewicht ein, um die Kurve zu starten. Es wird auch vor jedem Training abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin registros aún — apunta tu peso para empezar la curva. También se pide antes de cada entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée — note ton poids pour démarrer la courbe. Il est aussi demandé avant chaque séance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई एंट्री नहीं — ग्राफ़ शुरू करने के लिए वज़न दर्ज करें। हर वर्कआउट से पहले भी पूछा जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs bejegyzés — rögzítsd a súlyodat a görbe elindításához. Ezt minden edzés előtt is megkérdezzük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato — registra il tuo peso per iniziare la curva. Viene chiesto anche prima di ogni allenamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기록이 없어요 — 체중을 기록해 그래프를 시작하세요. 매 운동 전에도 물어봅니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
