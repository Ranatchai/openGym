        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzono. Teraz utwórz nowy passkey — przeglądarka zapyta, gdzie go zapisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmado. Agora cria a nova passkey — o teu navegador pergunta onde a guardar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmado. Agora crie a nova chave de acesso — seu navegador pergunta onde guardá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждено. Теперь создай новый ключ доступа — браузер спросит, где его хранить."
          }
        },
        "th": {
          "stringUnit": {
