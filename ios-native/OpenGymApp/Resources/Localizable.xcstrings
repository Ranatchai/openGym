    "Nothing changes, and the Coach will remember you turned these down.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتغير شيء، وسيتذكر المدرب أنك رفضتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ändert sich nichts, und der Coach merkt sich, dass du sie abgelehnt hast."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ändert sich nichts, und der Coach merkt sich, dass du sie abgelehnt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada, y el Entrenador recordará que las has rechazado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change, et le Coach se souviendra que vous les avez refusées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नहीं बदलेगा, और कोच याद रखेगा कि आपने इन्हें ठुकराया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem változik, és az Edző megjegyzi, hogy ezeket elutasítottad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla e il Coach ricorderà che li hai rifiutati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 바뀌지 않으며, 코치는 이를 거절했다는 사실을 기억합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie zmieni, a Trener zapamięta, że je odrzuciłeś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda, e o Treinador vai lembrar-se de que as recusaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda, e o Treinador vai lembrar que você recusou estas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменится, а Тренер запомнит, что вы их отклонили."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรเปลี่ยน และโค้ชจะจำไว้ว่าคุณปฏิเสธข้อเสนอเหล่านี้"
          }
        },
        "tr": {
