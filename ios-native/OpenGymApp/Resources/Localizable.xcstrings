    "All optional. The more the Coach knows, the less it guesses.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلها اختيارية. كلما عرف المدرب أكثر، قلّ تخمينه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optional. Je mehr der Coach weiß, desto weniger muss er raten."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optional. Je mehr der Coach weiss, desto weniger muss er raten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo opcional. Cuanto más sepa el entrenador, menos tendrá que adivinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est facultatif. Plus le coach en sait, moins il devine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब वैकल्पिक है। कोच जितना अधिक जानेगा, उतना कम अनुमान लगाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind opcionális. Minél többet tud az Edző, annál kevesebbet találgat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto facoltativo. Più il Coach sa, meno deve indovinare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 선택 사항입니다. 코치가 많이 알수록 추측이 줄어듭니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko opcjonalne. Im więcej trener wie, tym mniej zgaduje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo opcional. Quanto mais o Treinador souber, menos tem de adivinhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo opcional. Quanto mais o Treinador souber, menos tem de adivinhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё необязательно. Чем больше тренер знает, тем меньше он гадает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับทั้งหมด ยิ่งโค้ชรู้มาก ก็ยิ่งเดาน้อยลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi isteğe bağlı. Koç ne kadar çok bilirse o kadar az tahmin eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе необов’язково. Що більше тренер знає, то менше він вгадує."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "全部可选。教练了解得越多，猜测就越少。"
          }
        }
      }
    },
