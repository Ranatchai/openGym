    "Not enough people share yet — {0} of {1} needed. Ask your gym mates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يشارك عدد كافٍ بعد — المطلوب %2$@ والمتوفر %1$@. اطلب من رفاقك في الجيم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch teilen zu wenige – %1$@ von %2$@ nötig. Frag deine Trainingspartner."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch teilen zu wenige – %1$@ von %2$@ nötig. Frag deine Trainingspartner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough people share yet — %1$@ of %2$@ needed. Ask your gym mates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no comparte suficiente gente — %1$@ de %2$@ necesarias. Anima a tus compañeros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de participants — %1$@ sur %2$@ requis. Motive tes partenaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पर्याप्त लोग साझा नहीं करते — %2$@ में से %1$@ चाहिए। अपने जिम साथियों से कहें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem osztanak meg elegen — %1$@ / %2$@ szükséges. Kérdezd meg az edzőtársaidat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non condividono ancora abbastanza persone — %1$@ di %2$@ necessarie. Coinvolgi i tuoi compagni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 공유하는 사람이 부족해요 — %2$@명 중 %1$@명. 헬스장 친구들에게 권해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało osób udostępnia — %1$@ z %2$@ potrzebnych. Namów znajomych z siłowni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há gente suficiente a partilhar — %1$@ de %2$@ necessárias. Convence os teus colegas de ginásio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tem gente suficiente compartilhando — %1$@ de %2$@ necessárias. Chame seus parceiros de academia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока делится слишком мало людей — %1$@ из %2$@ нужных. Позови товарищей по залу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีคนแชร์ไม่พอ — ต้องการ %1$@ จาก %2$@ คน ชวนเพื่อนยิมของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yeterince kişi paylaşmıyor — %2$@ kişiden %1$@. Spor arkadaşlarına söyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ділиться замало людей — %1$@ з %2$@ потрібних. Поклич товаришів по залу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "共享的人还不够——需要 %2$@ 人，目前 %1$@ 人。叫上你的健身伙伴吧。"
