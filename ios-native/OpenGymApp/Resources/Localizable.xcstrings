    "Hit every rep in every set and the weight goes up. Repeated misses trigger a deload.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل كل تكرار في كل مجموعة ويرتفع الوزن. وعدم إكمال التكرارات عدة مرات يؤدي إلى تخفيف الحمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffst du jede Wiederholung in jedem Satz, steigt das Gewicht. Mehrfaches Verfehlen löst einen Deload aus."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffst du jede Wiederholung in jedem Satz, steigt das Gewicht. Mehrfaches Verfehlen löst einen Deload aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si completas todas las repeticiones de todas las series, sube el peso. Los fallos repetidos provocan una descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réussis toutes les répétitions de toutes les séries et le poids augmente. Des échecs répétés déclenchent une décharge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेट में सभी रेप्स पूरे करें तो वज़न बढ़ता है। बार-बार चूकने पर डीलोड होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha minden sorozatban minden ismétlést teljesítesz, a súly emelkedik. Ismételt kihagyás deloadot indít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completi tutte le ripetizioni in ogni serie, il peso sale. Fallimenti ripetuti attivano uno scarico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세트에서 목표 횟수를 채우면 무게가 올라갑니다. 반복해서 실패하면 디로드가 걸립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonaj wszystkie powtórzenia we wszystkich seriach, a ciężar rośnie. Powtarzające się niepowodzenia wywołują deload."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completares todas as repetições em todas as séries, o peso sobe. Falhas repetidas provocam uma descarga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua todas as repetições de todas as séries para aumentar o peso. Falhas repetidas acionam uma redução de carga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнил все повторения во всех подходах — вес растёт. Повторные неудачи запускают разгрузку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำครบทุกครั้งในทุกเซ็ตแล้วน้ำหนักจะเพิ่มขึ้น ถ้าพลาดซ้ำๆ จะลดน้ำหนักลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sette her tekrarı tamamlarsan ağırlık artar. Üst üste başarısızlık bir deload getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконав усі повторення в усіх підходах — вага зростає. Повторні невдачі запускають розвантаження."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每组都完成全部次数，重量就上调。反复未完成则触发减载。"
          }
        }
      }
    },
    "Hold every set for the full duration and the target goes up.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت كل مجموعة للمدة الكاملة ويرتفع الهدف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hältst du jeden Satz die volle Zeit, steigt die Vorgabe."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Hältst du jeden Satz die volle Zeit, steigt die Vorgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguanta todas las series el tiempo completo y el objetivo sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens chaque série pendant toute la durée et l’objectif augmente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेट पूरे समय तक होल्ड करें तो लक्ष्य बढ़ जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha minden sorozatot a teljes időn át tartasz, a célérték emelkedik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni ogni serie per tutta la durata e l’obiettivo sale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세트를 목표 시간만큼 버티면 목표가 올라갑니다."
          }
        },
        "pl": {
          "stringUnit": {
