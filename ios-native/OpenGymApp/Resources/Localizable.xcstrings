            "value": "Riprova"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar de novo"
          }
        },
        "pt-BR": {
          "stringUnit": {
