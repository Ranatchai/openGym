    "Imported — {0} routines are in your plan and your week is set. See you at the next session.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاستيراد — %1$@ روتينات في خطتك وأسبوعك مضبوط. أراك في الجلسة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernommen — %1$@ Routinen sind in deinem Plan und deine Woche steht. Bis zur nächsten Einheit."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernommen — %1$@ Routinen sind in deinem Plan und deine Woche steht. Bis zur nächsten Einheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported — %1$@ routines are in your plan and your week is set. See you at the next session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importado: %1$@ rutinas están en tu plan y tu semana ya está configurada. Nos vemos en la próxima sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé — %1$@ routines sont dans ton plan et ta semaine est réglée. À la prochaine séance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात हो गया — %1$@ रूटीन आपकी योजना में हैं और आपका सप्ताह सेट है। अगले सत्र में मिलते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálva — %1$@ rutin került a tervedbe, és a heted be van állítva. Találkozunk a következő edzésen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importato: %1$@ routine sono nel tuo piano e la settimana è impostata. Ci vediamo alla prossima sessione."
          }
        },
        "ko": {
          "stringUnit": {
