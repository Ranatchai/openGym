    "How hard a set was, logged next to weight and reps. Two scales for the same judgement, counted from opposite ends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدى صعوبة المجموعة، يُسجَّل بجانب الوزن والتكرارات. مقياسان لنفس التقييم، يُحسبان من طرفين متقابلين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schwer ein Satz war, direkt neben Gewicht und Wiederholungen. Zwei Skalen für dieselbe Einschätzung, von entgegengesetzten Enden gezählt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schwer ein Satz war, direkt neben Gewicht und Wiederholungen. Zwei Skalen für dieselbe Einschätzung, von entgegengesetzten Enden gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dura que fue una serie, junto al peso y las repeticiones. Dos escalas para lo mismo, contadas desde extremos opuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La difficulté d’une série, à côté du poids et des répétitions. Deux échelles pour la même appréciation, comptées par les deux bouts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेट कितना भारी था, वज़न और रेप्स के बगल में दर्ज। एक ही आकलन के लिए दो पैमाने, उलटे सिरों से गिने हुए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire volt nehéz egy sorozat, súly és ismétlésszám mellett rögzítve. Két skála ugyanarra a megítélésre, ellentétes végekről számolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto è stata dura una serie, accanto a peso e ripetizioni. Due scale per lo stesso giudizio, contate dai lati opposti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트가 얼마나 힘들었는지를 무게·횟수 옆에 함께 기록합니다. 같은 판단을 양쪽 끝에서 세는 두 가지 척도입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak ciężka była seria, zapisane obok ciężaru i powtórzeń. Dwie skale tej samej oceny, liczone z przeciwnych stron."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O quão dura foi uma série, ao lado do peso e das repetições. Duas escalas para o mesmo juízo, contadas de pontas opostas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quão dura foi uma série, ao lado do peso e das repetições. Duas escalas para o mesmo juízo, contadas de pontas opostas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько тяжёлым был подход — рядом с весом и повторениями. Две шкалы для одной и той же оценки, отсчитанные с разных концов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความหนักของแต่ละเซ็ต บันทึกคู่กับน้ำหนักและจำนวนครั้ง เป็นสองมาตรวัดของสิ่งเดียวกัน นับจากคนละด้าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir setin ne kadar zor geçtiği, ağırlık ve tekrarların yanında. Aynı değerlendirme için iki ölçek, ters uçlardan sayılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки важким був підхід — поруч із вагою і повтореннями. Дві шкали для однієї й тієї ж оцінки, відлічені з різних кінців."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "记录这一组有多吃力，就写在重量和次数旁边。同一个判断的两种标度，只是从相反的一端开始数。"
          }
        }
      }
    },
