    "Confirm the weight you worked with — your highest becomes the default next time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد الوزن الذي تدربت به — سيصبح أعلى وزن هو الافتراضي في المرة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige das Gewicht, mit dem du trainiert hast — dein höchstes wird beim nächsten Mal vorausgefüllt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige das Gewicht, mit dem du trainiert hast — dein höchstes wird beim nächsten Mal vorausgefüllt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el peso con el que trabajaste — el más alto será el predeterminado la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme le poids utilisé — le plus élevé devient la valeur par défaut la prochaine fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस वज़न से काम किया उसकी पुष्टि करें — सबसे ज़्यादा वज़न अगली बार डिफ़ॉल्ट बन जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erősítsd meg a súlyt, amivel dolgoztál — a legmagasabb lesz az alapértelmezett legközelebb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma il peso usato — il più alto diventa il predefinito la prossima volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용한 무게를 확인하세요 — 최고 무게가 다음번 기본값이 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź ciężar, z którym pracowałeś — najwyższy będzie domyślny następnym razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma o peso com que trabalhaste — o mais alto fica predefinido na próxima vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme o peso usado — o maior valor será o padrão na próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверди рабочий вес — наибольший станет значением по умолчанию в следующий раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันน้ำหนักที่ใช้ — น้ำหนักสูงสุดจะถูกตั้งเป็นค่าเริ่มต้นในครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştığın ağırlığı onayla — en yükseği bir dahaki sefer varsayılan olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверди робочу вагу — найбільша стане значенням за замовчуванням наступного разу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "确认你使用的重量——最高值将成为下次的默认值。"
          }
        }
      }
    },
