    "Any pending suggestion is discarded and scheduled reviews stop. Your Coach history stays, and you can turn it back on anytime.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُتخلص من أي اقتراح معلق وستتوقف المراجعات المجدولة. يبقى سجل المدرب، ويمكنك إعادة تشغيله في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Vorschläge werden verworfen und geplante Auswertungen stoppen. Dein Verlauf bleibt, und du kannst ihn jederzeit wieder einschalten."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Vorschläge werden verworfen und geplante Auswertungen stoppen. Dein Verlauf bleibt, und du kannst ihn jederzeit wieder einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descarta cualquier sugerencia pendiente y se detienen las revisiones programadas. Tu historial se conserva y puedes reactivarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute suggestion en attente est supprimée et les bilans programmés s’arrêtent. Votre historique reste et vous pouvez le réactiver quand vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबित सुझाव हट जाते हैं और निर्धारित समीक्षाएँ रुक जाती हैं। आपका इतिहास रहता है और आप कभी भी दोबारा चालू कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A függő javaslatok törlődnek, és az ütemezett áttekintések leállnak. Az Edző előzményei megmaradnak, és bármikor visszakapcsolhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni suggerimento in sospeso viene eliminato e le revisioni programmate si fermano. La cronologia resta e puoi riattivarlo quando vuoi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 제안은 삭제되고 예약된 리뷰는 중단됩니다. 기록은 남으며 언제든 다시 켤 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekujące propozycje zostaną odrzucone, a zaplanowane przeglądy się zatrzymają. Historia zostaje i możesz włączyć go z powrotem w każdej chwili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer sugestão pendente é descartada e as revisões agendadas param. O teu histórico fica e podes voltar a ligá-lo quando quiseres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer sugestão pendente é descartada e as revisões agendadas param. Seu histórico do Treinador fica, e você pode ligá-lo de novo quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающие предложения удаляются, запланированные разборы останавливаются. История сохраняется, включить обратно можно в любой момент."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อเสนอแนะที่รอดำเนินการจะถูกทิ้ง และการรีวิวตามกำหนดจะหยุดลง ประวัติโค้ชของคุณยังอยู่ และคุณเปิดกลับมาได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen öneriler silinir ve planlanmış değerlendirmeler durur. Geçmişin kalır, istediğin zaman yeniden açabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиції, що очікують, буде скасовано, заплановані розбори зупиняться. Історія зберігається, увімкнути назад можна будь-коли."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理的建议会被丢弃，定期复盘也会停止。你的教练历史会保留，随时可以重新开启。"
          }
        }
      }
    },
    "Anything else?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شيء آخر؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst noch etwas?"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst noch etwas?"
          }
        },
        "es": {
          "stringUnit": {
