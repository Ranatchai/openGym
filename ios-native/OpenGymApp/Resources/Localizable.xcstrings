    "There is no routine to review yet — build one with at least two exercises first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد روتين لمراجعته بعد — أنشئ روتينًا يضم تمرينين على الأقل أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine Routine zum Prüfen – lege zuerst eine mit mindestens zwei Übungen an."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine Routine zum Prüfen – lege zuerst eine mit mindestens zwei Übungen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
