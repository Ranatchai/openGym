          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy gyakorlatnál az összekapcsolás gombra, hogy szuperszettbe kösd a fölötte lévővel — így egymás után csinálod majd őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante di collegamento su un esercizio per farne un superset con quello sopra — li farai di seguito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동의 연결 버튼을 탭하면 위 운동과 슈퍼세트가 됩니다 — 연달아 수행하게 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij przycisku łączenia przy ćwiczeniu, aby połączyć je w superserię z tym powyżej — zrobisz je jedno po drugim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no botão de ligação num exercício para o juntar em supersérie com o de cima — vais fazê-los seguidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de vínculo de um exercício para combiná-lo em um superset com o exercício acima — eles serão feitos em sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми кнопку связи у упражнения, чтобы объединить его в суперсет с тем, что выше — сделаешь их подряд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มเชื่อมที่ท่าออกกำลังกายเพื่อทำเป็นซูเปอร์เซ็ตกับท่าด้านบน — จะทำต่อเนื่องกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir egzersizde bağlama düğmesine dokunarak üsttekiyle süperset yap — arka arkaya yaparsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни кнопку зв’язку у вправи, щоб об’єднати її в суперсет із тією, що вище — виконаєш їх підряд."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击动作上的链接按钮，可与上面的动作组成超级组——你将连续完成它们。"
          }
        }
      }
    },
