    "Every exercise done — great work. Finish up, or keep going and add another exercise.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنجزت جميع التمارين. أنهِ التمرين، أو واصل وأضف تمرينًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Übungen geschafft — stark! Schließe ab oder mach weiter und füge eine Übung hinzu."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Übungen geschafft — stark! Schliesse ab oder mach weiter und füge eine Übung hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ejercicios hechos — ¡buen trabajo! Termina, o sigue y añade otro ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les exercices faits — bravo ! Termine, ou continue et ajoute un exercice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारे व्यायाम पूरे — बढ़िया काम! समाप्त करें, या जारी रखें और एक और व्यायाम जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gyakorlat kész — remek munka! Fejezd be, vagy folytasd, és adj hozzá egy újabb gyakorlatot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli esercizi fatti — ottimo lavoro! Concludi, o continua e aggiungi un altro esercizio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 운동 완료 — 수고했어요! 마무리하거나, 계속해서 운동을 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie ćwiczenia zrobione — świetna robota! Zakończ albo kontynuuj i dodaj kolejne ćwiczenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os exercícios feitos — bom trabalho! Termina, ou continua e adiciona outro exercício."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os exercícios concluídos — ótimo trabalho! Finalize ou continue e adicione outro exercício."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все упражнения выполнены — отличная работа! Завершай или продолжай и добавь ещё упражнение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
