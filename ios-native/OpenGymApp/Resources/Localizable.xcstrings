        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telemóvel já não está emparelhado com o teu servidor. As tuas alterações ficam aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular não está mais pareado com seu servidor. Suas alterações ficam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон больше не сопряжён с вашим сервером. Ваши изменения остаются здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้ไม่ได้จับคู่กับเซิร์ฟเวอร์ของคุณแล้ว การเปลี่ยนแปลงของคุณยังเก็บไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon artık sunucunla eşleşmiş değil. Değişikliklerin burada kalıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей телефон більше не спарено з твоїм сервером. Твої зміни збережено тут."
