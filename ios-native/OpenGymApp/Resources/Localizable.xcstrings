          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima versione verrà scaricata e si aprirà il programma di installazione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전이 다운로드되고 설치 프로그램이 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsza wersja zostanie pobrana i otworzy się instalator."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão mais recente será transferida e o instalador será aberto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão mais recente será baixada e o instalador será aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя версия будет загружена и откроется установщик."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันล่าสุดจะถูกดาวน์โหลดและตัวติดตั้งจะเปิดขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son sürüm indirilecek ve yükleyici açılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажиться остання версія і відкриється встановлювач."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将下载最新版本并打开安装程序。"
          }
        }
      }
    },
    "The machine or sled itself, before any plate goes on. 0 if it is all plates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وزن الجهاز أو السليد نفسه قبل وضع أي قرص. 0 إذا كان الوزن كله أقراصًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine oder der Schlitten selbst, bevor eine Scheibe aufgelegt wird. 0, wenn alles Scheiben sind."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine oder der Schlitten selbst, bevor eine Scheibe aufgelegt wird. 0, wenn alles Scheiben sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propia máquina o trineo, antes de poner ningún disco. 0 si todo son discos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine ou le traîneau lui-même, avant d'ajouter le moindre disque. 0 si tout est en disques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मशीन या स्लेड का अपना वज़न, प्लेट लगाने से पहले। अगर सब कुछ प्लेट ही है तो 0।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maga a gép vagy szán, mielőtt bármilyen tárcsa felkerülne rá. 0, ha az egész tárcsákból áll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina o la slitta stessa, prima di aggiungere qualsiasi disco. 0 se è tutto dischi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이트를 끼우기 전, 머신이나 슬레드 자체의 무게입니다. 전부 플레이트라면 0으로 두세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama maszyna lub sanie, zanim dołożysz jakikolwiek talerz. 0, jeśli to same talerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A própria máquina ou o trenó, antes de qualquer disco. 0 se for tudo discos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A própria máquina ou o trenó, antes de qualquer anilha. 0 se for tudo anilha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам тренажёр или сани, до того как навешен хоть один блин. 0, если это одни блины."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเครื่องหรือสเลดเอง ก่อนใส่แผ่นน้ำหนักใด ๆ ใส่ 0 ถ้าทั้งหมดเป็นแผ่นน้ำหนัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir disk takılmadan önceki makine veya kızağın kendi ağırlığı. Tamamı diskse 0 yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам тренажер чи сани, ще до першого блина. 0, якщо тут лише блини."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "机器或雪橇本身的重量，装上任何杠铃片之前。如果全是杠铃片，就填 0。"
          }
        }
      }
    },
    "The main lower-body driver — where most of the strength comes from.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحرك الرئيسي للجزء السفلي — ومنه تأتي معظم القوة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptantrieb für den Unterkörper — hier kommt der Großteil der Kraft her."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptantrieb für den Unterkörper — hier kommt der Grossteil der Kraft her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor principal del tren inferior — de aquí sale la mayor parte de la fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur principal du bas du corps — c’est de là que vient l’essentiel de la force."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निचले शरीर का मुख्य मूवमेंट — ज़्यादातर ताकत यहीं से आती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alsótest fő hajtóereje — innen jön az erő nagy része."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore principale della parte bassa — da qui arriva la maggior parte della forza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하체의 핵심 운동 — 힘의 대부분이 여기서 나와요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Główny motor dolnej części ciała — stąd bierze się większość siły."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor principal da parte inferior do corpo — é daqui que vem a maior parte da força."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor principal da parte inferior do corpo — é daqui que vem a maior parte da força."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главное движение для низа тела — основной источник силы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ท่าหลักของร่างกายส่วนล่าง — แรงส่วนใหญ่มาจากตรงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt vücudun ana itici gücü — kuvvetin çoğu buradan gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Головний рух для низу тіла — основне джерело сили."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下肢的主力动作——大部分力量来自这里。"
          }
        }
      }
    },
    "The new plan will be scheduled on {0}. Existing routines are kept — only those days of the weekly plan change.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُجدول الخطة الجديدة على %1$@. تبقى الروتينات الحالية — تتغير فقط تلك الأيام من الخطة الأسبوعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Plan kommt auf %1$@. Deine Routinen bleiben alle erhalten — nur diese Tage im Wochenplan ändern sich."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Plan kommt auf %1$@. Deine Routinen bleiben alle erhalten — nur diese Tage im Wochenplan ändern sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new plan will be scheduled on %1$@. Existing routines are kept — only those days of the weekly plan change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo plan se programará en %1$@. Tus rutinas se conservan — solo cambian esos días del plan semanal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau plan sera placé sur %1$@. Tes routines sont toutes conservées — seuls ces jours du plan hebdo changent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया प्लान %1$@ पर लगेगा। आपकी सभी रूटीन बनी रहेंगी — साप्ताहिक प्लान में सिर्फ़ ये दिन बदलेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új terv ide kerül: %1$@. A meglévő rutinjaid megmaradnak — a heti tervben csak ezek a napok változnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo piano andrà su %1$@. Le tue routine restano tutte — cambiano solo quei giorni del piano settimanale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 계획은 %1$@에 배치됩니다. 기존 루틴은 모두 유지되고 주간 계획에서 해당 요일만 바뀝니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy plan trafi na %1$@. Twoje plany treningowe zostają — zmienią się tylko te dni w planie tygodnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo plano fica em %1$@. As tuas rotinas mantêm-se todas — só esses dias do plano semanal mudam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo plano fica em %1$@. Suas rotinas são todas mantidas — só esses dias do plano semanal mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый план встанет на %1$@. Все твои программы сохранятся — в плане недели изменятся только эти дни."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนใหม่จะลงใน %1$@ รูทีนเดิมของคุณยังอยู่ครบ — เปลี่ยนเฉพาะวันเหล่านี้ในแผนรายสัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni plan %1$@ günlerine yerleşecek. Mevcut rutinlerin duruyor — haftalık planda yalnızca bu günler değişiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новий план стане на %1$@. Наявні програми збережуться — зміняться лише ці дні тижневого плану."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "新计划将安排在%1$@。你现有的训练日都会保留——每周计划中只有这几天会改变。"
          }
        }
      }
    },
    "The next regular target continues from the last included workout.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر الهدف المنتظم التالي من آخر تمرين مدرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das nächste reguläre Ziel setzt beim letzten einbezogenen Workout fort."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Das nächste reguläre Ziel setzt beim letzten einbezogenen Workout fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El siguiente objetivo normal continúa desde el último entrenamiento incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain objectif normal continue à partir de la dernière séance incluse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगला सामान्य लक्ष्य अंतिम शामिल वर्कआउट से जारी रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő normál cél az utolsó beszámított edzéstől folytatódik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo obiettivo normale continua dall’ultimo allenamento incluso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 일반 목표는 마지막으로 포함된 운동에서 이어집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następny zwykły cel bazuje na ostatnim uwzględnionym treningu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo objetivo normal continua a partir do último treino incluído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima meta normal continua a partir do último treino incluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующая обычная цель продолжает прогрессию от последней учтённой тренировки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายปกติครั้งถัดไปจะต่อจากการฝึกล่าสุดที่นับรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki normal hedef, dahil edilen son antrenmandan devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступна звичайна ціль продовжує прогресію від останнього врахованого тренування."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个常规目标从上一次计入的训练继续。"
          }
        }
      }
    },
    "The reps you logged last time in that routine, carried over.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنقل التكرارات التي سجّلتها آخر مرة في ذلك الروتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederholungen, die du zuletzt in dieser Routine eingetragen hast, werden übernommen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederholungen, die du zuletzt in dieser Routine eingetragen hast, werden übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantienen las repeticiones que registraste la última vez en esa rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les répétitions notées la dernière fois dans cette routine sont reprises."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस रूटीन में पिछली बार दर्ज किए गए रेप्स आगे ले जाए जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az abban a rutinban legutóbb rögzített ismétlések kerülnek át."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono riprese le ripetizioni registrate l’ultima volta in quella routine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 루틴에서 지난번에 기록한 횟수를 그대로 가져옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszone są powtórzenia zapisane ostatnio w tym planie treningowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantêm-se as repetições que registaste da última vez nessa rotina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São mantidas as repetições que você registrou da última vez nessa rotina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторения, записанные в прошлый раз в этой программе, переносятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้จำนวนครั้งที่บันทึกไว้ครั้งก่อนในรูทีนนั้นต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O rutinde geçen sefer kaydettiğin tekrarlar aynen aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторення, записані минулого разу в цій програмі, переносяться."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "沿用你上次在该训练日记录的次数。"
          }
        }
      }
    },
    "The routine’s sets and reps. Your history decides the weight.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعات الروتين وتكراراته. سجلّك يحدد الوزن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze und Wiederholungen der Routine. Das Gewicht ergibt sich aus deinem Verlauf."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze und Wiederholungen der Routine. Das Gewicht ergibt sich aus deinem Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series y repeticiones de la rutina. Tu historial decide el peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries et répétitions de la routine. Ton historique décide du poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूटीन के सेट और रेप्स। वज़न आपका इतिहास तय करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rutin sorozatai és ismétlései. A súlyt az előzményeid döntik el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie e ripetizioni della routine. Il peso lo decide il tuo storico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴의 세트와 횟수. 무게는 기록에 따라 정해집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie i powtórzenia z planu treningowego. Ciężar wynika z twojej historii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries e repetições da rotina. O teu histórico decide o peso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries e repetições da rotina. Seu histórico decide o peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходы и повторения из программы. Вес определяет ваша история."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเซ็ตและครั้งตามรูทีน ส่วนน้ำหนักขึ้นอยู่กับประวัติของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutinin setleri ve tekrarları. Ağırlığı geçmişin belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходи й повторення з програми. Вагу визначає твоя історія."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按训练日的组数和次数，重量由你的历史记录决定。"
          }
        }
      }
    },
    "The same patterns, different variations — enough overlap to progress, enough difference to stay fresh.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأنماط نفسها بتنويعات مختلفة — تداخل يكفي للتقدم، واختلاف يكفي لتبقى متجددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Bewegungsmuster, andere Varianten — genug Überschneidung für Fortschritt, genug Abwechslung, damit es frisch bleibt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Bewegungsmuster, andere Varianten — genug Überschneidung für Fortschritt, genug Abwechslung, damit es frisch bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mismos patrones, otras variantes — suficiente solapamiento para progresar, suficiente diferencia para mantenerlo fresco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mêmes mouvements, d’autres variantes — assez de recoupement pour progresser, assez de différence pour rester frais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वही पैटर्न, अलग वेरिएशन — प्रगति के लिए पर्याप्त ओवरलैप, ताज़गी के लिए पर्याप्त अंतर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanazok a mozgásminták, más változatok — elég átfedés a fejlődéshez, elég különbség, hogy friss maradjon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stessi schemi, varianti diverse — abbastanza sovrapposizione per progredire, abbastanza differenza per restare freschi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 패턴, 다른 변형 — 성장하기에 충분히 겹치고, 지루하지 않을 만큼 달라요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te same wzorce, inne warianty — wystarczająco wspólnego, by robić postępy, wystarczająco różnic, by nie było monotonnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mesmos padrões, variações diferentes — sobreposição suficiente para progredir, diferença suficiente para se manter fresco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mesmos padrões, variações diferentes — sobreposição suficiente para progredir, diferença suficiente para se manter fresco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Те же движения в других вариациях — пересечений хватает для прогресса, различий — чтобы не приедалось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบเดิม แต่ต่างรูปแบบย่อย — ทับซ้อนพอให้ก้าวหน้า ต่างพอให้ไม่จำเจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı kalıplar, farklı varyasyonlar — ilerlemek için yeterli örtüşme, taze kalmak için yeterli fark."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ті самі рухи в інших варіаціях — перетинів вистачає для прогресу, відмінностей — щоб не набридло."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的模式，不同的变式——足够的重叠来进步，足够的差异来保持新鲜感。"
          }
        }
      }
    },
    "The screen stays on while a workout is running, so you don’t have to unlock your phone between sets.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الشاشة مضاءة أثناء تشغيل التمرين، حتى لا تضطر إلى فتح قفل هاتفك بين المجموعات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm bleibt an, solange ein Workout läuft — so musst du zwischen den Sätzen nicht entsperren."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm bleibt an, solange ein Workout läuft — so musst du zwischen den Sätzen nicht entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se mantiene encendida mientras hay un entrenamiento en curso, así no tienes que desbloquear el móvil entre series."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran reste allumé tant qu’une séance est en cours, pas besoin de déverrouiller ton téléphone entre les séries."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट चलने के दौरान स्क्रीन चालू रहती है, ताकि सेट के बीच फ़ोन अनलॉक न करना पड़े।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyő edzés közben bekapcsolva marad, így sorozatok között nem kell feloldanod a telefonod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo resta acceso mentre un allenamento è in corso, così non devi sbloccare il telefono tra una serie e l’altra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동이 진행되는 동안 화면이 켜져 있어 세트 사이에 잠금을 해제할 필요가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran pozostaje włączony w trakcie treningu, więc nie musisz odblokowywać telefonu między seriami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã fica ligado enquanto há um treino a decorrer, para não teres de desbloquear o telemóvel entre séries."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela permanece ligada durante o treino, para você não precisar desbloquear o celular entre as séries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран не гаснет, пока идёт тренировка, — не нужно разблокировать телефон между подходами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จอจะไม่ปิดขณะออกกำลังกาย จะได้ไม่ต้องปลดล็อกโทรศัพท์ระหว่างเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman sürerken ekran açık kalır, böylece setler arasında telefonunu açmak zorunda kalmazsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран не гасне, поки триває тренування, — не потрібно розблоковувати телефон між підходами."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "训练进行时屏幕保持常亮，组间无需再解锁手机。"
          }
        }
      }
    },
