    "{0} sets bring an {1} with them — switch on Effort per set in Settings to see it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعات %1$@ تحمل معها %2$@ — فعّل «الجهد لكل مجموعة» في الإعدادات لعرضها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Sätze bringen ein %2$@ mit — schalte in den Einstellungen „Anstrengung pro Satz“ ein, um es zu sehen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Sätze bringen ein %2$@ mit — schalte in den Einstellungen „Anstrengung pro Satz“ ein, um es zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sets bring an %2$@ with them — switch on Effort per set in Settings to see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ series traen un %2$@ — activa «Esfuerzo por serie» en Ajustes para verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ séries arrivent avec un %2$@ — active « Effort par série » dans les réglages pour le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ सेट अपने साथ %2$@ लाते हैं — इसे देखने के लिए सेटिंग्स में “प्रति सेट मेहनत” चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sorozat %2$@ hoz magával — kapcsold be a Megerőltetés sorozatonként opciót a Beállításokban, hogy lásd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ serie portano con sé un %2$@ — attiva «Sforzo per serie» nelle impostazioni per vederlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@개 세트에 %2$@이(가) 함께 들어 있습니다 — 설정에서 ‘세트당 강도’를 켜면 보입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ serii ma zapisane %2$@ — włącz „Wysiłek w serii” w ustawieniach, aby to zobaczyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ séries trazem um %2$@ — liga «Esforço por série» nas definições para o veres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ séries incluem um %2$@ — ative “Esforço por série” nas Configurações para exibi-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ подходов несут с собой %2$@ — включите «Усилие в подходе» в настройках, чтобы увидеть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เซ็ตมาพร้อม %2$@ — เปิด “ความหนักต่อเซ็ต” ในตั้งค่าเพื่อดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ set beraberinde bir %2$@ getiriyor — görmek için Ayarlar’da «Set başına efor» seçeneğini aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ підходів несуть із собою %2$@ — увімкни «Зусилля в підході» в налаштуваннях, щоб побачити."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 组自带 %2$@——在设置中打开“每组强度”即可看到。"
          }
        }
      }
    },
