    "Its workouts do not count toward progression. They still show in history and statistics.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحتسب تدريباته في التقدم، وتبقى ظاهرة في السجل والإحصائيات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Workouts zählen nicht für die Progression. Sie bleiben im Verlauf und in den Statistiken."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Workouts zählen nicht für die Progression. Sie bleiben im Verlauf und in den Statistiken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus entrenamientos no cuentan para la progresión. Siguen apareciendo en el historial y las estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses séances ne comptent pas pour la progression. Elles restent dans l’historique et les statistiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके वर्कआउट प्रोग्रेशन में नहीं गिने जाते। वे इतिहास और आँकड़ों में दिखते रहते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzései nem számítanak bele a progresszióba. Az előzményekben és a statisztikában továbbra is megjelennek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi allenamenti non contano per la progressione. Restano nella cronologia e nelle statistiche."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루틴의 운동은 점진적 증가에 반영되지 않습니다. 기록과 통계에는 계속 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treningi z tego planu nie wliczają się do progresji. Nadal są widoczne w historii i statystykach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus treinos não contam para a progressão. Continuam a aparecer no histórico e nas estatísticas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os treinos dela não contam para a progressão. Continuam aparecendo no histórico e nas estatísticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её тренировки не учитываются в прогрессии. Они по-прежнему видны в истории и статистике."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฝึกของรูทีนนี้ไม่นับรวมในการเพิ่มระดับ แต่ยังแสดงในประวัติและสถิติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanları ilerlemeye sayılmaz. Geçmişte ve istatistiklerde görünmeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її тренування не враховуються в прогресії. В історії та статистиці вони все одно є."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它的训练不计入进阶，但仍会显示在历史记录和统计中。"
          }
        }
      }
    },
