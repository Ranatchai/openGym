          "stringUnit": {
            "state": "translated",
            "value": "此手机上尚未设置教练。"
          }
        }
      }
    },
    "The Coach needs your go-ahead first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرب يحتاج موافقتك أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach braucht zuerst dein Okay."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach braucht zuerst dein Okay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador necesita primero tu permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
