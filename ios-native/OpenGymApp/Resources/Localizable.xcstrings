            "value": "Dein schwerster Satz der Übung, aus allen Trainings."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein schwerster Satz der Übung, aus allen Trainings."
          }
        },
        "es": {
