    "Injuries, joints that complain, movements you cannot do, or practical limits like training at 6am in a flat.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصابات، مفاصل تؤلمك، حركات لا تستطيع أداءها، أو قيود عملية مثل التدريب في السادسة صباحًا داخل شقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verletzungen, Gelenke, die zicken, Bewegungen, die nicht gehen, oder praktische Grenzen wie Training um 6 Uhr in einer Wohnung."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Verletzungen, Gelenke, die zicken, Bewegungen, die nicht gehen, oder praktische Grenzen wie Training um 6 Uhr in einer Wohnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesiones, articulaciones molestas, movimientos que no puedes hacer o límites prácticos como entrenar a las 6 de la mañana en un piso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blessures, articulations qui protestent, mouvements impossibles, ou contraintes pratiques comme s’entraîner à 6h en appartement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चोटें, तकलीफ़ देने वाले जोड़, जो मूवमेंट आप नहीं कर सकते, या व्यावहारिक सीमाएँ — जैसे फ़्लैट में सुबह 6 बजे ट्रेनिंग।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sérülések, panaszkodó ízületek, mozdulatok, amelyeket nem tudsz elvégezni, vagy gyakorlati korlátok, mint a hajnali 6-os edzés egy lakásban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Infortuni, articolazioni che protestano, movimenti che non puoi fare o limiti pratici come allenarti alle 6 in appartamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부상, 불편한 관절, 할 수 없는 동작, 또는 아파트에서 새벽 6시에 훈련하는 것 같은 현실적 제약."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontuzje, bolące stawy, ruchy, których nie możesz wykonać, albo ograniczenia praktyczne — np. trening o 6 rano w mieszkaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesões, articulações que se queixam, movimentos que não consegues fazer ou limites práticos como treinar às 6h num apartamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesões, articulações que reclamam, movimentos que você não consegue fazer ou limites práticos como treinar às 6h em um apartamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Травмы, ноющие суставы, недоступные движения или бытовые ограничения — например, тренировка в 6 утра в квартире."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาการบาดเจ็บ ข้อต่อที่มีปัญหา ท่าที่ทำไม่ได้ หรือข้อจำกัดในชีวิตจริง เช่น ฝึกตอนตีหกในอพาร์ตเมนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakatlıklar, rahatsız eden eklemler, yapamadığın hareketler ya da sabah 6’da apartmanda antrenman gibi pratik kısıtlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Травми, суглоби, що ниють, недоступні рухи або побутові обмеження — наприклад, тренування о 6 ранку в квартирі."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "伤病、不舒服的关节、做不了的动作，或是现实限制——比如清晨六点在公寓里训练。"
          }
        }
      }
    },
