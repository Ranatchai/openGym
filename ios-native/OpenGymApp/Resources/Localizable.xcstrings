    "Releases are checked on gitlab.com. The download is verified against its checksum before the installer opens.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتحقق من الإصدارات على gitlab.com. ويُتحقق من التنزيل مقابل بصمته قبل فتح المثبّت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Releases werden auf gitlab.com geprüft. Der Download wird vor dem Öffnen des Installers gegen seine Prüfsumme verifiziert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Releases werden auf gitlab.com geprüft. Der Download wird vor dem Öffnen des Installers gegen seine Prüfsumme verifiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones se comprueban en gitlab.com. La descarga se verifica con su suma de comprobación antes de abrir el instalador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions sont vérifiées sur gitlab.com. Le téléchargement est contrôlé avec sa somme de contrôle avant l’ouverture de l’installateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ gitlab.com पर जाँची जाती हैं। इंस्टॉलर खुलने से पहले डाउनलोड की चेकसम से पुष्टि होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiadásokat a gitlab.com-on ellenőrizzük. A letöltést a telepítő megnyitása előtt az ellenőrzőösszeggel vetjük össze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le release vengono controllate su gitlab.com. Il download è verificato con il suo checksum prima di aprire l’installer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리스는 gitlab.com에서 확인합니다. 설치 프로그램이 열리기 전에 다운로드의 체크섬을 검증합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydania są sprawdzane na gitlab.com. Pobrany plik jest weryfikowany sumą kontrolną przed otwarciem instalatora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões são verificadas em gitlab.com. A transferência é confirmada pela soma de verificação antes de abrir o instalador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões são verificadas em gitlab.com. A transferência é confirmada pela soma de verificação antes de abrir o instalador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Релизы проверяются на gitlab.com. Перед запуском установщика загрузка сверяется с контрольной суммой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบรุ่นจาก gitlab.com ไฟล์ที่ดาวน์โหลดจะถูกตรวจ checksum ก่อนเปิดตัวติดตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürümler gitlab.com üzerinde denetlenir. İndirme, yükleyici açılmadan önce sağlama toplamıyla doğrulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Релізи перевіряються на gitlab.com. Перед відкриттям встановлювача завантаження звіряється з контрольною сумою."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "版本在 gitlab.com 上检查。安装程序打开前会校验下载文件的校验和。"
          }
        }
      }
    },
