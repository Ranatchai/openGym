    "No weight logged last time — enter what you lift and progression takes it from there.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسجَّل وزن في المرة الماضية — أدخل الوزن الذي ترفعه وسيتابع التقدم من هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Mal kein Gewicht eingetragen — trag ein, was du bewegst, dann übernimmt die Progression."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Mal kein Gewicht eingetragen — trag ein, was du bewegst, dann übernimmt die Progression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última vez no se registró peso: introduce lo que levantas y la progresión seguirá desde ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun poids noté la dernière fois — entre ce que tu soulèves et la progression prend le relais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार कोई वज़न दर्ज नहीं हुआ — जितना उठाते हैं उतना दर्ज करें, प्रगति वहीं से आगे बढ़ेगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legutóbb nem volt súly rögzítve — add meg, mennyit emelsz, és onnan halad tovább a progresszió."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun peso registrato l’ultima volta: inserisci quanto sollevi e la progressione riparte da lì."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번에 무게가 기록되지 않았습니다 — 드는 무게를 입력하면 거기서부터 진행합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio nie zapisano ciężaru — wpisz, ile podnosisz, a progresja ruszy od tego miejsca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum peso registado da última vez — introduz o que levantas e a progressão segue a partir daí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum peso registrado na última vez — informe quanto você levanta e a progressão segue a partir daí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз вес не был записан — укажите, с каким весом работаете, и прогрессия продолжится оттуда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครั้งก่อนไม่ได้บันทึกน้ำหนัก — กรอกน้ำหนักที่คุณยก แล้วการเพิ่มน้ำหนักจะเริ่มจากตรงนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen sefer ağırlık kaydedilmedi — kaldırdığın ağırlığı gir, ilerleme oradan devam etsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого разу вагу не записано — вкажи, з якою вагою працюєш, і прогресія продовжить звідти."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "上次没有记录重量——填上你实际举的重量，渐进就从那里开始。"
          }
        }
      }
    },
