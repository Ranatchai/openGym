    "e.g. “I want visible arms progress by spring”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلًا «أريد تقدمًا واضحًا في الذراعين بحلول الربيع»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „bis zum Frühling sichtbare Fortschritte an den Armen“"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „bis zum Frühling sichtbare Fortschritte an den Armen“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. «quiero ver progreso en los brazos para la primavera»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. « je veux des bras visiblement plus développés d’ici le printemps »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे “वसंत तक बाहों में साफ़ फ़र्क़ चाहिए”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
