    "Slide or tap to set your weight — tracked before every workout so your curve stays honest.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر أو اضغط لتحديد وزنك — يُسجَّل قبل كل تمرين للحفاظ على دقة المنحنى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieben oder tippen, um dein Gewicht zu setzen — vor jedem Training erfasst, damit deine Kurve ehrlich bleibt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieben oder tippen, um dein Gewicht zu setzen — vor jedem Training erfasst, damit deine Kurve ehrlich bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza o toca para fijar tu peso — se registra antes de cada entrenamiento para que tu curva sea honesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse ou tape pour régler ton poids — noté avant chaque séance pour que ta courbe reste honnête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़न सेट करने के लिए स्लाइड या टैप करें — हर वर्कआउट से पहले दर्ज होता है ताकि आपका ग्राफ़ सही रहे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csúsztasd vagy koppints a súlyod beállításához — minden edzés előtt rögzítjük, hogy a görbéd valós maradjon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri o tocca per impostare il peso — registrato prima di ogni allenamento così la tua curva resta onesta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이드하거나 탭해서 체중을 설정하세요 — 매 운동 전에 기록되어 그래프가 정직하게 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń lub dotknij, aby ustawić wagę — zapisywana przed każdym treningiem, żeby krzywa była uczciwa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza ou toca para definir o teu peso — registado antes de cada treino para a tua curva ser honesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize ou toque para informar seu peso — ele é registrado antes de cada treino para manter a curva precisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвинь или коснись, чтобы указать вес — он записывается перед каждой тренировкой, чтобы кривая была честной."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนหรือแตะเพื่อตั้งน้ำหนัก — บันทึกก่อนออกกำลังกายทุกครั้งเพื่อให้กราฟตรงตามจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilonu ayarlamak için kaydır veya dokun — eğrin dürüst kalsın diye her antrenmandan önce kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посунь або натисни, щоб вказати вагу — записується перед кожним тренуванням, щоб крива лишалась чесною."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动或点按设置体重——每次训练前记录，让你的曲线保持真实。"
          }
        }
      }
    },
