    "This video may not play on every device — MP4 (H.264) plays everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا يعمل هذا الفيديو على كل الأجهزة — صيغة MP4 (H.264) تعمل في كل مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video läuft womöglich nicht auf jedem Gerät — MP4 (H.264) läuft überall."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video läuft womöglich nicht auf jedem Gerät — MP4 (H.264) läuft überall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que este vídeo no se reproduzca en todos los dispositivos — MP4 (H.264) funciona en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo risque de ne pas se lire sur tous les appareils — le MP4 (H.264) se lit partout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो शायद हर डिवाइस पर न चले — MP4 (H.264) हर जगह चलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehet, hogy ez a videó nem minden eszközön játszható le — az MP4 (H.264) mindenhol működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo video potrebbe non funzionare su tutti i dispositivi — l’MP4 (H.264) funziona ovunque."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상은 일부 기기에서 재생되지 않을 수 있습니다 — MP4(H.264)는 어디서나 재생됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten film może nie działać na każdym urządzeniu — MP4 (H.264) działa wszędzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo pode não reproduzir em todos os dispositivos — MP4 (H.264) funciona em todo o lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo pode não rodar em todos os dispositivos — MP4 (H.264) funciona em qualquer lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это видео может воспроизводиться не на всех устройствах — MP4 (H.264) работает везде."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอนี้อาจเล่นไม่ได้ในทุกอุปกรณ์ — MP4 (H.264) เล่นได้ทุกที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video her cihazda oynamayabilir — MP4 (H.264) her yerde oynar."
