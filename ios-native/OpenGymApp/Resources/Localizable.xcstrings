    "Strength shows retained muscle strength. Train again to reset it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّر مقدار القوة المتبقية في العضلة. درّبها مرة أخرى لإعادة ضبطها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kraft zeigt, wie viel Muskelkraft erhalten ist. Trainiere erneut, um sie zurückzusetzen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kraft zeigt, wie viel Muskelkraft erhalten ist. Trainiere erneut, um sie zurückzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuerza muestra cuánta fuerza muscular se conserva. Vuelve a entrenar para restablecerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La force indique combien de force musculaire est conservée. Entraîne-toi à nouveau pour la réinitialiser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शक्ति बताती है कि मांसपेशियों की कितनी ताकत बनी हुई है। इसे रीसेट करने के लिए फिर से ट्रेन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az erő azt mutatja, mennyi izomerő maradt meg. Edz újra, hogy visszaálljon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forza mostra quanta forza muscolare hai mantenuto. Allenati di nuovo per reimpostarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근력은 근육에 남아 있는 힘을 보여줍니다. 다시 운동하면 값이 초기화됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siła pokazuje, ile siły mięśniowej pozostało. Ponowny trening przywraca jej poziom wyjściowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A força mostra quanta força muscular se mantém. Treina novamente para repor o valor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A força mostra quanto da força muscular foi mantida. Treine novamente para redefinir o valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сила показывает, сколько мышечной силы сохранилось. Повторная тренировка сбрасывает это значение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความแข็งแรงแสดงกำลังกล้ามเนื้อที่ยังคงเหลืออยู่ ฝึกอีกครั้งเพื่อรีเซ็ตค่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvvet, kas gücünün ne kadarının korunduğunu gösterir. Yeniden çalışarak değeri sıfırlayabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сила показує, скільки м’язової сили збереглося. Повторне тренування скидає це значення."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "力量显示肌肉力量保留了多少。再次训练即可重置。"
          }
        }
      }
    },
