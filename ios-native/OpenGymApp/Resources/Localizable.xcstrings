    "Missed reps last time — same weight again ({0} of {1} to go).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكمل التكرارات المطلوبة في المرة السابقة — نفس الوزن (%1$@ من %2$@ متبقٍ)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Mal Wiederholungen verfehlt — dasselbe Gewicht noch einmal (noch %1$@ von %2$@)."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Mal Wiederholungen verfehlt — dasselbe Gewicht noch einmal (noch %1$@ von %2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed reps last time — same weight again (%1$@ of %2$@ to go)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallaste repeticiones la última vez: el mismo peso otra vez (quedan %1$@ de %2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétitions manquées la dernière fois — même poids à nouveau (%1$@ sur %2$@ restants)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार रेप्स चूके — वही वज़न दोबारा (%2$@ में से %1$@ बाकी)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legutóbb hiányoztak ismétlések — ugyanaz a súly megint (még %1$@ van hátra %2$@-ból)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizioni mancate l’ultima volta: stesso peso ancora (%1$@ di %2$@ rimasti)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번 목표 횟수 미달 — 같은 무게로 한 번 더 (%2$@회 중 %1$@회 남음)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio nieudane powtórzenia — ten sam ciężar jeszcze raz (zostało %1$@ z %2$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falhaste repetições da última vez — o mesmo peso outra vez (faltam %1$@ de %2$@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não concluiu as repetições na última vez — mantenha o mesmo peso (faltam %1$@ de %2$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз повторения не дались — тот же вес ещё раз (осталось %1$@ из %2$@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครั้งก่อนพลาดจำนวนครั้ง — น้ำหนักเดิมอีกครั้ง (เหลืออีก %1$@ จาก %2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen sefer tekrarlar eksikti — aynı ağırlık bir kez daha (%2$@ denemeden %1$@ kaldı)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого разу повторення не далися — та сама вага ще раз (лишилося %1$@ з %2$@)."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "上次次数未完成——再用同样的重量（还剩 %1$@/%2$@ 次）。"
          }
        }
      }
    },
    "Missed reps {0} sessions running — reset to {1} {2} and work back up.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكمل التكرارات المطلوبة في %1$@ جلسات متتالية — خفّض الوزن إلى %2$@ %3$@ ثم عاود التدرّج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einheiten in Folge Wiederholungen verfehlt — zurück auf %2$@ %3$@ und wieder hocharbeiten."
