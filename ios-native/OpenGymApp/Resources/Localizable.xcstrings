    "Three sessions, the whole body each time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاث جلسات، الجسم كامل في كل مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Einheiten, jedes Mal der ganze Körper."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Einheiten, jedes Mal der ganze Körper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres sesiones, todo el cuerpo en cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois séances, tout le corps à chaque fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन सेशन, हर बार पूरा शरीर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Három edzés, mindegyiken az egész test."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre sedute, ogni volta tutto il corpo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
