    "Sets the pace of progression, and how much the Coach assumes you know.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد وتيرة التقدم، ومدى ما يفترضه المدرب من معرفتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmt das Tempo der Progression und wie viel der Coach voraussetzt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmt das Tempo der Progression und wie viel der Coach voraussetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el ritmo de progresión y cuánto asume el entrenador que ya sabes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine le rythme de progression, et ce que le coach suppose que tu sais déjà."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रगति की गति और कोच आपसे कितनी जानकारी मानकर चलेगा, यह तय करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez határozza meg a progresszió tempóját, és azt, mennyit feltételez az Edző a tudásodról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina il ritmo di progressione e quanto il Coach dà per scontato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 속도와 코치가 당신이 얼마나 알고 있다고 가정할지를 정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustala tempo progresji i to, ile trener zakłada, że już wiesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o ritmo da progressão e o que o Treinador assume que já sabes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o ritmo da progressão e o quanto o Treinador assume que você já sabe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт темп прогрессии и то, сколько тренер считает известным вам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดความเร็วของการเพิ่มความก้าวหน้า และระดับที่โค้ชคาดว่าคุณรู้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme hızını ve koçun ne kadar bildiğini varsayacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задає темп прогресії і те, скільки тренер вважає тобі відомим."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "决定进阶的节奏，以及教练默认你已掌握多少。"
          }
        }
      }
    },
