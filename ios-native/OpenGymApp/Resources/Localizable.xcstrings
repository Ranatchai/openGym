            "value": "โมเดลในเครื่องอาจใช้เวลานานกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bir model daha uzun sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна модель може працювати довше."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型可能需要更长时间。"
          }
        }
      }
    },
    "A one-time code lets your phone or another computer sign in with a passkey of its own.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
