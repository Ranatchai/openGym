        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — a módosításaid ezen az eszközön vannak mentve, és szinkronizálódnak, amint újra online leszel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — le tue modifiche sono salvate su questo dispositivo e verranno sincronizzate quando tornerai online."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 — 변경 사항은 이 기기에 저장되며 다시 온라인이 되면 동기화됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — zmiany są zapisane na tym urządzeniu i zsynchronizują się, gdy znów będziesz online."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — as tuas alterações ficam guardadas neste dispositivo e sincronizam assim que voltares a estar online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — suas alterações ficam salvas neste dispositivo e sincronizam assim que você voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн — изменения сохранены на этом устройстве и синхронизируются, как только появится сеть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออฟไลน์ — การเปลี่ยนแปลงถูกบันทึกไว้ในอุปกรณ์นี้และจะซิงค์เมื่อกลับมาออนไลน์"
