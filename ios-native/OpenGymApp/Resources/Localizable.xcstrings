        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze planu treningowego do przejrzenia — najpierw utwórz taki z co najmniej dwoma ćwiczeniami."
          }
        },
        "pt": {
          "stringUnit": {
