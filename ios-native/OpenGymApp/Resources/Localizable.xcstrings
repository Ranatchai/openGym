        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер підганяє обсяг під час, який у тебе справді є, включно з відпочинком між підходами."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "教练会把训练量控制在你实际拥有的时间内，包括组间休息。"
          }
        }
      }
