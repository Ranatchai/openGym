    "Confirmed. Now create the new passkey — your browser asks where to keep it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التأكيد. أنشئ الآن مفتاح المرور الجديد — سيسألك المتصفح أين يحفظه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt. Erstelle jetzt den neuen Passkey — dein Browser fragt, wo er gespeichert werden soll."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt. Erstelle jetzt den neuen Passkey — dein Browser fragt, wo er gespeichert werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmado. Ahora crea la passkey nueva — tu navegador te pregunta dónde guardarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmé. Crée maintenant la nouvelle passkey — ton navigateur te demande où la garder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि हो गई। अब नई पासकी बनाएँ — आपका ब्राउज़र पूछेगा कि इसे कहाँ रखना है।"
