    "Sessions have been running about fifteen minutes over. This is the accessory with the least to lose from one set fewer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز الجلسات وقتها بنحو خمس عشرة دقيقة. هذا هو التمرين المساعد الأقل خسارة من نقص مجموعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einheiten dauern rund fünfzehn Minuten länger als geplant. Diese Zusatzübung verliert am wenigsten, wenn ein Satz wegfällt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einheiten dauern rund fünfzehn Minuten länger als geplant. Diese Zusatzübung verliert am wenigsten, wenn ein Satz wegfällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones se están alargando unos quince minutos. Este es el ejercicio accesorio que menos pierde con una serie menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séances dépassent d’environ quinze minutes. C’est l’exercice accessoire qui a le moins à perdre avec une série de moins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र लगभग पंद्रह मिनट ज़्यादा चल रहे हैं। यह वह सहायक एक्सरसाइज़ है जिसे एक सेट कम करने से सबसे कम नुकसान होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzések nagyjából tizenöt perccel tovább tartanak. Ez az a kiegészítő gyakorlat, amely a legkevesebbet veszít egy sorozattal kevesebbtől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sedute sforano di circa quindici minuti. Questo è l’esercizio complementare che perde meno con una serie in meno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 예정보다 15분 정도 길어지고 있어요. 이 보조 운동은 한 세트를 줄여도 잃을 게 가장 적어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje trwają około piętnastu minut za długo. To ćwiczenie akcesoryjne straci najmniej na jednej serii mniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões estão a durar cerca de quinze minutos a mais. Este é o exercício acessório que menos perde com uma série a menos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões estão passando uns quinze minutos do previsto. Este é o exercício acessório que menos perde com uma série a menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировки затягиваются примерно на пятнадцать минут. Это то подсобное упражнение, которое меньше всего потеряет от одного подхода меньше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันเกินเวลาไปราวสิบห้านาที ท่าเสริมนี้เสียน้อยที่สุดหากลดลงหนึ่งเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seanslar yaklaşık on beş dakika uzuyor. Bir set eksikten en az kaybedecek yardımcı hareket bu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренування затягуються приблизно на п’ятнадцять хвилин. Це та допоміжна вправа, яка найменше втратить від одного підходу менше."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "训练时间大约超出了十五分钟。这个辅助动作少做一组损失最小。"
          }
        }
      }
    },
