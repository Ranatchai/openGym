          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät gespeichert — der Export mit Fotos & Videos sichert eine Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guarda en este dispositivo — Exportar con fotos y vídeos guarda una copia."
          }
        },
        "fr": {
          "stringUnit": {
