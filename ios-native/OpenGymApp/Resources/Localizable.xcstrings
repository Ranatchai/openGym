        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta palavra-passe é a única forma de entrar no teu perfil, por isso não pode ser removida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
