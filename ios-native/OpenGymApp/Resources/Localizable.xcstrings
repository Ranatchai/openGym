    "Asks for your body weight when a workout starts. Off starts the session straight away.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب وزن جسمك عند بدء التمرين. عند الإيقاف تبدأ الجلسة مباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt beim Start eines Trainings nach deinem Körpergewicht. Aus startet die Einheit direkt."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt beim Start eines Trainings nach deinem Körpergewicht. Aus startet die Einheit direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide tu peso corporal al empezar un entrenamiento. Desactivado, la sesión empieza directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande ton poids au début d’une séance. Désactivé, la séance démarre directement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट शुरू होते समय आपका वज़न पूछता है। बंद होने पर सेशन सीधे शुरू होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Edzés indításakor rákérdez a testsúlyodra. Kikapcsolva az edzés azonnal indul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede il tuo peso all’avvio di un allenamento. Disattivato, la sessione parte subito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동을 시작할 때 체중을 물어봅니다. 끄면 세션이 바로 시작됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyta o Twoją masę ciała przy rozpoczęciu treningu. Wyłączone — sesja zaczyna się od razu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede o teu peso ao iniciar um treino. Desligado, a sessão começa de imediato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede seu peso ao iniciar um treino. Desligado, a sessão começa na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивает ваш вес при начале тренировки. Выключено — сессия начинается сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามน้ำหนักตัวเมื่อเริ่มออกกำลังกาย ถ้าปิด เซสชันจะเริ่มทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman başlarken kilonu sorar. Kapalıyken seans hemen başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує твою вагу на початку тренування. Вимкнено — сесія починається одразу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "开始训练时询问体重。关闭后直接进入训练。"
          }
        }
      }
    },
    "At least {0} characters. A few unrelated words make a good one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ أحرف على الأقل. بضع كلمات غير مترابطة تصنع كلمة مرور جيدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens %1$@ Zeichen. Ein paar Wörter, die nichts miteinander zu tun haben, sind ein gutes Passwort."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens %1$@ Zeichen. Ein paar Wörter, die nichts miteinander zu tun haben, sind ein gutes Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %1$@ characters. A few unrelated words make a good one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos %1$@ caracteres. Unas cuantas palabras sin relación entre sí son una buena contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins %1$@ caractères. Quelques mots sans rapport entre eux font un bon mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम %1$@ अक्षर। कुछ आपस में असंबंधित शब्द मिलकर अच्छा पासवर्ड बनाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább %1$@ karakter. Néhány egymáshoz nem kapcsolódó szó jó jelszót ad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno %1$@ caratteri. Qualche parola senza legame tra loro è una buona password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 %1$@자. 서로 관련 없는 단어 몇 개면 좋은 비밀번호가 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najmniej %1$@ znaków. Kilka niezwiązanych ze sobą słów to dobre hasło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos %1$@ caracteres. Algumas palavras sem relação entre si dão uma boa palavra-passe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos %1$@ caracteres. Algumas palavras sem relação entre si formam uma boa senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не меньше %1$@ символов. Несколько не связанных между собой слов — хороший пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่างน้อย %1$@ ตัวอักษร คำที่ไม่เกี่ยวข้องกันสักสองสามคำเป็นรหัสผ่านที่ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az %1$@ karakter. Birbiriyle ilgisiz birkaç kelime iyi bir şifre olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щонайменше %1$@ символів. Кілька не пов’язаних між собою слів — добрий пароль."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 %1$@ 个字符。几个互不相关的词就是一个好密码。"
          }
        }
      }
    },
