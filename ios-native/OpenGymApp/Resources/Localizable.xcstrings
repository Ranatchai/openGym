    "You are only notified when the Coach actually has something to suggest.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يصلك إشعار إلا عندما يكون لدى المدرب ما يقترحه فعلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst nur benachrichtigt, wenn der Coach wirklich etwas vorzuschlagen hat."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst nur benachrichtigt, wenn der Coach wirklich etwas vorzuschlagen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo recibes aviso cuando el Entrenador tiene algo que sugerir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes prévenu que lorsque le Coach a vraiment quelque chose à proposer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना तभी मिलती है जब कोच के पास वाकई कुछ सुझाने को हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor kapsz értesítést, ha az Edzőnek tényleg van javaslata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica solo quando il Coach ha davvero qualcosa da suggerire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 실제로 제안할 것이 있을 때만 알림이 옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie dostajesz tylko wtedy, gdy Trener naprawdę ma coś do zaproponowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só recebes aviso quando o Treinador tem mesmo algo a sugerir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só é avisado quando o Treinador realmente tem algo a sugerir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление приходит, только если Тренеру действительно есть что предложить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับแจ้งเตือนเฉพาะเมื่อโค้ชมีข้อเสนอแนะจริง ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Koç’un gerçekten önerecek bir şeyi olduğunda bildirim alırsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення приходить, лише якщо Тренеру справді є що запропонувати."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当教练确实有建议时才会通知你。"
          }
        }
      }
    },
    "You can leave — it keeps going.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المغادرة — سيستمر العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst gehen — es läuft weiter."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst gehen — es läuft weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes salir: sigue en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux partir — ça continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जा सकते हैं — यह चलता रहेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elmehetsz — a folyamat megy tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi uscire: continua da solo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자리를 비워도 계속 진행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyjść — to działa dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes sair — continua a trabalhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode sair — ele continua trabalhando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете уйти — работа продолжится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออกไปได้ — ระบบทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkabilirsin — devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш піти — робота продовжиться."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以离开——它会继续进行。"
          }
        }
      }
    },
    "You can turn this off at any time, which also discards anything the Coach is holding for you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إيقافه في أي وقت، وهذا يتخلص أيضًا من أي شيء يحتفظ به المدرب لأجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das jederzeit abschalten; damit wird auch alles verworfen, was der Coach für dich vorhält."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das jederzeit abschalten; damit wird auch alles verworfen, was der Coach für dich vorhält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes desactivarlo cuando quieras, lo que también descarta cualquier cosa que el Entrenador tenga guardada para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désactiver ceci à tout moment, ce qui supprime aussi tout ce que le Coach garde pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे कभी भी बंद कर सकते हैं; इससे कोच के पास रखा आपका सब कुछ भी हट जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt bármikor kikapcsolhatod; ilyenkor minden törlődik, amit az Edző neked tartogat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi disattivarlo quando vuoi, il che elimina anche tutto ciò che il Coach sta tenendo per te."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 끌 수 있으며, 그러면 코치가 보관 중인 내용도 함께 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to wyłączyć w każdej chwili — usunie to też wszystko, co Trener dla Ciebie przechowuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes desligar isto a qualquer momento, o que também descarta o que o Treinador tiver guardado para ti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode desligar isto a qualquer momento, o que também descarta o que o Treinador estiver guardando para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете отключить это в любой момент — тогда всё, что Тренер держит для вас, тоже удалится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณปิดสิ่งนี้ได้ทุกเมื่อ ซึ่งจะทิ้งทุกอย่างที่โค้ชเก็บไว้ให้คุณด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu istediğin zaman kapatabilirsin; bu, Koç’un senin için tuttuğu her şeyi de siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш вимкнути це будь-коли — тоді все, що Тренер тримає для тебе, теж видалиться."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以关闭它，这也会清除教练为你保存的一切内容。"
          }
        }
      }
    },
    "You declined this.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد رفضت هذا."
