        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 쉬는 중입니다 — 이 휴대폰에서 오늘의 %1$@회 실행을 모두 사용했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener odpoczywa — wykorzystano dzisiejsze %1$@ uruchomień na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treinador está a descansar — já usaste as %1$@ utilizações de hoje neste telemóvel."
          }
        },
        "pt-BR": {
          "stringUnit": {
