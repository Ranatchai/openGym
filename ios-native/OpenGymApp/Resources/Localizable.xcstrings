        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Edző pihen — a mai %1$@ futtatást elhasználtad ezen a telefonon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Coach riposa: hai usato le %1$@ esecuzioni di oggi su questo telefono."
