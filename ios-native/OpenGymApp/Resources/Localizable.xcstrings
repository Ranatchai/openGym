    "Bodyweight — every rep last time, so go for {0} this time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وزن الجسم — كل التكرارات في المرة السابقة، لذا استهدف %1$@ هذه المرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körpergewicht — letztes Mal jede Wiederholung, also diesmal %1$@ anpeilen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Körpergewicht — letztes Mal jede Wiederholung, also diesmal %1$@ anpeilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodyweight — every rep last time, so go for %1$@ this time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso corporal: la última vez todas las repeticiones, así que ve a por %1$@ esta vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids du corps — toutes les répétitions la dernière fois, alors vise %1$@ cette fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉडीवेट — पिछली बार सारे रेप्स, तो इस बार %1$@ का लक्ष्य रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Testsúly — legutóbb minden ismétlés meglett, most célozd meg ezt: %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corpo libero — l’ultima volta tutte le ripetizioni, quindi punta a %1$@ stavolta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
