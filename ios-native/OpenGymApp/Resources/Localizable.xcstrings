    "Timed sets continue up to 15 extra minutes. Tap Done to log the actual duration.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر المجموعات الموقوتة حتى 15 دقيقة إضافية. اضغط «تم» لتسجيل المدة الفعلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitbasierte Sätze laufen bis zu 15 zusätzliche Minuten weiter. Tippe auf „Fertig“, um die tatsächliche Dauer zu speichern."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitbasierte Sätze laufen bis zu 15 zusätzliche Minuten weiter. Tippe auf „Fertig“, um die tatsächliche Dauer zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series cronometradas continúan hasta 15 minutos extra. Toca «Listo» para registrar la duración real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries chronométrées continuent jusqu’à 15 minutes supplémentaires. Touchez « Terminé » pour enregistrer la durée réelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध सेट 15 अतिरिक्त मिनट तक जारी रहेंगे। वास्तविक अवधि दर्ज करने के लिए “पूरा” दबाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzített sorozatok legfeljebb 15 extra percig folytatódnak. A tényleges idő rögzítéséhez koppints a Kész gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie a tempo continuano fino a 15 minuti extra. Tocca Fine per registrare la durata effettiva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 제한 세트는 최대 15분 추가로 계속됩니다. 실제 시간을 기록하려면 완료를 누르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie na czas trwają do 15 dodatkowych minut. Stuknij Gotowe, aby zapisać rzeczywisty czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries cronometradas continuam até mais 15 minutos. Toca em Concluído para registar a duração real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries cronometradas continuam por até 15 minutos extras. Toque em Concluído para registrar a duração real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходы на время продолжаются ещё до 15 минут. Нажмите «Готово», чтобы записать фактическую длительность."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซ็ตแบบจับเวลาจะทำต่อได้อีกสูงสุด 15 นาที แตะ “เสร็จแล้ว” เพื่อบันทึกระยะเวลาจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreli setler en fazla 15 dakika daha devam eder. Gerçek süreyi kaydetmek için Bitti’ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходи на час тривають ще до 15 хвилин. Натисни «Готово», щоб записати фактичну тривалість."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "计时组最多继续 15 分钟。点击“完成”记录实际时长。"
          }
        }
      }
    },
