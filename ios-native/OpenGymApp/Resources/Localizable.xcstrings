    "Set up your weekly routine to get going — or load a ready-made starter plan.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهّز روتينك الأسبوعي للبدء — أو حمّل خطة بداية جاهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte deinen Wochenplan ein — oder lade einen fertigen Starterplan."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte deinen Wochenplan ein — oder lade einen fertigen Starterplan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura tu rutina semanal para empezar — o carga un plan inicial ya hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure ta routine hebdo pour commencer — ou charge un plan de départ tout prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए अपना साप्ताहिक रूटीन बनाएँ — या बना-बनाया स्टार्टर प्लान लोड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a heti rutinod, hogy elindulhass — vagy tölts be egy kész kezdő tervet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la tua routine settimanale — o carica un piano iniziale già pronto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 루틴을 설정해 시작하세요 — 또는 미리 만들어진 스타터 계획을 불러오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw swój tygodniowy plan — albo wczytaj gotowy plan startowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura a tua rotina semanal — ou carrega um plano inicial já feito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure sua rotina semanal para começar — ou carregue um plano inicial já pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настрой свой недельный план — или загрузи готовый стартовый план."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่ารูทีนรายสัปดาห์เพื่อเริ่มต้น — หรือโหลดแผนเริ่มต้นสำเร็จรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için haftalık rutinini kur — ya da hazır bir başlangıç planı yükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуй свій тижневий план, щоб почати — або завантаж готовий стартовий план."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "设置每周计划开始训练——或加载现成的入门计划。"
          }
        }
      }
    },
