    "Camera access was denied — allow it in your browser and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفض الوصول إلى الكاميرا — اسمح به في متصفحك وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff wurde verweigert — erlaube ihn im Browser und versuche es erneut."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff wurde verweigert — erlaube ihn im Browser und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el acceso a la cámara — permítelo en el navegador e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la caméra a été refusé — autorisez-le dans le navigateur et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की अनुमति नहीं मिली — ब्राउज़र में अनुमति दें और फिर कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamera-hozzáférés elutasítva — engedélyezd a böngészőben, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla fotocamera negato — consentilo nel browser e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 거부되었습니다 — 브라우저에서 허용한 뒤 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmówiono dostępu do aparatu — zezwól w przeglądarce i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmara foi recusado — permite-o no navegador e tenta de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera foi negado — permita-o no navegador e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере запрещён — разрешите его в браузере и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงกล้องถูกปฏิเสธ — อนุญาตในเบราว์เซอร์แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi reddedildi — tarayıcıda izin verip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери заборонено — дозволь його в браузері й спробуй знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头访问被拒绝 — 请在浏览器中允许后重试。"
          }
        }
      }
    },
    "Camera is not available here — import a photo or type the code instead.": {
