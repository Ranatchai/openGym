    "Your changes are kept here, and merged into your account once it is paired again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغييراتك محفوظة هنا، وستُدمج في حسابك بمجرد إقرانه مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen bleiben hier und werden in dein Konto übernommen, sobald das Handy neu gekoppelt ist."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen bleiben hier und werden in dein Konto übernommen, sobald das Handy neu gekoppelt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios se quedan aquí y se fusionan con tu cuenta en cuanto vuelvas a emparejar el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications restent ici et sont fusionnées avec votre compte dès que le téléphone est à nouveau associé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बदलाव यहीं रखे हैं, और फ़ोन फिर से पेयर होते ही आपके खाते में जोड़ दिए जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosításaid itt maradnak, és a fiókodba kerülnek, amint a telefont újra párosítod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue modifiche restano qui e vengono unite al tuo account appena il telefono è di nuovo abbinato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 이 기기에 보관되며, 다시 페어링하면 계정에 병합됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zmiany zostają tutaj i zostaną scalone z twoim kontem, gdy telefon zostanie ponownie sparowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas alterações ficam aqui e são integradas na tua conta assim que o telemóvel voltar a ser emparelhado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações ficam aqui e são incorporadas à sua conta assim que o celular for pareado de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши изменения остаются здесь и будут объединены с вашим аккаунтом, как только телефон снова будет сопряжён."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงของคุณเก็บไว้ที่นี่ และจะรวมเข้ากับบัญชีเมื่อจับคู่โทรศัพท์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliklerin burada kalıyor ve telefon yeniden eşleştirilince hesabınla birleştirilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої зміни збережено тут; їх буде об’єднано з твоїм акаунтом, щойно телефон знову буде спарено."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的更改保留在这里，重新配对后会合并到你的账号。"
          }
        }
      }
    },
