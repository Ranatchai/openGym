    "Pull your history with a Hevy Pro API key. The key is only used for this import and is not saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب سجلك باستخدام مفتاح Hevy Pro API. يُستخدم المفتاح لهذا الاستيراد فقط ولا يُحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf mit einem Hevy-Pro-API-Schlüssel holen. Der Schlüssel gilt nur für diesen Import und wird nicht gespeichert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf mit einem Hevy-Pro-API-Schlüssel holen. Der Schlüssel gilt nur für diesen Import und wird nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae tu historial con una clave API de Hevy Pro. La clave solo se usa en esta importación y no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer l’historique avec une clé API Hevy Pro. La clé ne sert qu’à cet import et n’est pas enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hevy Pro API कुंजी से अपना इतिहास लाएँ। कुंजी केवल इस आयात के लिए उपयोग होती है और सहेजी नहीं जाती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előzmények letöltése Hevy Pro API-kulccsal. A kulcs csak ehhez az importhoz kell, nem mentjük el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa lo storico con una chiave API Hevy Pro. La chiave serve solo a questo import e non viene salvata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hevy Pro API 키로 기록을 가져옵니다. 키는 이번 가져오기에만 사용되며 저장되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz historię kluczem API Hevy Pro. Klucz służy tylko do tego importu i nie jest zapisywany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz o historial com uma chave API Hevy Pro. A chave só é usada neste import e não é guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga seu histórico com uma chave de API do Hevy Pro. A chave só é usada nesta importação e não é salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить историю с API-ключом Hevy Pro. Ключ используется только для этого импорта и не сохраняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงประวัติด้วยคีย์ API ของ Hevy Pro คีย์ใช้สำหรับการนำเข้าครั้งนี้เท่านั้นและจะไม่ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hevy Pro API anahtarıyla geçmişini çek. Anahtar yalnızca bu içe aktarım için kullanılır ve kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаж історію за допомогою API-ключа Hevy Pro. Ключ використовується лише для цього імпорту й не зберігається."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Hevy Pro API 密钥拉取训练记录。密钥仅用于本次导入，不会保存。"
          }
        }
      }
    },
