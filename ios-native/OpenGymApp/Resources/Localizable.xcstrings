            "value": "Altro?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 밖에는요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś jeszcze?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alguma coisa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alguma coisa?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-нибудь ещё?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอะไรอีกไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir şey?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось іще?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还有别的吗？"
          }
        }
      }
    },
    "Anything it should know? (optional) — e.g. “right shoulder pinches on overhead work”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شيء يجب أن يعرفه؟ (اختياري) — مثلًا «كتفي الأيمن يؤلمني في تمارين فوق الرأس»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas, das er wissen sollte? (optional) — z. B. „rechte Schulter zwickt bei Überkopfübungen“"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas, das er wissen sollte? (optional) — z. B. „rechte Schulter zwickt bei Überkopfübungen“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo que deba saber? (opcional) — p. ej. «me pincha el hombro derecho en press por encima de la cabeza»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose à signaler ? (facultatif) — ex. « l’épaule droite coince sur les mouvements au-dessus de la tête »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ बताना चाहेंगे? (वैकल्पिक) — जैसे “ओवरहेड मूवमेंट में दायें कंधे में खिंचाव होता है”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Van, amit tudnia kellene? (nem kötelező) — pl. „a jobb vállam becsíp fej fölötti gyakorlatoknál”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa che dovrebbe sapere? (facoltativo) — es. «la spalla destra dà fastidio nei movimenti sopra la testa»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알아야 할 게 있나요? (선택) — 예: “오버헤드 동작에서 오른쪽 어깨가 결려요”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś, co powinien wiedzieć? (opcjonalnie) — np. „prawy bark kłuje przy wyciskaniu nad głowę”"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que deva saber? (opcional) — p. ex. «o ombro direito incomoda em movimentos acima da cabeça»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que ele deva saber? (opcional) — ex.: “o ombro direito incomoda em movimentos acima da cabeça”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то, что стоит учесть? (необязательно) — напр. «правое плечо простреливает при жиме над головой»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอะไรที่โค้ชควรรู้ไหม (ไม่บังคับ) — เช่น “ไหล่ขวาเจ็บเวลายกเหนือศีรษะ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilmesi gereken bir şey var mı? (isteğe bağlı) — örn. “baş üstü hareketlerde sağ omzum sıkışıyor”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось, що варто врахувати? (необов’язково) — напр. «праве плече прострілює при жимі над головою»"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么需要它知道的吗？（可选）——例如「过顶动作时右肩有挤压感」"
          }
        }
      }
    },
