          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy treningi, za każdym razem całe ciało."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três sessões, o corpo todo de cada vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três sessões, o corpo todo de cada vez."
          }
        },
        "ru": {
