    "Sick, missed a day or want a different session? Pick what to train instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مريض، أو فاتك يوم، أو تريد جلسة مختلفة؟ اختر ما تريد تدريبه بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krank, Tag verpasst oder Lust auf was anderes? Wähle, was du stattdessen trainierst."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Krank, Tag verpasst oder Lust auf was anderes? Wähle, was du stattdessen trainierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enfermo, te saltaste un día o quieres otra sesión? Elige qué entrenar en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malade, jour manqué ou envie d’autre chose ? Choisis quoi entraîner à la place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बीमार हैं, दिन छूट गया या कुछ और करना है? चुनें कि इसके बदले क्या ट्रेन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beteg vagy, kihagytál egy napot, vagy másra van kedved? Válaszd ki, mit edzel helyette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Malato, giorno saltato o voglia di altro? Scegli cosa allenare al suo posto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아프거나, 하루를 놓쳤거나, 다른 운동이 하고 싶나요? 대신 할 운동을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Choroba, opuszczony dzień albo ochota na coś innego? Wybierz, co trenować zamiast tego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Doente, falhaste um dia ou queres outra sessão? Escolhe o que treinar em vez disso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficou doente, perdeu um dia ou quer outro treino? Escolha o que treinar no lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заболел, пропустил день или хочешь другую тренировку? Выбери, что делать вместо этого."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป่วย, ขาดวัน หรืออยากเปลี่ยนโปรแกรม? เลือกสิ่งที่จะฝึกแทนได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta mısın, gün mü kaçırdın ya da farklı bir seans mı istiyorsun? Yerine ne çalışacağını seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захворів, пропустив день чи хочеш інше тренування? Вибери, що робити замість цього."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "生病、错过一天或想换个训练？选择改练什么。"
          }
        }
      }
    },
