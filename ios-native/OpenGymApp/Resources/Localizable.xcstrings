    "This screen could not be drawn. Your data is safe on this device.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر عرض هذه الشاشة. بياناتك آمنة على هذا الجهاز."
          }
        },
        "de": {
