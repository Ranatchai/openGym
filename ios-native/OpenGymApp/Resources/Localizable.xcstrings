        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार पूरा नहीं हुआ — वही लक्ष्य दोबारा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legutóbb nem sikerült — ugyanaz a cél megint."
