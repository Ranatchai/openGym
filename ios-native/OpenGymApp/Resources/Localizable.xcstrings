    "Scan this with the other device, or open openGym there and enter the code on the sign-in screen. It works once, for {0} minutes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح هذا بالجهاز الآخر، أو افتح openGym هناك وأدخل الرمز في شاشة تسجيل الدخول. يعمل مرة واحدة، لمدة %1$@ دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne das mit dem anderen Gerät, oder öffne dort openGym und gib den Code auf dem Anmeldebildschirm ein. Er funktioniert einmal, %1$@ Minuten lang."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne das mit dem anderen Gerät, oder öffne dort openGym und gib den Code auf dem Anmeldebildschirm ein. Er funktioniert einmal, %1$@ Minuten lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this with the other device, or open openGym there and enter the code on the sign-in screen. It works once, for %1$@ minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea esto con el otro dispositivo, o abre openGym allí e introduce el código en la pantalla de inicio de sesión. Funciona una vez, durante %1$@ minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne ceci avec l’autre appareil, ou ouvre openGym dessus et saisis le code sur l’écran de connexion. Il fonctionne une fois, pendant %1$@ minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे दूसरे डिवाइस से स्कैन करें, या वहाँ openGym खोलकर साइन-इन स्क्रीन पर कोड दर्ज करें। यह एक बार, %1$@ मिनट तक काम करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasd be a másik eszközzel, vagy nyisd meg ott az openGymet, és add meg a kódot a bejelentkezési képernyőn. Egyszer működik, %1$@ percig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansionalo con l’altro dispositivo, oppure apri openGym lì e inserisci il codice nella schermata di accesso. Funziona una volta, per %1$@ minuti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기로 스캔하거나, 그 기기에서 openGym을 열고 로그인 화면에 코드를 입력하세요. 한 번만, %1$@분 동안 사용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj to drugim urządzeniem albo otwórz tam openGym i wpisz kod na ekranie logowania. Działa raz, przez %1$@ minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitaliza isto com o outro dispositivo, ou abre lá o openGym e introduz o código no ecrã de início de sessão. Funciona uma vez, durante %1$@ minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie isto com o outro dispositivo, ou abra o openGym nele e digite o código na tela de entrada. Funciona uma vez, por %1$@ minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируй это другим устройством или открой там openGym и введи код на экране входа. Код работает один раз в течение %1$@ минут."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนด้วยอุปกรณ์อีกเครื่อง หรือเปิด openGym บนเครื่องนั้นแล้วกรอกรหัสในหน้าจอเข้าสู่ระบบ ใช้ได้ครั้งเดียวภายใน %1$@ นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu diğer cihazla tara ya da orada openGym’i açıp kodu giriş ekranına gir. Bir kez ve %1$@ dakika boyunca çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануй це іншим пристроєм або відкрий там openGym і введи код на екрані входу. Код працює один раз протягом %1$@ хвилин."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用另一台设备扫描，或在那台设备上打开 openGym，在登录界面输入代码。仅可使用一次，%1$@ 分钟内有效。"
          }
        }
      }
    },
