    "Last time came up short — same target again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرة السابقة لم تبلغ المدة الكاملة — نفس الهدف هذه المرة."
