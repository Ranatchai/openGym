          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого разу не вистачило — та сама ціль ще раз."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "上次没达标——再来一次同样的目标。"
