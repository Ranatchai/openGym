        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megerősítve. Most hozd létre az új jelszókulcsot — a böngésző megkérdezi, hol tárolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermato. Ora crea la nuova passkey — il browser ti chiede dove conservarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인되었습니다. 이제 새 패스키를 만드세요 — 브라우저가 어디에 보관할지 묻습니다."
