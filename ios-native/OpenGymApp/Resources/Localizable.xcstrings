    "For dips or pull-ups with a belt. Progression then follows the weight.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتمارين الغطس أو العقلة مع حزام. عندها يعتمد التدرج على الوزن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Dips oder Klimmzüge mit Gürtel. Die Progression folgt dann dem Gewicht."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Dips oder Klimmzüge mit Gürtel. Die Progression folgt dann dem Gewicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fondos o dominadas con cinturón. La progresión sigue entonces el peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les dips ou les tractions avec une ceinture. La progression suit alors le poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेल्ट के साथ डिप्स या पुल-अप्स के लिए। फिर प्रोग्रेशन वज़न के हिसाब से चलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Övvel végzett tolódzkodáshoz vagy húzódzkodáshoz. A progresszió ekkor a súlyt követi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per dip o trazioni con la cintura. La progressione segue poi il peso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벨트를 차고 하는 딥스나 풀업용. 그러면 점진적 증가가 무게를 따라갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do dipów albo podciągania z pasem. Progresja idzie wtedy za ciężarem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dips ou pull-ups com cinto. A progressão passa então a seguir o peso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dips ou pull-ups com cinto. A progressão passa então a seguir o peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отжиманий на брусьях или подтягиваний с поясом. Тогда прогрессия идёт по весу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับท่าดิปหรือพูลอัพที่ใช้เข็มขัดถ่วงน้ำหนัก การเพิ่มระดับจะอิงตามน้ำหนักแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemerle yapılan dips veya barfiks için. İlerleme o zaman ağırlığı izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для віджимань на брусах або підтягувань із поясом. Тоді прогресія йде за вагою."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用于系负重腰带做双杠臂屈伸或引体向上。此时进阶方式跟随重量。"
          }
        }
      }
    },
    "For lunges, single-arm rows and the like.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتمارين الاندفاع والسحب بذراع واحدة وما يشابهها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Ausfallschritte, einarmiges Rudern und Ähnliches."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Ausfallschritte, einarmiges Rudern und Ähnliches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para zancadas, remo a una mano y similares."
          }
        },
        "fr": {
