        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed reps %1$@ sessions running — reset to %2$@ %3$@ and work back up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sesiones seguidas fallando repeticiones: vuelve a %2$@ %3$@ y sube de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétitions manquées %1$@ séances de suite — retour à %2$@ %3$@ et on remonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगातार %1$@ सेशन रेप्स चूके — %2$@ %3$@ पर लौटें और फिर से बढ़ाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ edzés óta hiányoznak ismétlések — vissza %2$@ %3$@, és építsd fel újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizioni mancate per %1$@ sessioni di fila: torna a %2$@ %3$@ e risali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@회 연속으로 목표 횟수 미달 — %2$@ %3$@로 되돌리고 다시 올라가세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieudane powtórzenia w %1$@ sesjach z rzędu — wróć do %2$@ %3$@ i buduj od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetições falhadas em %1$@ sessões seguidas — volta a %2$@ %3$@ e sobe outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetições não concluídas em %1$@ sessões seguidas — volte para %2$@ %3$@ e progrida novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторения не даются %1$@ тренировки подряд — вернись к %2$@ %3$@ и наращивай снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พลาดจำนวนครั้งติดต่อกัน %1$@ ครั้ง — รีเซ็ตกลับไปที่ %2$@ %3$@ แล้วค่อยไต่ขึ้นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst üste %1$@ seans tekrarlar eksik — %2$@ %3$@ ağırlığa dön ve yeniden çık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторення не даються %1$@ тренування поспіль — повернись до %2$@ %3$@ і нарощуй знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连续 %1$@ 次未完成次数——回到 %2$@ %3$@ 重新往上做。"
          }
        }
      }
    },
