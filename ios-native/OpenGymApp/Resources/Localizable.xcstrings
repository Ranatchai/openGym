          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per affondi, rematori a un braccio e simili."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런지, 한팔 로우 같은 운동용."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wykroków, wiosłowania jednorącz i podobnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para afundos, remadas a um braço e afins."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para afundos, remadas a um braço e afins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выпадов, тяг одной рукой и тому подобного."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับท่าลันจ์, โรว์แขนเดียว และท่าคล้ายกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunge, tek kol çekiş ve benzeri hareketler için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для випадів, тяги однією рукою і подібного."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用于弓步蹲、单臂划船之类的动作。"
          }
        }
      }
    },
    "For this device, a security key, a password manager, or your phone through the browser’s own QR code. First confirm that it is you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذا الجهاز، أو مفتاح أمان، أو مدير كلمات مرور، أو هاتفك عبر رمز QR الخاص بالمتصفح نفسه. أكّد أولًا أنك أنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Gerät, einen Sicherheitsschlüssel, einen Passwort-Manager oder dein Handy über den QR-Code des Browsers. Bestätige zuerst, dass du es bist."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Gerät, einen Sicherheitsschlüssel, einen Passwort-Manager oder dein Handy über den QR-Code des Browsers. Bestätige zuerst, dass du es bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para este dispositivo, una llave de seguridad, un gestor de contraseñas o tu teléfono mediante el código QR del propio navegador. Primero confirma que eres tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour cet appareil, une clé de sécurité, un gestionnaire de mots de passe, ou ton téléphone via le code QR du navigateur lui-même. Confirme d’abord que c’est bien toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस, सिक्योरिटी की, पासवर्ड मैनेजर, या ब्राउज़र के अपने QR कोड के ज़रिए आपके फ़ोन के लिए। पहले पुष्टि करें कि यह आप ही हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez az eszközhöz, biztonsági kulcshoz, jelszókezelőhöz vagy a telefonodhoz a böngésző saját QR-kódján keresztül. Előbb erősítsd meg, hogy te vagy az."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questo dispositivo, una chiave di sicurezza, un gestore di password o il tuo telefono tramite il codice QR del browser stesso. Prima conferma che sei tu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기, 보안 키, 비밀번호 관리자 또는 브라우저 자체 QR 코드를 통한 휴대폰용입니다. 먼저 본인인지 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tego urządzenia, klucza bezpieczeństwa, menedżera haseł albo twojego telefonu przez kod QR samej przeglądarki. Najpierw potwierdź, że to ty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para este dispositivo, uma chave de segurança, um gestor de palavras-passe ou o teu telemóvel através do código QR do próprio navegador. Primeiro confirma que és tu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para este dispositivo, uma chave de segurança, um gerenciador de senhas ou seu celular pelo código QR do próprio navegador. Primeiro confirme que é você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого устройства, аппаратного ключа, менеджера паролей или телефона через QR-код самого браузера. Сначала подтверди, что это ты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับอุปกรณ์นี้ กุญแจความปลอดภัย ตัวจัดการรหัสผ่าน หรือโทรศัพท์ของคุณผ่านคิวอาร์โค้ดของเบราว์เซอร์เอง ก่อนอื่นยืนยันว่าเป็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz, bir güvenlik anahtarı, bir şifre yöneticisi ya da tarayıcının kendi QR koduyla telefonun için. Önce sen olduğunu onayla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього пристрою, апаратного ключа, менеджера паролів або телефона через QR-код самого браузера. Спершу підтверди, що це ти."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用于此设备、安全密钥、密码管理器，或通过浏览器自带的二维码使用你的手机。请先确认是你本人。"
          }
        }
      }
    },
