    "That code is wrong, used or expired — make a new one on your other device.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز خاطئ أو مستخدَم أو منتهي الصلاحية — أنشئ رمزًا جديدًا على جهازك الآخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist falsch, schon benutzt oder abgelaufen — erstelle auf deinem anderen Gerät einen neuen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist falsch, schon benutzt oder abgelaufen — erstelle auf deinem anderen Gerät einen neuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código es incorrecto, ya se usó o ha caducado — crea uno nuevo en tu otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code est faux, déjà utilisé ou expiré — crées-en un nouveau sur ton autre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड गलत है, इस्तेमाल हो चुका है या समाप्त हो गया है — अपने दूसरे डिवाइस पर नया बनाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kód hibás, már felhasználták, vagy lejárt — hozz létre egy újat a másik eszközödön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è sbagliato, già usato o scaduto — creane uno nuovo sull’altro dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 틀렸거나 이미 사용되었거나 만료되었습니다 — 다른 기기에서 새 코드를 만드세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod jest błędny, już użyty albo wygasł — utwórz nowy na drugim urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código está errado, já foi usado ou expirou — cria um novo no teu outro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código está errado, já foi usado ou expirou — crie um novo no seu outro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код неверный, уже использован или истёк — создай новый на другом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้ไม่ถูกต้อง ถูกใช้ไปแล้ว หรือหมดอายุ — สร้างรหัสใหม่บนอุปกรณ์อีกเครื่องของคุณ"
