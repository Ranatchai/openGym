    "Guest data stays on this device — export a backup now and then!": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الضيف تبقى على هذا الجهاز — صدّر نسخة احتياطية من حين لآخر!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastdaten bleiben auf diesem Gerät — exportiere ab und zu ein Backup!"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastdaten bleiben auf diesem Gerät — exportiere ab und zu ein Backup!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de invitado se quedan en este dispositivo — ¡exporta una copia de vez en cuando!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données invité restent sur cet appareil — exporte une sauvegarde de temps en temps !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेस्ट डेटा इसी डिवाइस पर रहता है — कभी-कभी बैकअप निर्यात करें!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vendégadatok ezen az eszközön maradnak — időnként exportálj egy biztonsági mentést!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati ospite restano su questo dispositivo — esporta un backup ogni tanto!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 데이터는 이 기기에만 있어요 — 가끔 백업을 내보내세요!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane gościa zostają na tym urządzeniu — eksportuj kopię od czasu do czasu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de convidado ficam neste dispositivo — exporta uma cópia de vez em quando!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de visitante ficam neste dispositivo — exporte um backup de vez em quando!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостевые данные остаются на этом устройстве — время от времени делай резервную копию!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลผู้เยี่ยมชมอยู่บนเครื่องนี้เท่านั้น — อย่าลืมส่งออกข้อมูลสำรองเป็นระยะ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Misafir verileri bu cihazda kalır — arada bir yedek al!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостьові дані лишаються на цьому пристрої — час від часу роби резервну копію!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "访客数据仅保存在本设备——记得时常导出备份！"
          }
        }
      }
    },
    "Guest mode — data lives only in this browser.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع الضيف — تبقى بياناتك في هذا المتصفح فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastmodus — die Daten liegen nur in diesem Browser."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastmodus — die Daten liegen nur in diesem Browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo invitado: los datos solo viven en este navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode invité — les données ne vivent que dans ce navigateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिथि मोड — डेटा केवल इसी ब्राउज़र में रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendég mód — az adatok csak ebben a böngészőben léteznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità ospite — i dati restano solo in questo browser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 모드 — 데이터는 이 브라우저에만 저장됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb gościa — dane pozostają tylko w tej przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo convidado — os dados vivem apenas neste navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo visitante — os dados ficam somente neste navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостевой режим — данные хранятся только в этом браузере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดผู้เยี่ยมชม — ข้อมูลอยู่ในเบราว์เซอร์นี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Misafir modu — veriler yalnızca bu tarayıcıda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостьовий режим — дані зберігаються лише в цьому браузері."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "访客模式——数据仅保存在此浏览器中。"
          }
        }
      }
    },
    "Guest mode — data lives only in this browser. Create a passkey profile to keep it safe and separate per person.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع الضيف — البيانات محفوظة في هذا المتصفح فقط. أنشئ ملفاً شخصياً بمفتاح مرور لإبقائها آمنة ومنفصلة لكل شخص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastmodus — Daten liegen nur in diesem Browser. Erstelle ein Passkey-Profil, um sie zu sichern und pro Person zu trennen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastmodus — Daten liegen nur in diesem Browser. Erstelle ein Passkey-Profil, um sie zu sichern und pro Person zu trennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo invitado — los datos viven solo en este navegador. Crea un perfil con passkey para protegerlos y separarlos por persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode invité — les données ne vivent que dans ce navigateur. Crée un profil passkey pour les protéger et les séparer par personne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेस्ट मोड — डेटा केवल इस ब्राउज़र में रहता है। सुरक्षित रखने और हर व्यक्ति के लिए अलग रखने हेतु पासकी प्रोफ़ाइल बनाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendég mód — az adatok csak ebben a böngészőben léteznek. Hozz létre egy jelszókulcs-profilt, hogy biztonságban és személyenként elkülönítve legyenek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità ospite — i dati vivono solo in questo browser. Crea un profilo passkey per proteggerli e separarli per persona."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 모드 — 데이터가 이 브라우저에만 저장됩니다. 패스키 프로필을 만들어 안전하게 보관하고 사람별로 분리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb gościa — dane żyją tylko w tej przeglądarce. Utwórz profil passkey, aby je zabezpieczyć i rozdzielić na osoby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo convidado — os dados vivem só neste navegador. Cria um perfil com passkey para os proteger e separar por pessoa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo visitante — os dados ficam somente neste navegador. Crie um perfil com chave de acesso para mantê-los seguros e separados por pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостевой режим — данные живут только в этом браузере. Создай профиль с ключом доступа, чтобы защитить их и разделить по людям."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดผู้เยี่ยมชม — ข้อมูลอยู่ในเบราว์เซอร์นี้เท่านั้น สร้างโปรไฟล์พาสคีย์เพื่อความปลอดภัยและแยกข้อมูลแต่ละคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Misafir modu — veriler sadece bu tarayıcıda yaşar. Güvende tutmak ve kişi başına ayırmak için geçiş anahtarlı profil oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостьовий режим — дані живуть лише в цьому браузері. Створи профіль із ключем доступу, щоб захистити їх і розділити по людях."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "访客模式——数据只保存在此浏览器。创建通行密钥档案以保护数据并按人区分。"
          }
        }
      }
    },
