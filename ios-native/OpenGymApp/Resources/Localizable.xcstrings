    "Use your profile name — or the e-mail you added to it — and your password.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اسم ملفك الشخصي — أو البريد الإلكتروني الذي أضفته إليه — وكلمة المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Profilnamen – oder der E-Mail, die du ihm hinzugefügt hast – und deinem Passwort."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Profilnamen – oder der E-Mail, die du ihm hinzugefügt hast – und deinem Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el nombre de tu perfil —o el correo que le añadiste— y tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le nom de ton profil — ou l’e-mail que tu lui as ajouté — et ton mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी प्रोफ़ाइल का नाम — या उसमें जोड़ा गया ईमेल — और अपना पासवर्ड इस्तेमाल करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a profilod nevét — vagy a hozzá adott e-mailt — és a jelszavadat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il nome del tuo profilo — o l’e-mail che gli hai aggiunto — e la tua password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 이름(또는 프로필에 추가한 이메일)과 비밀번호를 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj nazwy swojego profilu — albo e-maila, który do niego dodałeś — i swojego hasła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
