    "Not set — lets you sign in where passkeys do not work.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير معيّنة — تتيح لك تسجيل الدخول حيث لا تعمل مفاتيح المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht festgelegt — damit meldest du dich an, wo Passkeys nicht funktionieren."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht festgelegt — damit meldest du dich an, wo Passkeys nicht funktionieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin configurar — te permite iniciar sesión donde las passkeys no funcionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non défini — permet de te connecter là où les passkeys ne fonctionnent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेट नहीं — जहाँ पासकी काम नहीं करती, वहाँ साइन इन करने देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs beállítva — ott jelentkezhetsz be vele, ahol a jelszókulcsok nem működnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non impostata — ti permette di accedere dove le passkey non funzionano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 안 됨 — 패스키가 작동하지 않는 곳에서 로그인할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieustawione — pozwala zalogować się tam, gdzie passkey nie działa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não definida — permite iniciar sessão onde as passkeys não funcionam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não definida — permite entrar onde as chaves de acesso não funcionam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задан — позволяет входить там, где ключи доступа не работают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้ง — ใช้เข้าสู่ระบบในที่ที่พาสคีย์ใช้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlenmedi — geçiş anahtarlarının çalışmadığı yerlerde giriş yapmanı sağlar."
