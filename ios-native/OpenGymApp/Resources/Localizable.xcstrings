    "Switching the unit offers to convert every stored weight.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تبديل الوحدة يُعرض تحويل كل وزن محفوظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Einheitenwechsel wird angeboten, alle gespeicherten Gewichte umzurechnen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Einheitenwechsel wird angeboten, alle gespeicherten Gewichte umzurechnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar la unidad se ofrece convertir todos los pesos guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer d’unité propose de convertir tous les poids enregistrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इकाई बदलने पर सभी सहेजे गए वज़न बदलने का विकल्प मिलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mértékegység-váltáskor felajánlja minden tárolt súly átváltását."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiando unità viene proposto di convertire tutti i pesi salvati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단위를 바꾸면 저장된 모든 무게를 변환할지 물어봅니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana jednostki proponuje przeliczenie wszystkich zapisanych ciężarów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao mudar de unidade é proposto converter todos os pesos guardados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao mudar de unidade é oferecido converter todos os pesos salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене единицы предлагается пересчитать все сохранённые веса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปลี่ยนหน่วยจะมีตัวเลือกให้แปลงน้ำหนักที่บันทึกไว้ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birim değiştirilince tüm kayıtlı ağırlıkları çevirme seçeneği sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При зміні одиниці буде запропоновано перерахувати всі збережені ваги."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "切换单位时会提示换算所有已保存的重量。"
          }
        }
      }
    },
    "Sync failed: the server refused the upload as too large. Your changes have not reached the server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المزامنة: رفض الخادم الرفع لأنه كبير جدًا. لم تصل تغييراتك إلى الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung fehlgeschlagen: Der Server hat den Upload als zu groß abgelehnt. Deine Änderungen sind noch nicht auf dem Server angekommen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung fehlgeschlagen: Der Server hat den Upload als zu gross abgelehnt. Deine Änderungen sind noch nicht auf dem Server angekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de sincronización: el servidor rechazó la subida por ser demasiado grande. Tus cambios no han llegado al servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la synchronisation : le serveur a refusé l’envoi, trop volumineux. Tes modifications n’ont pas atteint le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक विफल: सर्वर ने अपलोड को बहुत बड़ा बताकर अस्वीकार कर दिया। आपके बदलाव सर्वर तक नहीं पहुँचे हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szinkronizálás nem sikerült: a szerver túl nagynak találta a feltöltést és elutasította. A módosításaid nem jutottak el a szerverre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione fallita: il server ha rifiutato il caricamento perché troppo grande. Le tue modifiche non hanno raggiunto il server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 실패: 서버가 업로드가 너무 크다며 거부했습니다. 변경 내용이 서버에 반영되지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja nie powiodła się: serwer odrzucił przesyłanie jako zbyt duże. Twoje zmiany nie dotarły na serwer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização falhou: o servidor recusou o envio por ser demasiado grande. As tuas alterações não chegaram ao servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização falhou: o servidor recusou o envio por ser grande demais. Suas alterações não chegaram ao servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация не удалась: сервер отклонил загрузку как слишком большую. Твои изменения не дошли до сервера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์ไม่สำเร็จ: เซิร์ฟเวอร์ปฏิเสธการอัปโหลดเพราะข้อมูลใหญ่เกินไป การเปลี่ยนแปลงของคุณยังไม่ถึงเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme başarısız: sunucu yüklemeyi çok büyük diye reddetti. Değişikliklerin sunucuya ulaşmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація не вдалася: сервер відхилив завантаження як завелике. Твої зміни не дійшли до сервера."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失败：服务器拒绝了上传，内容过大。你的更改尚未同步到服务器。"
          }
        }
      }
    },
