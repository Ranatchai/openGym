    "The Coach is not a doctor or a physiotherapist. If something hurts, ask a professional.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرب ليس طبيبًا ولا أخصائي علاج طبيعي. إذا كان هناك ألم، استشر مختصًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach ist weder Arzt noch Physiotherapeut. Wenn etwas wehtut, frag eine Fachkraft."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach ist weder Arzt noch Physiotherapeut. Wenn etwas wehtut, frag eine Fachkraft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Entrenador no es médico ni fisioterapeuta. Si algo te duele, consulta a un profesional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Coach n’est ni médecin ni kinésithérapeute. Si quelque chose fait mal, consultez un professionnel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच डॉक्टर या फ़िज़ियोथेरेपिस्ट नहीं है। अगर कहीं दर्द हो तो किसी विशेषज्ञ से मिलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Edző nem orvos és nem gyógytornász. Ha valami fáj, fordulj szakemberhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Coach non è un medico né un fisioterapista. Se qualcosa fa male, rivolgiti a un professionista."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치는 의사나 물리치료사가 아닙니다. 통증이 있다면 전문가에게 문의하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener nie jest lekarzem ani fizjoterapeutą. Jeśli coś boli, skonsultuj się ze specjalistą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treinador não é médico nem fisioterapeuta. Se algo doer, consulta um profissional."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treinador não é médico nem fisioterapeuta. Se algo doer, procure um profissional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер — не врач и не физиотерапевт. Если что-то болит, обратитесь к специалисту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้ชไม่ใช่แพทย์หรือนักกายภาพบำบัด หากมีอาการเจ็บ โปรดปรึกษาผู้เชี่ยวชาญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koç doktor ya da fizyoterapist değildir. Bir yerin ağrıyorsa bir uzmana danış."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер — не лікар і не фізіотерапевт. Якщо щось болить, звернись до фахівця."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "教练不是医生或物理治疗师。如果哪里疼，请咨询专业人士。"
          }
        }
      }
    },
