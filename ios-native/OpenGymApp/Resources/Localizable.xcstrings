    "Work up through a rep range at the same weight. Reach the top of the range in every set and the weight goes up, reps back to the bottom.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرج عبر نطاق تكرارات بنفس الوزن. بلغ قمة النطاق في كل مجموعة ويرتفع الوزن، وتعود التكرارات إلى الأسفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite dich bei gleichem Gewicht durch einen Wiederholungsbereich. Erreichst du in jedem Satz das obere Ende, steigt das Gewicht und die Wiederholungen fallen zurück auf das untere Ende."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite dich bei gleichem Gewicht durch einen Wiederholungsbereich. Erreichst du in jedem Satz das obere Ende, steigt das Gewicht und die Wiederholungen fallen zurück auf das untere Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube por un rango de repeticiones con el mismo peso. Alcanza el tope del rango en todas las series y el peso sube, con las repeticiones de vuelta al mínimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresse dans une fourchette de répétitions au même poids. Atteins le haut de la fourchette sur toutes les séries et le poids augmente, les répétitions repartent du bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही वज़न पर रेप रेंज में ऊपर बढ़ें। हर सेट में रेंज का ऊपरी सिरा छुएँ तो वज़न बढ़ता है और रेप्स नीचे लौट आते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanazon a súlyon dolgozz végig egy ismétléstartományon. Ha minden sorozatban eléred a tartomány tetejét, a súly emelkedik, az ismétlésszám pedig visszaáll az aljára."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali lungo un intervallo di ripetizioni allo stesso peso. Raggiungi il massimo dell’intervallo in ogni serie e il peso sale, con le ripetizioni di nuovo al minimo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 무게에서 반복 범위를 올려 갑니다. 모든 세트에서 상한에 도달하면 무게가 오르고 횟수는 하한으로 돌아갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuj w zakresie powtórzeń na tym samym ciężarze. Osiągnij górną granicę we wszystkich seriach, a ciężar rośnie, a powtórzenia wracają na dół."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe ao longo de um intervalo de repetições com o mesmo peso. Atinge o topo do intervalo em todas as séries e o peso sobe, com as repetições de volta ao mínimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance por uma faixa de repetições com o mesmo peso. Ao atingir o topo da faixa em todas as séries, o peso aumenta e as repetições voltam ao mínimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Растёшь в диапазоне повторений на одном весе. Достиг верхней границы во всех подходах — вес растёт, а повторения возвращаются к нижней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไต่ระดับจำนวนครั้งด้วยน้ำหนักเดิม ถ้าถึงจำนวนครั้งสูงสุดในทุกเซ็ต น้ำหนักจะเพิ่มขึ้นและจำนวนครั้งกลับไปเริ่มที่ต่ำสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ağırlıkta bir tekrar aralığında yukarı çalış. Her sette aralığın üst sınırına ulaşırsan ağırlık artar, tekrarlar alt sınıra döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ростеш у діапазоні повторень на одній вазі. Досяг верхньої межі в усіх підходах — вага зростає, а повторення повертаються до нижньої."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一重量下把次数从下限做到上限。每组都做到上限就加重，次数回到下限。"
          }
        }
      }
    },
