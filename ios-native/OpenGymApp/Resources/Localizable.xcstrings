      }
    },
    "This profile already has as many passkeys as it can hold.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ هذا الملف الشخصي الحد الأقصى من مفاتيح المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
