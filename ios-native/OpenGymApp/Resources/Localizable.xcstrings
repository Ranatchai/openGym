    "Import a photo of your membership card or scan it with the camera. No extra app needed at the gym — just open this screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد صورة بطاقة عضويتك أو امسحها بالكاميرا. لا حاجة لتطبيق إضافي في الجيم — افتح هذه الشاشة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere ein Foto deiner Mitgliedskarte oder scanne sie mit der Kamera. Keine zusätzliche App im Studio nötig — öffne einfach diesen Bildschirm."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere ein Foto deiner Mitgliedskarte oder scanne sie mit der Kamera. Keine zusätzliche App im Studio nötig — öffne einfach diesen Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una foto de tu tarjeta de socio o escanéala con la cámara. No hace falta otra app en el gimnasio — solo abre esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe une photo de ta carte de membre ou scanne-la avec l’appareil photo. Aucune autre appli nécessaire à la salle — ouvre simplement cet écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मेंबरशिप कार्ड की फ़ोटो इम्पोर्ट करें या कैमरे से स्कैन करें। जिम में किसी और ऐप की ज़रूरत नहीं — बस यह स्क्रीन खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálj egy fotót a tagsági kártyádról, vagy olvasd be a kamerával. Nincs szükség külön alkalmazásra a teremben — csak nyisd meg ezt a képernyőt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una foto della tua tessera o scansionala con la fotocamera. Nessuna app extra in palestra — apri semplicemente questa schermata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 카드 사진을 가져오거나 카메라로 스캔하세요. 헬스장에서 다른 앱은 필요 없어요 — 이 화면만 열면 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj zdjęcie karty członkowskiej lub zeskanuj ją aparatem. Na siłowni nie potrzebujesz innej aplikacji — po prostu otwórz ten ekran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa uma foto do teu cartão de sócio ou digitaliza-o com a câmara. Não é preciso outra app no ginásio — basta abrir este ecrã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe uma foto do seu cartão de sócio ou escaneie com a câmera. Não é preciso outro app na academia — é só abrir esta tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте фото клубной карты или отсканируйте её камерой. В зале не нужно отдельное приложение — просто откройте этот экран."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้ารูปถ่ายบัตรสมาชิกหรือสแกนด้วยกล้อง ไม่ต้องใช้แอปอื่นที่ยิม — แค่เปิดหน้าจอนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyelik kartının fotoğrafını içe aktar ya da kamerayla tara. Salonda ekstra bir uygulamaya gerek yok — sadece bu ekranı aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуй фото клубної картки або відскануй її камерою. У залі не потрібен окремий застосунок — просто відкрий цей екран."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "导入会员卡照片，或用相机扫描。在健身房无需额外应用——打开此界面即可。"
          }
        }
      }
    },
