    "Last set hit {0} reps — twice the target, so take a double jump of {1} {2}.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت المجموعة الأخيرة %1$@ تكرارات — ضعف الهدف، لذا ارفع الوزن بمقدار %2$@ %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Satz mit %1$@ Wiederholungen — doppelte Vorgabe, also ein doppelter Sprung von %2$@ %3$@."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Satz mit %1$@ Wiederholungen — doppelte Vorgabe, also ein doppelter Sprung von %2$@ %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last set hit %1$@ reps — twice the target, so take a double jump of %2$@ %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última serie llegó a %1$@ repeticiones: el doble del objetivo, así que sube el doble, %2$@ %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière série à %1$@ répétitions — le double de l’objectif, donc un saut double de %2$@ %3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी सेट में %1$@ रेप्स — लक्ष्य से दोगुने, इसलिए %2$@ %3$@ की दोगुनी छलांग।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó sorozat %1$@ ismétlést ért el — kétszerese a célnak, ezért dupla ugrás: %2$@ %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima serie a %1$@ ripetizioni: il doppio dell’obiettivo, quindi salto doppio di %2$@ %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 세트 %1$@회 — 목표의 두 배라 %2$@ %3$@만큼 두 배로 올립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnia seria to %1$@ powtórzeń — dwukrotność celu, więc podwójny skok o %2$@ %3$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A última série chegou a %1$@ repetições — o dobro do objetivo, por isso um salto duplo de %2$@ %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última série chegou a %1$@ repetições — o dobro do objetivo, por isso um salto duplo de %2$@ %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В последнем подходе %1$@ повторений — вдвое больше цели, поэтому двойной шаг %2$@ %3$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซ็ตสุดท้ายทำได้ %1$@ ครั้ง — เกินเป้าสองเท่า จึงเพิ่มน้ำหนักแบบก้าวกระโดด %2$@ %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son set %1$@ tekrar — hedefin iki katı, bu yüzden %2$@ %3$@ çift artış."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В останньому підході %1$@ повторень — удвічі більше цілі, тож подвійний крок %2$@ %3$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "最后一组做了 %1$@ 次——是目标的两倍，因此加倍上调 %2$@ %3$@。"
          }
        }
      }
    },
