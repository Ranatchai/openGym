          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 주소가 openGym이 아닌 다른 응답을 보냈습니다 (HTTP %1$@). 변경 사항은 이 기기에 보관됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres twojego serwera odpowiedział czymś innym niż openGym (HTTP %1$@). Twoje zmiany zostają tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
