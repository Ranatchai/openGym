    "Could not sign out everywhere — you are still signed in.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيل الخروج من كل الأجهزة — ما زلت مسجلاً الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden auf allen Geräten fehlgeschlagen — du bist weiterhin angemeldet."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden auf allen Geräten fehlgeschlagen — du bist weiterhin angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cerrar la sesión en todos los dispositivos — sigues con la sesión iniciada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se déconnecter partout — tu es toujours connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर जगह साइन आउट नहीं हो सका — आप अभी भी साइन इन हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült mindenhonnan kijelentkezni — továbbra is be vagy jelentkezve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile uscire ovunque — sei ancora connesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃하지 못했습니다 — 아직 로그인 상태입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wylogować wszędzie — nadal jesteś zalogowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível terminar a sessão em todos os dispositivos — continuas com sessão iniciada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível sair de todos os dispositivos — sua sessão continua ativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выйти на всех устройствах — ты всё ещё в системе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบทุกอุปกรณ์ไม่สำเร็จ — คุณยังคงเข้าสู่ระบบอยู่"
          }
        },
        "tr": {
