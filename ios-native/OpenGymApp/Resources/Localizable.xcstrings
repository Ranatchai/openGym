    "Used by every proposal — keep limitations here up to date.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم في كل اقتراح — أبقِ القيود هنا محدثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für jeden Vorschlag genutzt — halte deine Einschränkungen hier aktuell."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für jeden Vorschlag genutzt — halte deine Einschränkungen hier aktuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa en cada propuesta: mantén aquí tus limitaciones al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour chaque proposition : tenez vos limitations à jour ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रस्ताव में इस्तेमाल होता है — अपनी सीमाएँ यहाँ अद्यतन रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden javaslat ezt használja — tartsd naprakészen a korlátaidat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato in ogni proposta: tieni aggiornate qui le tue limitazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 제안에 사용됩니다 — 제약 사항을 최신 상태로 유지하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane przy każdej propozycji — trzymaj tu aktualne ograniczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado em cada proposta: mantém aqui as tuas limitações atualizadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado em cada proposta — mantenha suas limitações atualizadas aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется в каждом предложении — держите ограничения здесь в актуальном виде."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
