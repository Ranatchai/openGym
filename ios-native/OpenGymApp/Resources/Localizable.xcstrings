    "How it went, what to change — kept with today’s workout.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف سارت الجلسة وما الذي ستغيره — تُحفظ مع تمرين اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie es lief, was du ändern willst — bleibt beim heutigen Training."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie es lief, was du ändern willst — bleibt beim heutigen Training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo fue, qué cambiar — se guarda con el entrenamiento de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ça s’est passé, ce qu’il faut changer — conservé avec la séance du jour."
