    "The Coach is resting — you have used today’s {0} runs on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرب يستريح — استخدمت تشغيلات اليوم البالغة %1$@ على هذا الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach pausiert — du hast die %1$@ Läufe für heute auf diesem Handy aufgebraucht."
