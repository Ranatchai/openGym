        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden sorozat dropszetté válik: a fő sorozat után %1$@ további lépés pihenő nélkül, mindegyik kb. %2$@%%-kal könnyebb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni serie diventa un drop-set: dopo la serie principale, %1$@ riduzione/i senza recupero, ciascuna circa il %2$@%% più leggera."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세트가 드롭세트가 됩니다: 메인 세트 후 휴식 없이 %1$@회 드롭, 매번 약 %2$@%%씩 가벼워집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda seria staje się serią zniżkującą: po serii głównej %1$@ redukcja(e) bez odpoczynku, każda lżejsza o ok. %2$@%%."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada série torna-se uma série decrescente: depois da série principal, %1$@ queda(s) sem descanso, cada uma cerca de %2$@%% mais leve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada série vira uma série decrescente: depois da série principal, %1$@ queda(s) sem descanso, cada uma cerca de %2$@%% mais leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый подход становится дроп-сетом: после основного подхода %1$@ снижение(й) без отдыха, каждое примерно на %2$@%% легче."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเซ็ตจะกลายเป็นดรอปเซ็ต: หลังเซ็ตหลักจะมี %1$@ ดรอปโดยไม่พัก แต่ละดรอปเบาลงประมาณ %2$@%%"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her set düşüş setine dönüşür: ana setten sonra dinlenmeden %1$@ düşüş, her biri yaklaşık %%%2$@ daha hafif."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен підхід стає дроп-сетом: після основного підходу %1$@ зниження(нь) без відпочинку, кожне приблизно на %2$@%% легше."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每组都变成递减组：主组之后，无休息完成 %1$@ 次递减，每次约减轻 %2$@%%。"
          }
        }
      }
    },
    "Every set becomes rest-pause: {0} reps to start, then {1} more split into short bursts, {2}s rest before each, roughly halving each time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مجموعة تصبح ريست بوز: %1$@ تكرارات في البداية، ثم %2$@ تكرارات إضافية موزعة على دفعات قصيرة، مع %3$@ ثانية راحة قبل كل دفعة، وتنخفض تقريبًا إلى النصف في كل مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Satz wird zu Rest-Pause: %1$@ Wiederholungen zu Beginn, dann %2$@ weitere in kurzen Bursts, mit %3$@s Pause davor, dabei jedes Mal etwa halbiert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Satz wird zu Rest-Pause: %1$@ Wiederholungen zu Beginn, dann %2$@ weitere in kurzen Bursts, mit %3$@s Pause davor, dabei jedes Mal etwa halbiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every set becomes rest-pause: %1$@ reps to start, then %2$@ more split into short bursts, %3$@s rest before each, roughly halving each time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serie se convierte en rest-pause: %1$@ reps para empezar, y %2$@ más repartidas en ráfagas cortas, con %3$@s de descanso antes de cada una, bajando aprox. a la mitad cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque série devient rest-pause : %1$@ répétitions pour commencer, puis %2$@ de plus réparties en courtes rafales, avec %3$@s de repos avant chacune, en diminuant environ de moitié à chaque fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेट रेस्ट-पॉज़ बन जाता है: शुरुआत में %1$@ रेप्स, फिर छोटे बर्स्ट में बंटे %2$@ और, हर एक से पहले %3$@ सेकंड आराम, हर बार लगभग आधा होते हुए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden sorozat rest-pause-zá válik: kezdésként %1$@ ismétlés, majd további %2$@ rövid burstökre bontva, mindegyik előtt %3$@ mp pihenővel, nagyjából minden alkalommal megfeleződve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni serie diventa rest-pause: %1$@ ripetizioni iniziali, poi altre %2$@ suddivise in brevi burst, con %3$@s di recupero prima di ciascuno, dimezzando circa ogni volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세트가 레스트포즈가 됩니다: 처음 %1$@회를 하고, 짧은 버스트로 나눠 %2$@회를 더 하며, 매번 전에 %3$@초씩 쉬고 매번 대략 절반으로 줄어듭니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda seria staje się rest-pause: %1$@ powtórzeń na start, potem kolejne %2$@ podzielone na krótkie serie, z %3$@s odpoczynku przed każdą, zmniejszając się za każdym razem o połowę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada série torna-se rest-pause: %1$@ repetições para começar, depois mais %2$@ divididas em rajadas curtas, com %3$@s de descanso antes de cada uma, reduzindo cerca de metade a cada vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada série vira rest-pause: %1$@ repetições para começar, depois mais %2$@ divididas em rajadas curtas, com %3$@s de descanso antes de cada uma, caindo cerca de metade a cada vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый подход становится рест-паузой: сначала %1$@ повторений, затем ещё %2$@, разбитых на короткие серии, с %3$@ с отдыха перед каждой, каждый раз примерно вдвое меньше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเซ็ตจะกลายเป็นเรสต์-พอส: เริ่มด้วย %1$@ ครั้ง จากนั้นอีก %2$@ ครั้งแบ่งเป็นชุดสั้น ๆ พัก %3$@ วินาทีก่อนแต่ละชุด โดยลดลงเกือบครึ่งทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her set rest-pause olur: başlangıçta %1$@ tekrar, ardından kısa patlamalara bölünmüş %2$@ tekrar daha, her birinden önce %3$@ sn dinlenme, her seferinde yaklaşık yarıya inerek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен підхід стає рест-паузою: спочатку %1$@ повторень, потім ще %2$@, розбитих на короткі серії, з %3$@ с відпочинку перед кожною, щоразу приблизно вдвічі менше."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每组都变成歇息暂停组：先做 %1$@ 次，再分成几个短爆发共 %2$@ 次，每次前休息 %3$@ 秒，每次数量大约减半。"
          }
        }
      }
    },
    "Every stored weight — logged sets, working weights, routine targets, body weight, bar weights — is in {0}. Convert the numbers, or keep them and only change the label?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل وزن محفوظ — المجموعات المسجلة، أوزان العمل، أهداف الروتين، وزن الجسم، أوزان البار — بوحدة %1$@. هل تحوّل الأرقام، أم تبقيها وتغيّر التسمية فقط؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes gespeicherte Gewicht — eingetragene Sätze, Arbeitsgewichte, Routinenziele, Körpergewicht, Stangengewichte — steht in %1$@. Zahlen umrechnen, oder behalten und nur die Beschriftung ändern?"
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes gespeicherte Gewicht — eingetragene Sätze, Arbeitsgewichte, Routinenziele, Körpergewicht, Stangengewichte — steht in %1$@. Zahlen umrechnen, oder behalten und nur die Beschriftung ändern?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every stored weight — logged sets, working weights, routine targets, body weight, bar weights — is in %1$@. Convert the numbers, or keep them and only change the label?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los pesos guardados — series registradas, pesos de trabajo, objetivos de rutina, peso corporal, pesos de barra — están en %1$@. ¿Convertir los números o mantenerlos y cambiar solo la etiqueta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les poids enregistrés — séries, charges de travail, cibles des routines, poids de corps, poids des barres — sont en %1$@. Convertir les nombres, ou les garder et ne changer que l’étiquette ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सहेजा गया वज़न — दर्ज सेट, कार्य वज़न, रूटीन लक्ष्य, शरीर का वज़न, बार वज़न — %1$@ में है। संख्याएँ बदलें, या उन्हें रखें और केवल लेबल बदलें?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden tárolt súly — naplózott sorozatok, munkasúlyok, rutincélok, testsúly, rúdsúlyok — %1$@-ban van. Átváltsuk a számokat, vagy maradjanak és csak a címke változzon?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni peso salvato — serie registrate, pesi di lavoro, obiettivi delle routine, peso corporeo, pesi dei bilancieri — è in %1$@. Convertire i numeri o tenerli e cambiare solo l’etichetta?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 무게(기록된 세트, 작업 무게, 루틴 목표, 체중, 바 무게)는 %1$@ 단위입니다. 숫자를 변환할까요, 아니면 숫자는 그대로 두고 표시만 바꿀까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zapisane ciężary — serie, ciężary robocze, cele rutyn, masa ciała, ciężary sztang — są w %1$@. Przeliczyć liczby, czy zostawić je i zmienić tylko etykietę?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os pesos guardados — séries registadas, pesos de trabalho, alvos das rotinas, peso corporal, pesos das barras — estão em %1$@. Converter os números, ou mantê-los e mudar só a etiqueta?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os pesos salvos — séries registradas, pesos de trabalho, alvos das rotinas, peso corporal, pesos das barras — estão em %1$@. Converter os números, ou mantê-los e mudar só o rótulo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сохранённые веса — подходы, рабочие веса, цели программ, вес тела, вес грифов — записаны в %1$@. Пересчитать числа или оставить их и сменить только подпись?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักที่บันทึกไว้ทั้งหมด — เซ็ตที่บันทึก น้ำหนักทำงาน เป้าหมายของรูทีน น้ำหนักตัว น้ำหนักบาร์ — เป็นหน่วย %1$@ จะแปลงตัวเลข หรือคงตัวเลขไว้และเปลี่ยนแค่ป้ายหน่วย?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı tüm ağırlıklar — setler, çalışma ağırlıkları, rutin hedefleri, vücut ağırlığı, bar ağırlıkları — %1$@ cinsinden. Sayılar çevrilsin mi, yoksa sayılar kalıp yalnızca etiket mi değişsin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі збережені ваги — записані підходи, робочі ваги, цілі програм, вага тіла, вага грифів — вказані в %1$@. Перерахувати числа чи лишити їх і змінити лише підпис?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已保存的重量（记录的组、工作重量、计划目标、体重、杠铃杆重量）目前以 %1$@ 计。是换算数值，还是保留数值只更改单位标签？"
          }
        }
      }
    },
    "Every top set on this one came in at RPE 9.5 or above for three sessions and the weight has not moved. Swapping the movement for four weeks usually breaks that stall faster than grinding the same one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاءت كل المجموعات الأثقل في هذا التمرين عند RPE 9.5 أو أعلى لثلاث جلسات ولم يتحرك الوزن. استبدال الحركة لأربعة أسابيع يكسر هذا الثبات عادةً أسرع من الإصرار على الحركة نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Top-Satz dieser Übung lag drei Einheiten lang bei RPE 9,5 oder höher, und das Gewicht hat sich nicht bewegt. Die Bewegung für vier Wochen zu tauschen, löst so ein Plateau meist schneller, als sich an derselben festzubeißen."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Top-Satz dieser Übung lag drei Einheiten lang bei RPE 9,5 oder höher, und das Gewicht hat sich nicht bewegt. Die Bewegung für vier Wochen zu tauschen, löst so ein Plateau meist schneller, als sich an derselben festzubeissen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las series principales de este ejercicio quedaron en RPE 9,5 o más durante tres sesiones y el peso no se ha movido. Cambiar el movimiento durante cuatro semanas suele romper ese estancamiento antes que insistir en el mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les séries principales de cet exercice ont été à RPE 9,5 ou plus pendant trois séances, et la charge n’a pas bougé. Changer de mouvement pendant quatre semaines débloque généralement ce plateau plus vite que de s’acharner sur le même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एक्सरसाइज़ के हर टॉप सेट तीन सत्रों तक RPE 9.5 या उससे ऊपर रहे और वज़न नहीं बढ़ा। चार हफ़्तों के लिए मूवमेंट बदलना आमतौर पर उसी पर ज़ोर लगाते रहने से जल्दी यह ठहराव तोड़ देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennél a gyakorlatnál három edzésen át minden fő sorozat RPE 9,5 vagy afölött volt, és a súly nem mozdult. Ha négy hétre lecseréled a mozdulatot, az általában gyorsabban áttöri az ilyen megtorpanást, mint ha ugyanazt erőlteted tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le serie principali di questo esercizio sono state a RPE 9,5 o più per tre sedute e il peso non si è mosso. Cambiare movimento per quattro settimane di solito sblocca lo stallo prima che insistere sullo stesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 운동의 메인 세트는 세 번의 세션 동안 모두 RPE 9.5 이상이었고 중량은 그대로예요. 4주 동안 동작을 바꾸면 같은 동작을 억지로 밀어붙이는 것보다 보통 더 빨리 정체기를 벗어나요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda główna seria w tym ćwiczeniu przez trzy sesje wypadała na RPE 9,5 lub wyżej, a ciężar się nie ruszył. Zmiana ruchu na cztery tygodnie zwykle szybciej przełamuje taki zastój niż mozolenie się z tym samym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as séries principais deste exercício ficaram em RPE 9,5 ou mais durante três sessões e o peso não mexeu. Trocar o movimento durante quatro semanas costuma desbloquear essa estagnação mais depressa do que insistir no mesmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as séries principais deste exercício ficaram em RPE 9,5 ou mais por três sessões e o peso não se mexeu. Trocar o movimento por quatro semanas costuma destravar essa estagnação mais rápido do que insistir no mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все основные подходы здесь три тренировки подряд шли на RPE 9,5 и выше, а вес не сдвинулся. Замена движения на четыре недели обычно выводит из застоя быстрее, чем упорство в том же."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซ็ตหลักทุกเซ็ตของท่านี้อยู่ที่ RPE 9.5 ขึ้นไปติดต่อกันสามเซสชัน และน้ำหนักไม่ขยับเลย การเปลี่ยนท่าสักสี่สัปดาห์มักทำลายจุดตันได้เร็วกว่าการฝืนท่าเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu harekette üç seans boyunca her ana set RPE 9,5 veya üzerinde geldi ve ağırlık kıpırdamadı. Hareketi dört haftalığına değiştirmek, bu tıkanmayı genellikle aynı hareketle zorlamaktan daha hızlı aşar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі основні підходи тут три тренування поспіль ішли на RPE 9,5 і вище, а вага не зрушила. Заміна руху на чотири тижні зазвичай виводить із застою швидше, ніж упертість у тому самому."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这个动作的主要组连续三次训练都在 RPE 9.5 或以上，而重量没有变化。把动作换掉四周，通常比死磕同一个动作更快突破平台期。"
          }
        }
      }
    },
    "Everything hidden here stays one tap away: the ⋯ button of an exercise and the number of a set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تخفيه هنا يبقى على بعد ضغطة: زر ⋯ في التمرين ورقم المجموعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was hier ausgeblendet ist, bleibt einen Tipp entfernt: die ⋯-Taste einer Übung und die Nummer eines Satzes."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was hier ausgeblendet ist, bleibt einen Tipp entfernt: die ⋯-Taste einer Übung und die Nummer eines Satzes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que ocultes aquí sigue a un toque: el botón ⋯ de un ejercicio y el número de una serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est masqué ici reste à un tap : le bouton ⋯ d'un exercice et le numéro d'une série."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ छिपाया गया सब कुछ एक टैप दूर रहता है: व्यायाम का ⋯ बटन और सेट की संख्या।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit itt elrejtesz, egy koppintásra marad: a gyakorlat ⋯ gombja és a sorozat száma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che nascondi qui resta a un tocco: il pulsante ⋯ di un esercizio e il numero di una serie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 숨긴 것은 모두 한 번의 탭으로 열 수 있습니다: 운동의 ⋯ 버튼과 세트 번호."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co tu ukryjesz, jest o jedno dotknięcie: przycisk ⋯ ćwiczenia i numer serii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que escondes aqui fica a um toque: o botão ⋯ de um exercício e o número de uma série."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você esconde aqui fica a um toque: o botão ⋯ de um exercício e o número de uma série."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё скрытое здесь остаётся в одном нажатии: кнопка ⋯ упражнения и номер подхода."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่ซ่อนไว้ยังอยู่ห่างแค่แตะเดียว: ปุ่ม ⋯ ของท่าและหมายเลขเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada gizlenen her şey bir dokunuş uzakta kalır: egzersizin ⋯ düğmesi ve setin numarası."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе приховане тут лишається за один дотик: кнопка ⋯ вправи та номер підходу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这里隐藏的一切都只需一次点按：动作的 ⋯ 按钮和组号。"
          }
        }
      }
    },
