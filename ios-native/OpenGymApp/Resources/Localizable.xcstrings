        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez ficaste aquém — o mesmo objetivo outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última vez você ficou abaixo da meta — repita a mesma meta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз не хватило — та же цель ещё раз."
