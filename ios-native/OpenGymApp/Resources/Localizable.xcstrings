    "The server has 1 workout that is not in this backup, logged since it was made or on another device. Replacing deletes it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الخادم تمرين واحد ليس في هذه النسخة الاحتياطية، سُجّل بعد إنشائها أو على جهاز آخر. الاستبدال يحذفه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist 1 Training, das nicht in diesem Backup ist – seither oder auf einem anderen Gerät erfasst. Ersetzen löscht es."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist 1 Training, das nicht in diesem Backup ist – seither oder auf einem anderen Gerät erfasst. Ersetzen löscht es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tiene 1 entrenamiento que no está en esta copia, registrado después de hacerla o en otro dispositivo. Reemplazar lo elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a 1 séance absente de cette sauvegarde, enregistrée depuis ou sur un autre appareil. Remplacer la supprime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर पर 1 वर्कआउट है जो इस बैकअप में नहीं है — बैकअप के बाद या किसी दूसरे डिवाइस पर दर्ज। बदलने से वह हट जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerveren van 1 edzés, amely nincs ebben a mentésben – azóta vagy egy másik eszközön rögzítették. A csere törli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul server c’è 1 allenamento che non è in questo backup, registrato dopo o su un altro dispositivo. Sostituire lo elimina."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 이 백업에 없는 운동이 1개 있습니다. 백업 이후 또는 다른 기기에서 기록된 것입니다. 바꾸면 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na serwerze jest 1 trening, którego nie ma w tej kopii – zapisany później lub na innym urządzeniu. Zastąpienie go usunie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor tem 1 treino que não está nesta cópia, registado depois dela ou noutro dispositivo. Substituir elimina-o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor tem 1 treino que não está neste backup, registrado depois dele ou em outro dispositivo. Substituir exclui esse treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере есть 1 тренировка, которой нет в этой копии: записана позже или на другом устройстве. Замена её удалит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์มีการออกกำลังกาย 1 รายการที่ไม่อยู่ในข้อมูลสำรองนี้ บันทึกหลังจากนั้นหรือบนอุปกรณ์อื่น การแทนที่จะลบรายการนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuda bu yedekte olmayan 1 antrenman var; yedekten sonra ya da başka bir cihazda kaydedilmiş. Değiştirmek onu siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервері є 1 тренування, якого немає в цій копії: записане пізніше або на іншому пристрої. Заміна його видалить."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上有 1 次训练不在此备份中，是备份之后或在其他设备上记录的。替换会删除它。"
          }
        }
      }
    },
