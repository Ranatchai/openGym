    "Tap a trained day for details · tap any other day to plan a session": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على يوم تدرّبت فيه للتفاصيل · اضغط على أي يوم آخر لجدولة جلسة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen trainierten Tag für Details · tippe auf jeden anderen Tag, um zu planen"
