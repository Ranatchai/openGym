            "state": "translated",
            "value": "Tu n’as pas encore de routine — demande d’abord un plan au Coach."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आपकी कोई रूटीन नहीं है — पहले कोच से प्लान माँगें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
