          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используй имя профиля — или e-mail, который ты к нему добавил, — и свой пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ชื่อโปรไฟล์ — หรืออีเมลที่คุณเพิ่มไว้ — และรหัสผ่านของคุณ"
