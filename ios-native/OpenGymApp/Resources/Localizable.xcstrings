    "Seat height, pin position, a form cue — shown every session.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع المقعد، موضع الدبوس، ملاحظة على الأداء — تُعرض في كل جلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzhöhe, Pin-Position, ein Hinweis zur Ausführung — bei jedem Training sichtbar."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzhöhe, Pin-Position, ein Hinweis zur Ausführung — bei jedem Training sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura del asiento, posición del pin, una indicación técnica — visible en cada sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur du siège, position de la goupille, un rappel technique — visible à chaque séance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीट की ऊँचाई, पिन की जगह, तकनीक का सुझाव — हर कसरत में दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülésmagasság, pin pozíció, egy kivitelezési tipp — minden edzésen megjelenik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza del sedile, posizione del pin, un promemoria tecnico — visibile a ogni sessione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트 높이, 핀 위치, 자세 팁 — 매 운동마다 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysokość siedziska, pozycja bolca, wskazówka techniczna — widoczne w każdej sesji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura do banco, posição do pino, uma indicação técnica — visível em todas as sessões."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura do banco, posição do pino, uma dica de execução — aparece em todos os treinos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота сиденья, положение фиксатора, подсказка по технике — видно на каждой тренировке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสูงเบาะ ตำแหน่งพิน หรือเคล็ดลับท่าทาง — แสดงทุกครั้งที่ฝึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehpa yüksekliği, pim konumu, bir teknik ipucu — her antrenmanda görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висота сидіння, положення фіксатора, підказка з техніки — видно на кожному тренуванні."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "座椅高度、插销位置、动作要点 —— 每次训练都会显示。"
          }
        }
      }
    },
