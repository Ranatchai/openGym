    "That password is too easy to guess — try a longer one, or a few unrelated words.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور هذه سهلة التخمين — جرّب كلمة أطول أو بضع كلمات غير مترابطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort ist zu leicht zu erraten — nimm ein längeres oder ein paar Wörter, die nichts miteinander zu tun haben."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort ist zu leicht zu erraten — nimm ein längeres oder ein paar Wörter, die nichts miteinander zu tun haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña es demasiado fácil de adivinar — prueba con una más larga o con unas cuantas palabras sin relación entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mot de passe est trop facile à deviner — essaie-en un plus long, ou quelques mots sans rapport entre eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पासवर्ड का अनुमान लगाना बहुत आसान है — कोई लंबा पासवर्ड या कुछ आपस में असंबंधित शब्द आज़माएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a jelszót túl könnyű kitalálni — próbálj egy hosszabbat, vagy néhány egymáshoz nem kapcsolódó szót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa password è troppo facile da indovinare — provane una più lunga, o qualche parola senza legame tra loro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추측하기 너무 쉬운 비밀번호입니다 — 더 긴 비밀번호나 서로 관련 없는 단어 몇 개를 사용해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To hasło jest zbyt łatwe do odgadnięcia — spróbuj dłuższego albo kilku niezwiązanych ze sobą słów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa palavra-passe é demasiado fácil de adivinhar — experimenta uma mais longa ou algumas palavras sem relação entre si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa senha é fácil demais de adivinhar — tente uma mais longa ou algumas palavras sem relação entre si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пароль слишком легко угадать — попробуй подлиннее или несколько не связанных между собой слов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านนี้เดาง่ายเกินไป — ลองใช้รหัสที่ยาวขึ้น หรือคำที่ไม่เกี่ยวข้องกันสักสองสามคำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şifreyi tahmin etmek çok kolay — daha uzun bir şifre ya da birbiriyle ilgisiz birkaç kelime dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пароль надто легко вгадати — спробуй довший або кілька не пов’язаних між собою слів."
